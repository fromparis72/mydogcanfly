---
import Base from "../layouts/Base.astro";
import { t } from "@mydogcanfly/knowledge";
interface Item { href: string; label: string; sub?: string; flag?: string }
interface Props { kind: string; title: string; /** Titre SEO « mots clés d'abord » ; à défaut, H1 + suffixe de marque (ancien comportement). */ seoTitle?: string; blurb?: string; metaDesc?: string; items: Item[]; locale?: string; link?: { href: string; label: string };
  /** Emblème d'accueil réduit, haut droite (décision Philippe 10/08/2026) — opt-in explicite,
   * volontairement PAS activé par défaut : ce composant est aussi utilisé par les pages aéroports
   * (`airports/index.astro`, `airports/pet-relief.astro`), hors du périmètre demandé (seulement
   * compagnies/destinations/races/outils, 4 pages précises, pas de sous-pages). */
  showEmblem?: boolean;
  /** Déclare cet index comme jeu de données consultable. Voir le commentaire ci-dessous. */
  dataset?: { name: string; description: string; keywords?: string[] } }
const { kind, title, seoTitle, blurb, metaDesc, items, locale = "en", link, showEmblem = false, dataset } = Astro.props;

/* `Dataset` — DIRE À LA MACHINE CE QUE CETTE PAGE EST (13/09/2026).
 *
 * Un index de compagnies ou de destinations n'est pas une page de contenu : c'est l'entrée d'une
 * collection structurée, tenue à jour selon une cadence annoncée, dont chaque élément porte sa
 * source. `Dataset` est le seul vocabulaire qui dise exactement cela, et c'est ce que lisent les
 * moteurs de réponse quand ils cherchent une référence à citer plutôt qu'un article à résumer.
 *
 * `distribution` n'est PAS déclaré, et ce n'est pas un oubli : `Dataset` admet un export
 * téléchargeable, le site n'en publie aucun. Annoncer un CSV qui n'existe pas serait une promesse
 * vérifiable en un clic — exactement le genre d'écart qui coûte la confiance qu'on vient chercher.
 *
 * `isAccessibleForFree` et `license` disent ce qui est vrai aujourd'hui : la consultation est
 * libre, la réutilisation relève des conditions générales. */
const datasetLd = dataset
  ? {
      "@context": "https://schema.org",
      "@type": "Dataset",
      name: dataset.name,
      description: dataset.description,
      inLanguage: locale,
      isAccessibleForFree: true,
      creator: { "@id": "https://mydogcanfly.com/#org" },
      publisher: { "@id": "https://mydogcanfly.com/#org" },
      isPartOf: { "@id": "https://mydogcanfly.com/#website" },
      license: "https://mydogcanfly.com/terms/",
      ...(dataset.keywords?.length ? { keywords: dataset.keywords } : {}),
      ...(items.length ? { size: `${items.length} entries` } : {}),
    }
  : null;
---
<Base title={seoTitle ?? `${title} — MyDogCanFly`} description={metaDesc ?? blurb ?? title} locale={locale} jsonLd={datasetLd ? [datasetLd] : undefined}>
  <section class={`mdcf-section${showEmblem ? " idx__hero" : ""}`}>
    {showEmblem && (
      /* Même emblème que la page d'accueil (packages/ui/public/brand/emblem.webp), repris ici en
         plus petit (54 % de la taille d'accueil : 60 % puis -10 % relatif, décision Philippe
         10/08/2026) en haut à droite. `alt` porte le titre déjà traduit de la page plutôt qu'un
         texte vide : demandé explicitement pour l'indexation image (Google Images), au prix d'une
         redite mineure avec le <h1> pour les lecteurs d'écran — arbitrage assumé, à la différence
         de l'emblème d'accueil qui reste `alt=""`/`aria-hidden`. */
      <img class="idx__emblem" src="/brand/emblem.webp" alt={title} width="440" height="252" decoding="async" loading="lazy" />
    )}
    <div class="mdcf-container">
      <p class="mdcf-eyebrow">{kind}</p>
      <h1 class="mdcf-h2">{title}</h1>
      {blurb && <p class="idx__blurb">{blurb}</p>}
      {link && <a class="idx__link" href={link.href}>{link.label}</a>}
      <div class="idx__bar">
        <input id="idx-search" class="idx__search" type="search" list="idx-suggest" autocomplete="off" enterkeyhint="go" placeholder={t(locale, "index.filter")} aria-label={t(locale, "index.filter")} />
        <datalist id="idx-suggest">{items.map((i) => <option value={i.label} data-href={i.href}></option>)}</datalist>
        <button id="idx-go" class="idx__go" type="button" aria-label={t(locale, "index.open")} title={t(locale, "index.open")}>→</button>
        <span class="idx__count"><b id="idx-count">{items.length}</b> {t(locale, "index.results")}</span>
      </div>
      <div id="idx-list" class="idx">
        {items.map((i) => (
          <a class="mdcf-card idx__item" href={i.href} data-search={`${i.label} ${i.sub ?? ""}`.toLowerCase()}>
            <b>{i.flag ? <span class="idx__flag" aria-hidden="true">{i.flag}</span> : null}{i.label}</b>
            {i.sub && <span class="idx__sub">{i.sub}</span>}
          </a>
        ))}
      </div>
      <p id="idx-empty" class="idx__empty" hidden>{t(locale, "index.no_results")}</p>
      {/* Contenu propre à un index donné, sous l'annuaire. Ajouté le 13/09/2026 pour le tableau
        * comparatif des races : quand une famille cesse d'indexer ses fiches une à une, ce qu'elles
        * avaient de comparable doit vivre quelque part d'indexable, et cet endroit est l'index. */}
      <slot />
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById("idx-search") as HTMLInputElement | null;
  const goBtn = document.getElementById("idx-go");
  const items = [...document.querySelectorAll<HTMLElement>(".idx__item")];
  const count = document.getElementById("idx-count");
  const empty = document.getElementById("idx-empty");
  const label = (el: HTMLElement) => (el.querySelector("b")?.textContent || "").trim().toLowerCase();
  // Retest 09/08/2026, points 1+2 : accent-fold like every other search on the site (attachCombobox,
  // FlightFinder, DestinationFinder, CrateCalculator, TravelTimeline, PetReliefFinder all use this same
  // pattern) so "francais" matches "français".
  const norm = (s: string) => (s ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();

  const applyFilter = () => {
    const q = norm(input?.value || "");
    let shown = 0;
    for (const el of items) {
      const match = !q || norm(el.getAttribute("data-search") || "").includes(q);
      el.hidden = !match;
      if (match) shown++;
    }
    if (count) count.textContent = String(shown);
    if (empty) empty.hidden = shown > 0;
    return shown;
  };

  // Go straight to the requested page: exact name match first, else the single best visible result.
  const navigate = () => {
    const q = norm(input?.value || "");
    if (!q) return;
    const visible = items.filter((el) => !el.hidden);
    const target = items.find((el) => norm(label(el)) === q) || (visible.length ? visible[0] : null);
    const href = target?.getAttribute("href");
    if (href) window.location.href = href;
  };

  input?.addEventListener("input", applyFilter);
  input?.addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Enter") { e.preventDefault(); applyFilter(); navigate(); }
  });
  goBtn?.addEventListener("click", () => { applyFilter(); navigate(); });
</script>

<style>
  /* Emblème réduit — 54 % des dimensions/tailles de l'emblème d'accueil (clamp(280px,34vw,460px)
     → clamp(151px,18.4vw,248px) ; 60 % puis encore -10 % relatif, décision Philippe 10/08/2026),
     même logique de position/repli que HomeSections.astro : décoratif, z-index sous le contenu,
     masqué sous 720px pour ne jamais chevaucher un titre qui passe sur 2 lignes en mobile.
     idx__hero doit être positionné pour que l'image s'ancre dans la section, pas dans toute la page. */
  .idx__hero { position: relative; }
  .idx__hero > .mdcf-container { position: relative; z-index: 1; }
  .idx__emblem { position: absolute; z-index: 0; top: 8px;
    right: max(12px, calc((100% - var(--mdcf-max)) / 2 + 6px));
    width: clamp(151px, 18.4vw, 248px); height: auto; pointer-events: none; }
  @media (max-width: 960px) { .idx__emblem { opacity: .16; right: -12px; } }
  @media (max-width: 720px) { .idx__emblem { display: none; } }
  .idx__blurb { color: var(--mdcf-muted); margin: 0 0 12px; }
  .idx__link { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 16px; padding: 8px 14px;
    border: 1px solid var(--mdcf-line); border-radius: 999px; text-decoration: none; color: var(--mdcf-ink);
    font-size: 14px; font-weight: 600; transition: border-color .15s, background .15s; }
  .idx__link:hover { border-color: var(--mdcf-accent); background: var(--mdcf-accent-soft); }
  .idx__bar { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; }
  .idx__search { flex: 1 1 auto; max-width: 460px; padding: 11px 14px; border: 1px solid var(--mdcf-line); border-radius: 999px; font: inherit; background: var(--mdcf-surface); }
  .idx__search:focus-visible { border-color: var(--mdcf-accent); outline: none; }
  .idx__go { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 999px; border: none; cursor: pointer;
    background: var(--mdcf-accent); color: #fff; font-size: 18px; font-weight: 800; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center; transition: background .15s; }
  .idx__go:hover { background: var(--mdcf-accent-hover); }
  .idx__count { color: var(--mdcf-muted); font-size: 13px; white-space: nowrap; }
  .idx__count b { color: var(--mdcf-ink); }
  .idx { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .idx__item { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--mdcf-ink); transition: border-color .15s, transform .15s, box-shadow .15s; }
  /* Retest 09/08/2026, point 1 : sans ce override, [hidden] (posé en JS par applyFilter) est battu par la
     règle "display: flex" ci-dessus (spécificité/cascade auteur > agent utilisateur) — les cartes filtrées
     restaient visibles alors que le compteur de résultats était pourtant correct. */
  .idx__item[hidden] { display: none; }
  .idx__item:hover { border-color: var(--mdcf-accent); transform: translateY(-1px); box-shadow: var(--mdcf-shadow); }
  .idx__flag { margin-right: 8px; font-size: 1.05em; line-height: 1; }
  .idx__sub { color: var(--mdcf-muted); font-size: 13px; }
  .idx__empty { color: var(--mdcf-muted); }
  @media (max-width: 720px) { .idx { grid-template-columns: 1fr 1fr; } }
</style>
