---
import { inlineT } from "@mydogcanfly/knowledge";

/* « CITER CETTE PAGE » — un seul bloc, pour les quatre familles sourcées.
 *
 * POURQUOI IL EXISTE. Le site publie près d'un millier d'affirmations sourcées, chacune datée et
 * citée mot pour mot, et rien n'indiquait à quelles conditions on pouvait les reprendre. Résultat
 * mesuré le 13/09/2026 : 41 liens entrants, dont 38 venant d'un domaine appartenant à l'éditeur.
 * Quelqu'un qui veut bien faire ne trouvait pas comment — et citait la source primaire à notre
 * place, ou rien du tout.
 *
 * OÙ IL SE POSE. Le bloc suit le résumé propre à la page — jamais le fil d'Ariane, jamais le H1,
 * jamais la réponse courte. Il apparaît ainsi avant les développements que l'on peut reprendre.
 * Son invitation tient sur la première ligne et ses deux actions sur la suivante : il reste
 * disponible sans concurrencer l'information métier que le visiteur est venu chercher.
 *
 * `<details>` ET NON UN INTERRUPTEUR MAISON. Le repli est natif et fonctionne sans JavaScript.
 * Seul le bouton « Copier » en demande ; sans lui, la citation reste lisible et sélectionnable.
 *
 * LA DATE N'EST JAMAIS INVENTÉE. `date` est la date de vérification que la page AFFICHE déjà,
 * celle-là même qui alimente `lastReviewed` dans le JSON-LD. Une page sans date n'appelle pas ce
 * composant : proposer de citer une fraîcheur qu'on ne peut pas produire est exactement ce que la
 * frontière de confiance interdit partout ailleurs.
 *
 * LE TON. Ce bloc n'est pas un avertissement. Il ouvre par ce qui est permis et ferme par la
 * limite, et cet ordre est délibéré : une phrase qui commence par « ces pages sont protégées »
 * décourage le vétérinaire qui hésitait à citer, et n'arrête pas celui qui aspire — lequel ne lit
 * pas les pieds de page. Ne pas l'inverser.
 */
interface Props {
  locale?: string;
  /** Titre tel qu'il doit apparaître dans la citation. */
  title: string;
  /** Date de vérification, déjà formatée pour la langue de la page. */
  date: string;
}
const { locale = "en", title, date } = Astro.props as Props;
const L = inlineT(locale);
const href = locale === "en" ? "/citing/" : `/${locale}/citing/`;
const prefixe = `MyDogCanFly, "${title}", ${L("verified", "vérifié le", "verificado el")} ${date}, `;
---
<aside class="cite" aria-labelledby="cite-heading">
  <p class="cite__message" id="cite-heading">
    <span class="cite__mark" aria-hidden="true">✓</span>
    <span>
      <strong>{L("Verified information", "Information vérifiée", "Información verificada")}</strong>
      <span class="cite__separator" aria-hidden="true"> · </span>
      <span>{L(
        "Would you like to share this information? Cite MyDogCanFly.",
        "Vous souhaitez partager cette information ? Citez MyDogCanFly.",
        "¿Quieres compartir esta información? Cita MyDogCanFly.",
      )}</span>
    </span>
  </p>
  <div class="cite__actions">
    <button class="cite__copy" type="button" data-cite-copy data-copied={L("Citation copied", "Citation copiée", "Cita copiada")}>
      ⧉ <span>{L("Copy citation", "Copier la citation", "Copiar la cita")}</span>
    </button>
    <details class="cite__details">
      <summary class="cite__sum">{L(
        "View the full citation and terms",
        "Voir la citation complète et les conditions",
        "Ver la cita completa y las condiciones",
      )}</summary>
      <div class="cite__body">
        <blockquote class="cite__q" data-cite-prefix={prefixe}>
          MyDogCanFly, «&nbsp;{title}&nbsp;», {L("verified", "vérifié le", "verificado el")} {date}, <span class="cite__url"></span>
        </blockquote>
        <p class="cite__p">{L(
          "The verified facts on this page are free to reuse, provided you credit MyDogCanFly and state the verification date. Systematic reproduction of the database and republication of the editorial text require permission.",
          "Les faits vérifiés de cette page sont libres de reprise, à condition de citer MyDogCanFly et de mentionner la date de vérification. La reproduction systématique de la base et la republication du texte éditorial restent soumises à autorisation.",
          "Los datos verificados de esta página pueden reutilizarse libremente, siempre que se cite MyDogCanFly y se indique la fecha de verificación. La reproducción sistemática de la base de datos y la republicación del texto editorial requieren autorización.",
        )}</p>
        <a class="cite__link" href={href}>{L(
          "Full terms and other citation formats",
          "Conditions complètes et autres formats de citation",
          "Condiciones completas y otros formatos de cita",
        )} →</a>
      </div>
    </details>
  </div>
</aside>

<script is:inline>
  (function () {
    /* L'URL est écrite au chargement plutôt que rendue dans le HTML : une page peut être atteinte
       par une variante d'adresse, et la citation doit porter CELLE que le lecteur a sous les yeux. */
    var url = location.origin + location.pathname;
    document.querySelectorAll(".cite__url").forEach(function (u) { u.textContent = url; });
    document.querySelectorAll("[data-cite-copy]").forEach(function (b) {
      b.addEventListener("click", function () {
        var q = b.closest(".cite").querySelector(".cite__q");
        var texte = (q.getAttribute("data-cite-prefix") || "") + url;
        var fini = function () {
          var avant = b.innerHTML;
          b.textContent = "✓ " + (b.getAttribute("data-copied") || "");
          setTimeout(function () { b.innerHTML = avant; }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(texte).then(fini, function () {});
        else fini();
      });
    });
  })();
</script>

<style>
  .cite { margin: 16px 0; width: 100%; padding: 10px 13px; box-sizing: border-box; overflow: hidden;
    border: 1px solid #efd8c5; border-left: 3px solid var(--mdcf-accent); border-radius: 10px;
    background: linear-gradient(100deg, var(--mdcf-accent-soft, #fff8f2), var(--mdcf-surface, #fff) 88%); }
  .cite__message { display: flex; align-items: center; gap: 9px; margin: 0; color: var(--mdcf-ink);
    font-size: 14px; line-height: 1.4; }
  .cite__message strong { color: var(--mdcf-accent-ink, #b4530a); font-weight: 800; }
  .cite__mark { flex: 0 0 auto; display: grid; place-items: center; width: 24px; height: 24px;
    color: var(--mdcf-accent-ink, #b4530a); font-size: 15px; font-weight: 800; }
  .cite__separator { color: #d9b99f; }
  .cite__actions { display: flex; align-items: flex-start; gap: 12px; width: 100%; margin-top: 3px; padding-left: 33px;
    box-sizing: border-box; }
  .cite__details { min-width: 0; flex: 1 1 auto; }
  .cite__sum { cursor: pointer; list-style: none; width: fit-content; color: var(--mdcf-accent-ink, #b4530a);
    font-size: 12.5px; font-weight: 700; min-height: 34px; display: flex; align-items: center; gap: 6px; }
  .cite__sum::before { content: "▸"; transition: transform .15s ease; }
  .cite__details[open] .cite__sum::before { transform: rotate(90deg); }
  .cite__sum::-webkit-details-marker { display: none; }
  .cite__sum:focus-visible { outline: 2px solid var(--mdcf-accent); outline-offset: 2px; border-radius: 4px; }
  .cite__body { padding: 7px 0 3px; }
  .cite__p { margin: 0 0 8px; font-size: 12.5px; line-height: 1.55; color: var(--mdcf-muted, #64748b); }
  .cite__q { margin: 0 0 9px; padding: 9px 11px; border-left: 3px solid #f1c28f;
    background: var(--mdcf-surface, #fff); font-size: 12.5px; line-height: 1.55;
    color: var(--mdcf-ink); overflow-wrap: anywhere; }
  .cite__url { color: var(--mdcf-muted, #64748b); }
  .cite__copy { display: inline-flex; align-items: center; flex: 0 0 auto; gap: 7px; min-height: 34px; box-sizing: border-box;
    padding: 0 10px; border-radius: 8px; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer;
    background: transparent; color: var(--mdcf-ink); border: 1px solid #c8d2e1; }
  .cite__copy:hover { background: var(--mdcf-surface, #fff); border-color: #9cabc0; }
  .cite__link { font-size: 12.5px; color: var(--mdcf-accent-ink, #b4530a); text-decoration: none; }
  .cite__link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .cite { padding: 10px 11px 11px 8px; }
    .cite__message { align-items: flex-start; }
    .cite__actions { padding-left: 33px; gap: 10px; flex-wrap: wrap; }
    .cite__copy, .cite__sum { min-height: 44px; }
  }
  @media (max-width: 400px) {
    .cite__separator { display: none; }
    .cite__message strong { display: block; }
    .cite__actions { padding-left: 0; }
  }
  @media print { .cite { display: none; } }
</style>
