            {f.a.map((p) => <p>{p}</p>)}
            {f.bullets && <ul>{f.bullets.map((b) => <li>{b}</li>)}</ul>}
            {f.after && f.after.map((p) => <p>{p}</p>)}
            <p class="faq-cta"><a href={faqHref(f.cta.href)}>{f.cta.text} →</a></p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={faqLd} is:inline />
</section>

<script is:inline>
  (function () {
    var modal = document.getElementById("bailey-modal");
    var frame = document.getElementById("bailey-frame");
    if (!modal || !frame) return;
    var scrollY = 0;
    function open(id) {
      if (!id) return;
      scrollY = window.scrollY;
      // Lazy-load the YouTube player only now, on click.
      frame.innerHTML =
        '<iframe src="https://www.youtube-nocookie.com/embed/' + id +
        '?autoplay=1&rel=0&modestbranding=1" title="MyDogCanFly" frameborder="0" ' +
        'style="position:absolute;inset:0;width:100%;height:100%;border:0" ' +
        'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
        'allowfullscreen></iframe>';
      var fb = document.getElementById("bailey-fallback");
      if (fb) fb.setAttribute("href", "https://www.youtube.com/watch?v=" + id);
      modal.hidden = false;
      document.body.style.overflow = "hidden";
      var c = modal.querySelector(".bailey-modal__close");
      if (c) c.focus();
    }
    function close() {
      modal.hidden = true;
      frame.innerHTML = ""; // unload the player → stops playback, frees resources
      document.body.style.overflow = "";
      window.scrollTo(0, scrollY); // return to the exact same spot
    }
    document.querySelectorAll(".bailey-open").forEach(function (b) {
      b.addEventListener("click", function () { open(b.getAttribute("data-video")); });
    });
    modal.querySelectorAll("[data-close]").forEach(function (el) {
      el.addEventListener("click", close);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !modal.hidden) close();
    });
  })();
</script>

<style>
  /* Bailey launch-film block — premium, minimal, integrated. */
  .bailey { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .bailey__media { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 18px; overflow: hidden; box-shadow: var(--mdcf-shadow); }
  .bailey__media img { display: block; width: 100%; height: auto; border-radius: 18px; transition: transform .5s ease; }
  .bailey__media:hover img { transform: scale(1.02); }
  .bailey__play { position: absolute; inset: 0; margin: auto; width: 68px; height: 68px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.92); color: var(--mdcf-ink); box-shadow: 0 6px 24px rgba(11,21,38,.28); transition: transform .2s ease, background .2s ease; }
  .bailey__play svg { margin-left: 3px; }
  .bailey__media:hover .bailey__play { transform: scale(1.08); background: #fff; }
  .bailey__title { font-size: clamp(28px, 3.4vw, 40px); line-height: 1.08; letter-spacing: -.02em; margin: 6px 0 14px; color: var(--mdcf-ink); }
  .bailey__accent { color: var(--mdcf-accent-ink); }
  .bailey__body { color: var(--mdcf-muted); font-size: 16px; line-height: 1.6; margin: 0 0 22px; max-width: 42ch; }
  .bailey__btnplay { font-size: 12px; }
  @media (max-width: 860px) {
    .bailey { grid-template-columns: 1fr; gap: 22px; }
    .bailey__body { max-width: none; }
  }
  /* Lightbox */
  .bailey-modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .bailey-modal[hidden] { display: none; }
  .bailey-modal__backdrop { position: absolute; inset: 0; background: rgba(6,12,24,.86); backdrop-filter: blur(4px); }
  .bailey-modal__dialog { position: relative; width: min(1040px, 96vw); }
  .bailey-modal__frame { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; box-shadow: var(--mdcf-shadow-lg); background: #000; }
  .bailey-modal__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .bailey-modal__fallback {
    display: block; margin: 12px auto 0; text-align: center;
    font-size: 13px; color: rgba(255,255,255,.72); text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bailey-modal__fallback:hover { color: #fff; }
  .bailey-modal__close { position: absolute; top: -46px; right: 0; width: 38px; height: 38px; border-radius: 50%; border: 0; background: rgba(255,255,255,.14); color: #fff; font-size: 24px; line-height: 1; cursor: pointer; transition: background .2s ease; }
  .bailey-modal__close:hover { background: rgba(255,255,255,.28); }
  @media (max-width: 620px) { .bailey-modal__close { top: -44px; } }

  .hero { position: relative; padding: 64px 0 28px; overflow: hidden; min-height: 360px; }
  @media (max-width: 720px) { .hero { min-height: 0; } }
  .hero__sky { position: absolute; inset: -20% -10% auto -10%; height: 380px; z-index: 0; pointer-events: none;
    background:
      radial-gradient(60% 70% at 78% 8%, var(--mdcf-sky-2) 0%, transparent 60%),
      radial-gradient(50% 60% at 12% 0%, var(--mdcf-sky-1) 0%, transparent 55%); }
  .hero .mdcf-container { position: relative; z-index: 1; }
  .hero__emblem { position: absolute; z-index: 0; right: max(12px, calc((100% - var(--mdcf-max)) / 2 + 6px)); top: 26px;
    width: clamp(280px, 34vw, 460px); height: auto; pointer-events: none; }
  /* Line breaks are now explicit (via <br>), so lines don't re-wrap — size is only limited by the
     emblem on the right. Per-locale sizing: FR text is longer (kept moderate), EN is short (larger). */
  .hero__title { font-size: clamp(24px, 3.1vw, 34px); line-height: 1.14; margin: 0 0 12px; letter-spacing: -.02em; white-space: nowrap; }
  .hero__title--fr { font-size: clamp(31px, 4.5vw, 49px); letter-spacing: -.05em; }   /* FR: EN size, tighter tracking */
  .hero__title--en, .hero__title--es { font-size: clamp(31px, 4.5vw, 49px); }   /* ES aligned on the English hero */
  .hero__q { white-space: nowrap; }
  .hero__accent { color: var(--mdcf-accent-ink); font-size: 0.85em; line-height: 0.95; display: inline-block; vertical-align: top; margin-top: 0.4em; }
  @media (max-width: 520px) { .hero__title, .hero__title--fr, .hero__title--en, .hero__title--es { white-space: normal; font-size: clamp(22px, 6vw, 30px); } }
  .hero__sub { color: var(--mdcf-muted); font-style: normal; font-size: clamp(13px, 1.2vw, 14.5px); line-height: 1.65; margin: 0; max-width: 52ch; opacity: .92; }
  .finder-wrap { padding-top: 8px; scroll-margin-top: 72px; }
  .finder-powered { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--mdcf-muted); }
  /* « Par où commencent nos lecteurs » — quatre colonnes de liens, HTML statique. */
  .starthere { padding-top: 10px; }
  .sh-sub { color: var(--mdcf-muted); max-width: 760px; margin: 0 0 20px; }
  .sh-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .sh-col { border: 1px solid var(--mdcf-line); border-radius: 14px; padding: 16px 18px; background: var(--mdcf-surface); }
