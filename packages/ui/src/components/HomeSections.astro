---
import FlightFinder from "./FlightFinder.astro";
import { t, loadKB, inlineT, inlineF } from "@mydogcanfly/knowledge";
import { localizeHref, hrefFor } from "../lib/routes";
import { menuTop, familyTotal } from "../lib/pagedata";
import Icon from "./Icon.astro";
interface Props { locale?: string }
const { locale = "en" } = Astro.props;
const T = inlineT(locale);
// Trilingual picker: English default, French, Spanish.
const L = inlineT(locale);
const F = inlineF(locale); // phrases à trous : la donnée entre par {0}, {1}…
// Decorative boarding pass shown under the stats band — fictional dog-themed airline.
const bp = {
  airline: "PAWJET AIRWAYS",
  tag: L("Boarding pass", "Carte d'embarquement", "Tarjeta de embarque"),
  fromCode: "CDG", fromCity: "Paris",
  toCode: "JFK", toCity: "New York",
  rows: [
    { k: L("Passenger", "Passager", "Pasajero"), v: "BAILEY", hi: true },
    { k: L("Breed", "Race", "Raza"), v: "Golden Retriever" },
    { k: L("Flight", "Vol", "Vuelo"), v: "PW 2026" },
    { k: "Date", v: L("22 AUG 2026", "22 AOÛT 2026", "22 AGO 2026") },
    { k: L("Gate", "Porte", "Puerta"), v: "B7" },
    { k: L("Class", "Classe", "Clase"), v: L("HOLD", "SOUTE", "BODEGA") },
  ],
};
// Split the hero title after the question mark so the two sentences sit on separate lines.
const hTitle = t(locale, "home.hero.title");
const qi = hTitle.indexOf("?");
const heroA = qi >= 0 ? hTitle.slice(0, qi + 1) : hTitle;
const heroB = qi >= 0 ? hTitle.slice(qi + 1).trim() : "";

// Bailey launch-film block — bridges the "tool" half of the page and the "brand" half.
// YouTube is never loaded until the visitor clicks (see the inline script + lightbox below).
// One launch film per locale (FR / ES / EN).
// Identifiants YouTube, pas du texte : ils ne passent pas par la table de traduction.
// Le film n'existe qu'en trois langues ; toute autre langue reçoit la version anglaise.
const BAILEY_VIDEO: Record<string, string> = { fr: "eldt1BPV_4Q", es: "wOvbxhPQvq4" };
const baileyVideo = BAILEY_VIDEO[locale] ?? "j2vI3Zan1FY";
const bailey = {
  eyebrow: L("Meet Bailey", "Découvrez Bailey", "Conoce a Bailey"),
  text: L(
    "Bailey is the face of MyDogCanFly. Watch the launch film that started the brand.",
    "Bailey est le visage de MyDogCanFly. Découvrez le film de lancement à l'origine de la marque.",
    "Bailey es la cara de MyDogCanFly. Mira el vídeo de lanzamiento que dio origen a la marca.",
  ),
  cta: L("Watch the launch film", "Voir le film de lancement", "Ver el vídeo de lanzamiento"),
  aria: L("Play the MyDogCanFly launch film", "Lire le film de lancement de MyDogCanFly", "Reproducir el vídeo de lanzamiento de MyDogCanFly"),
};

// Stats banner — computed from the real DB, boosted up to +20% then rounded to a clean figure (per product decision).
// Recomputes on every build, so it grows on its own as the database expands.
const kb = loadKB();
const boost = (n: number) => {
  const m = n * 1.2;
  const step = m >= 200 ? 50 : m >= 100 ? 20 : 10;
  return Math.max(step, Math.floor(m / step) * step);
};
const stats = [
  { n: `${boost(kb.airlines.size)}+`, key: "home.stats.airlines" },
  { n: `${boost(kb.countries.size)}+`, key: "home.stats.destinations" },
  { n: `${boost(kb.breeds.size)}+`, key: "home.stats.breeds" },
  { n: `${boost(kb.airports.size)}+`, key: "home.stats.airports" },
  { n: t(locale, "home.stats.thousands"), key: "home.stats.routes" },
];
// Top airlines by the Decision Engine score — the same value shown on each airline page.
const topRated = [...kb.airlines.values()]
  .filter((a) => (a as { rating?: { score: number } }).rating)
  .sort((a, b) => (b as { rating: { score: number } }).rating.score - (a as { rating: { score: number } }).rating.score || a.name.localeCompare(b.name))
  .slice(0, 6)
  .map((a) => ({ name: a.name, score: (a as { rating: { score: number } }).rating.score, href: hrefFor(a.id, locale) }));
// « Par où commencent nos lecteurs » — le seul bloc statique qui envoie l'accueil vers les
// fiches. Mesuré avant intervention : hors navigation, l'accueil ne proposait que 6 fiches
// compagnies et un outil ; tout le reste passait par le Finder (JavaScript) ou par le menu.
// Pour un moteur, la meilleure page du site était donc un cul-de-sac. Les entrées viennent
// de la demande réellement mesurée (popular.generated.json), pas d'un choix éditorial, et
// les aéroports y figurent alors qu'ils n'ont aucun panneau dans le menu.
const startHere = [
  { kind: "country", href: "/countries/", cap: 8, label: L("Destinations", "Destinations", "Destinos"), emoji: "🌍" },
  { kind: "airline", href: "/airlines/", cap: 6, label: L("Airlines", "Compagnies", "Aerolíneas"), emoji: "✈️" },
  { kind: "breed", href: "/breeds/", cap: 6, label: L("Breeds", "Races", "Razas"), emoji: "🐶" },
  { kind: "airport", href: "/airports/", cap: 6, label: L("Airports", "Aéroports", "Aeropuertos"), emoji: "🛂" },
].map((g) => ({ ...g, items: menuTop(kb, g.kind, locale, g.cap), total: familyTotal(kb, g.kind) }))
  .filter((g) => g.items.length > 0);

const trust = [
  { key: "home.trust.p1", icon: "source" },
  { key: "home.trust.p2", icon: "vet" },
  { key: "home.trust.p3", icon: "refresh" },
  { key: "home.trust.p4", icon: "engine" },
  { key: "home.trust.p5", icon: "ai" },
  { key: "home.trust.p6", icon: "review" },
];
// "Before you book" — a journey, not a catalogue. Emoji per the product direction. Only real, working links.
const plan = [
  { key: "home.plan.airlines", href: "/airlines/", emoji: "✈️" },
  { key: "home.plan.country", href: "/countries/", emoji: "🌍" },
  { key: "home.plan.breed", href: "/breeds/", emoji: "🐶" },
  { key: "home.plan.crate", href: "/tools/", emoji: "📦" },
  { key: "home.plan.passport", href: "/countries/", emoji: "📄" },
  { key: "home.plan.summer", href: "/tools/", emoji: "🌡️" },
];

// FAQ just before the footer — classic SEO + GEO (AI answers) + conversion (each answer ends with a relevant link).
// Rendered as an accordion, with FAQPage structured data for search engines and AI overviews. Bilingual.
const faqHref = (h: string) => (h.startsWith("#") ? h : localizeHref(h, locale));
type FaqItem = { q: string; a: string[]; bullets?: string[]; after?: string[]; cta: { text: string; href: string } };
const FAQ_FR: FaqItem[] = [
  { q: "Pourquoi est-il si compliqué de voyager en avion avec son chien ?", a: [
    "Voyager en avion avec un chien est beaucoup plus complexe qu'il n'y paraît. Contrairement aux passagers, les animaux ne sont pas soumis à des règles universelles. Chaque compagnie aérienne applique ses propres conditions de transport : certaines acceptent les chiens en cabine, d'autres uniquement en soute, tandis que quelques-unes refusent totalement certaines races ou certains itinéraires.",
    "À cela s'ajoutent les exigences du pays de destination. Selon ton voyage, tu devras parfois présenter un passeport européen pour animaux, un certificat sanitaire, une vaccination antirabique à jour, un traitement antiparasitaire ou encore respecter une période d'attente avant l'entrée sur le territoire.",
    "La taille et la race de ton chien jouent également un rôle important. Un Chihuahua pourra parfois voyager en cabine, alors qu'un Golden Retriever devra généralement voyager en soute dans une caisse conforme aux normes IATA. Certaines races brachycéphales, comme les Bouledogues français ou les Carlins, font également l'objet de restrictions spécifiques.",
    "Enfin, les conditions climatiques peuvent influencer ton voyage. Plusieurs compagnies limitent ou suspendent le transport des animaux pendant les fortes chaleurs afin de préserver leur sécurité.",
    "MyDogCanFly compare automatiquement tous ces paramètres pour t'aider à choisir la compagnie aérienne la plus adaptée à ton chien et à ta destination.",
  ], cta: { text: "Comparer les compagnies pour ton chien", href: "#flight-finder" } },
  { q: "Quelle compagnie aérienne choisir pour voyager avec son chien ?", a: [
    "Toutes les compagnies aériennes n'appliquent pas les mêmes règles concernant les animaux. Les différences peuvent concerner le poids autorisé en cabine, les dimensions des cages, le transport en soute, les races acceptées, les périodes de restriction liées aux températures ou encore les documents exigés.",
    "Choisir une compagnie uniquement en fonction du prix du billet peut donc conduire à un refus d'embarquement ou à des frais supplémentaires.",
    "MyDogCanFly compare les politiques de transport de dizaines de compagnies aériennes afin de t'aider à identifier celles qui sont les plus adaptées à ton chien, à ton itinéraire et à ton mode de transport (cabine ou soute).",
  ], cta: { text: "Comparer les compagnies aériennes", href: "/airlines/" } },
  { q: "Mon chien peut-il voyager en cabine ?", a: [
    "Le transport d'un chien en cabine dépend principalement de son poids, de la taille de son sac de transport et des règles propres à chaque compagnie aérienne.",
    "La plupart des compagnies imposent une limite comprise entre 8 et 10 kg, sac inclus. Les dimensions du sac doivent également respecter les contraintes de l'avion afin qu'il puisse être placé sous le siège devant toi.",
    "Les grands chiens voyagent généralement en soute, dans une caisse homologuée IATA.",
    "Avant toute réservation, il est indispensable de vérifier les conditions spécifiques de la compagnie aérienne choisie.",
  ], cta: { text: "Vérifier si ton chien peut voyager en cabine", href: "#flight-finder" } },
  { q: "Quand un chien doit-il voyager en soute ?", a: [
    "Lorsqu'il dépasse les limites autorisées en cabine, un chien doit généralement voyager dans la soute pressurisée et climatisée de l'avion.",
    "Cette soute est spécialement aménagée pour le transport des animaux vivants, mais toutes les compagnies n'appliquent pas les mêmes règles concernant les dimensions des caisses, les races autorisées ou les restrictions saisonnières.",
    "Choisir une caisse adaptée et préparer progressivement son chien au voyage constituent deux étapes essentielles.",
  ], cta: { text: "Voir les politiques de transport en soute", href: "#flight-finder" } },
  { q: "Quelle cage choisir pour voyager en avion avec son chien ?", a: [
    "La quasi-totalité des compagnies exige une caisse conforme aux normes IATA pour le transport en soute.",
    "Ton chien doit pouvoir se tenir debout, se retourner et s'allonger naturellement.",
    "Une caisse trop petite peut entraîner un refus d'embarquement, tandis qu'une caisse trop grande peut compliquer son transport.",
    "Le calculateur MyDogCanFly permet d'identifier rapidement la taille de caisse la plus adaptée selon la race et les dimensions de ton chien.",
  ], cta: { text: "Calculer la taille de caisse IATA", href: "/tools/" } },
  { q: "Quelles formalités faut-il respecter ?", a: [
    "Les formalités varient selon le pays de destination. Selon les cas, tu devras notamment disposer :",
  ], bullets: [
    "d'un passeport pour animaux ;",
    "d'une identification par puce électronique ;",
    "d'une vaccination antirabique valide ;",
    "d'un certificat sanitaire officiel ;",
    "voire d'analyses complémentaires ou de traitements antiparasitaires.",
  ], after: [
    "Certaines destinations imposent également une quarantaine.",
    "Les formalités évoluent régulièrement. Il est donc essentiel de consulter des informations mises à jour avant ton départ.",
  ], cta: { text: "Consulter les formalités par destination", href: "/countries/" } },
  { q: "Toutes les races de chiens peuvent-elles voyager ?", a: [
    "Non. Certaines races font l'objet de restrictions particulières.",
    "Les chiens brachycéphales (Bouledogue français, Carlin, Boxer…) sont parfois refusés en soute en raison des risques respiratoires.",
    "D'autres compagnies appliquent également des limitations concernant certaines races de grande taille ou considérées comme puissantes.",
    "Chaque compagnie possède sa propre politique.",
  ], cta: { text: "Voir les restrictions par race", href: "/breeds/" } },
  { q: "Comment MyDogCanFly t'aide-t-il ?", a: [
    "MyDogCanFly ne se contente pas de présenter les règles des compagnies aériennes. Notre moteur compare simultanément :",
  ], bullets: [
    "les politiques des compagnies aériennes ;",
    "les formalités du pays de destination ;",
    "les caractéristiques de la race de ton chien ;",
    "les contraintes liées à la cabine ou à la soute ;",
    "les recommandations de sécurité ;",
    "les conditions de voyage propres à ton itinéraire.",
  ], after: [
    "En quelques secondes, tu obtiens une recommandation personnalisée accompagnée des sources officielles utilisées pour établir la réponse.",
  ], cta: { text: "Lancer une recherche", href: "#flight-finder" } },
];
const FAQ_EN: FaqItem[] = [
  { q: "Why is flying with a dog so complicated?", a: [
    "Flying with a dog is far more complex than it looks. Unlike passengers, pets aren't governed by universal rules. Each airline sets its own carriage conditions: some accept dogs in the cabin, others only in the hold, and a few refuse certain breeds or routes altogether.",
    "On top of that come the destination country's requirements. Depending on your trip, you may need a pet passport, a health certificate, an up-to-date rabies vaccination, an antiparasitic treatment, or to observe a waiting period before entry.",
    "Your dog's size and breed matter too. A Chihuahua can sometimes travel in the cabin, while a Golden Retriever usually has to travel in the hold in an IATA-compliant crate. Some flat-faced (brachycephalic) breeds, such as French Bulldogs or Pugs, also face specific restrictions.",
    "Finally, weather can affect your trip. Several airlines limit or suspend animal transport during hot weather to protect their safety.",
    "MyDogCanFly automatically compares all of these factors to help you choose the airline best suited to your dog and your destination.",
  ], cta: { text: "Compare airlines for your dog", href: "#flight-finder" } },
  { q: "Which airline should I choose to travel with my dog?", a: [
    "Airlines don't all apply the same rules for pets. Differences can involve the weight allowed in the cabin, crate dimensions, hold transport, accepted breeds, temperature-related restriction periods, or the required documents.",
    "Choosing an airline on ticket price alone can therefore lead to a boarding refusal or extra fees.",
    "MyDogCanFly compares the pet policies of dozens of airlines to help you identify those best suited to your dog, your route and your travel mode (cabin or hold).",
  ], cta: { text: "Compare airlines", href: "/airlines/" } },
  { q: "Can my dog travel in the cabin?", a: [
    "Whether a dog can travel in the cabin mainly depends on its weight, the size of its carrier, and each airline's own rules.",
    "Most airlines set a limit of between 8 and 10 kg, carrier included. The carrier's dimensions must also fit the aircraft so it can go under the seat in front of you.",
    "Larger dogs usually travel in the hold, in an IATA-approved crate.",
    "Before booking, it's essential to check the specific conditions of the airline you choose.",
  ], cta: { text: "Check if your dog can fly in the cabin", href: "#flight-finder" } },
  { q: "When does a dog have to travel in the hold?", a: [
    "When it exceeds the limits allowed in the cabin, a dog usually has to travel in the aircraft's pressurised, temperature-controlled hold.",
    "This hold is specially fitted for live-animal transport, but airlines don't all apply the same rules on crate dimensions, permitted breeds or seasonal restrictions.",
    "Choosing a suitable crate and gradually preparing your dog for the trip are two essential steps.",
  ], cta: { text: "See hold transport policies", href: "#flight-finder" } },
  { q: "Which crate should I choose to fly with my dog?", a: [
    "Almost all airlines require an IATA-compliant crate for hold transport.",
    "Your dog must be able to stand, turn around and lie down naturally.",
    "A crate that's too small can lead to a boarding refusal, while one that's too big can make transport harder.",
    "The MyDogCanFly calculator quickly identifies the most suitable crate size based on your dog's breed and measurements.",
  ], cta: { text: "Calculate your IATA crate size", href: "/tools/" } },
  { q: "What paperwork is required?", a: [
    "Requirements vary by destination country. Depending on the case, you may in particular need:",
  ], bullets: [
    "a pet passport;",
    "microchip identification;",
    "a valid rabies vaccination;",
    "an official health certificate;",
    "and possibly additional tests or antiparasitic treatments.",
  ], after: [
    "Some destinations also require quarantine.",
    "Requirements change regularly, so it's essential to check up-to-date information before you leave.",
  ], cta: { text: "Check requirements by destination", href: "/countries/" } },
  { q: "Can every dog breed travel?", a: [
    "No. Some breeds face specific restrictions.",
    "Brachycephalic (flat-faced) dogs (French Bulldog, Pug, Boxer…) are sometimes refused in the hold because of breathing risks.",
    "Other airlines also apply limitations on certain large breeds or breeds considered powerful.",
    "Each airline has its own policy.",
  ], cta: { text: "See restrictions by breed", href: "/breeds/" } },
  { q: "How does MyDogCanFly help?", a: [
    "MyDogCanFly doesn't just list airline rules. Our engine compares, all at once:",
  ], bullets: [
    "airline policies;",
    "the destination country's requirements;",
    "your dog's breed characteristics;",
    "cabin- or hold-related constraints;",
    "safety recommendations;",
    "the travel conditions specific to your route.",
  ], after: [
    "In seconds, you get a personalised recommendation along with the official sources used to produce it.",
  ], cta: { text: "Run a search", href: "#flight-finder" } },
];
