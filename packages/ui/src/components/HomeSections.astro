    "as exigências do país de destino;",
    "as características da raça do seu cachorro;",
    "as limitações de cabine ou de porão;",
    "as recomendações de segurança;",
    "as condições de viagem próprias da sua rota.",
  ], after: [
    "Em segundos, você recebe uma recomendação personalizada acompanhada das fontes oficiais usadas para elaborá-la.",
  ], cta: { text: "Fazer uma busca", href: "#flight-finder" } },
];

/* La langue est une clé, plus une branche : la FAQ portugaise existait déjà en données
   que le ternaire à deux branches n'allait pas chercher. */
const FAQS: Record<string, FaqItem[]> = { fr: FAQ_FR, es: FAQ_ES, pt: FAQ_PT, en: FAQ_EN };
const faq: FaqItem[] = FAQS[locale] ?? FAQ_EN;
const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: [...f.a, ...(f.bullets ?? []), ...(f.after ?? [])].join(" ") } })),
});
