---
import Base from "../layouts/Base.astro";
import FinderCTA from "./FinderCTA.astro";
import Icon from "./Icon.astro";
import { t } from "@mydogcanfly/knowledge";
import type { Rule } from "@mydogcanfly/knowledge";
import type { PremiumView, GuideView, PetReliefView, AirportInfoView, BreedTravelView, EntryFactorsView } from "../lib/pagedata";

interface Related { href: string; label: string; kind: string; flag?: string }
interface Fact { label: string; value: string }
interface Props {
  kind: string;
  title: string;
  subtitle?: string;
  facts?: Fact[];
  rules?: Rule[];
  related?: Related[];
  relatedTitle?: string;
  schema: Record<string, unknown>;
  finderContext?: string;
  locale?: string;
  premium?: PremiumView;
  guide?: GuideView;
  petRelief?: PetReliefView;
  airportInfo?: AirportInfoView;
  headFlag?: string;
  monogram?: boolean;
  contact?: { phones: { region: string; number: string }[]; src: { host: string; url: string; date: string; confidence: number } };
  breedTravel?: BreedTravelView;
  entryFactors?: EntryFactorsView;
}
const { kind, title, subtitle, facts = [], rules = [], related = [], relatedTitle, schema, finderContext, locale = "en", premium, guide, petRelief, airportInfo, headFlag, monogram, contact, breedTravel, entryFactors } = Astro.props;
const ai = airportInfo;
const bt = breedTravel;
const critColor: Record<string, string> = { critical: "#dc2626", high: "#d97706", medium: "#2563eb", low: "#64748b" };
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ""); } catch { return u; } };
const stars = (n: number) => "★".repeat(n) + "☆".repeat(Math.max(0, 5 - n));
const p = premium;
const initials = title.split(/\s+/).map((w) => w[0] ?? "").slice(0, 2).join("").toUpperCase();
---
<Base title={`${title} — MyDogCanFly`} description={`${kind}: ${title}.`} locale={locale}>
  <section class="mdcf-section">
    <div class="mdcf-container">
      <div class="ep__head">
        {headFlag
          ? <div class="ep__flag" aria-hidden="true">{headFlag}</div>
          : p?.logo && !p.logo.placeholder && p.logo.src
            ? <img class="ep__logoimg" src={p.logo.src} alt={p.logo.alt ?? title} loading="lazy" />
            : (p?.logo || monogram)
              ? <div class="ep__logo" title={p?.logo?.alt} aria-hidden="true">{initials}</div>
              : null}
        <div>
          <p class="mdcf-eyebrow">{kind}</p>
          <h1 class="ep__title">{title}</h1>
          {subtitle && <p class="ep__sub">{subtitle}</p>}
        </div>
      </div>
      {facts.length > 0 && (
        <div class="ep__facts">
          {facts.map((f) => <div class="ep__fact"><span>{f.label}</span><b>{f.value}</b></div>)}
        </div>
      )}
    </div>
  </section>

  <FinderCTA context={finderContext} locale={locale} />

  {entryFactors && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <article class="mdcf-card ep__factors">
          <h2 class="ep__factorstitle">{entryFactors.title}</h2>
          <p class="ep__factorsintro">{entryFactors.intro}</p>
          <ol class="ep__factorslist">
            {entryFactors.factors.map((f, i) => (
              <li class="ep__factor">
                <span class="ep__factornum" aria-hidden="true">{i + 1}</span>
                <div>
                  <div class="ep__factorhead">
                    <b>{f.label}</b>
                    <span class="ep__factorstars" aria-hidden="true">{"★".repeat(f.stars)}{"☆".repeat(Math.max(0, 5 - f.stars))}</span>
                  </div>
                  <p class="ep__factortext">{f.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="ep__factorsnote">{entryFactors.note}</p>
        </article>
      </div>
    </section>
  )}

  {bt && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <article class="mdcf-card bt__score">
          <div class="bt__scorehead">
            <div class="bt__stars" aria-hidden="true">{stars(Math.round(bt.stars))}</div>
            <div class="bt__num"><b>{bt.stars.toFixed(1)}</b><span>/5 · {bt.score}/100</span></div>
            <span class={`bt__diff bt__diff--${bt.difficulty.emoji === "🟢" ? "ok" : bt.difficulty.emoji === "🔴" ? "no" : "mid"}`}>{bt.difficulty.emoji} {bt.difficulty.label}</span>
          </div>
          <p class="bt__verdict">{bt.verdict}</p>
          <p class="bt__diffexpl">{bt.difficulty.explanation}</p>
          {bt.src && <p class="ep__src">{t(locale, "section.sources")}: <a href={bt.src.url} rel="nofollow noopener" target="_blank">{bt.src.host}</a><span> · {bt.src.date}</span></p>}
        </article>
      </div>
    </section>
  )}

  {bt && bt.ratings.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "breed.profile")}</h2>
        <div class="bt__ratings">
          {bt.ratings.map((r) => (
            <div class="bt__rating">
              <span class="bt__rlabel">{r.label}</span>
              <span class="bt__bar" aria-hidden="true"><span class="bt__fill" style={`width:${r.value * 20}%`}></span></span>
              <span class="bt__rval">{r.value}/5</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {bt && (bt.strengths.length > 0 || bt.limitations.length > 0) && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "breed.why")}</h2>
        <div class="bt__why">
          {bt.strengths.length > 0 && (
            <div class="bt__col">
              <h3 class="bt__coltitle">{t(locale, "breed.strengths")}</h3>
              <ul class="bt__list bt__list--plus">{bt.strengths.map((s) => <li>{s}</li>)}</ul>
            </div>
          )}
          {bt.limitations.length > 0 && (
            <div class="bt__col">
              <h3 class="bt__coltitle">{t(locale, "breed.limitations")}</h3>
              <ul class="bt__list bt__list--minus">{bt.limitations.map((s) => <li>{s}</li>)}</ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {bt && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "breed.cabin")}</h2>
        <p class="bt__para">{bt.cabin}</p>
        <h2 class="mdcf-h2" style="margin-top:24px">{t(locale, "breed.hold")}</h2>
        <p class="bt__para">{bt.hold}</p>
        <h2 class="mdcf-h2" style="margin-top:24px">{t(locale, "breed.climate")}</h2>
        <p class="bt__para">{bt.climate}</p>
      </div>
    </section>
  )}

  {bt && bt.tips.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "breed.tips")}</h2>
        <ul class="ep__tips">{bt.tips.map((tp) => <li>{tp}</li>)}</ul>
      </div>
    </section>
  )}

  {bt && bt.faq.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.faq")}</h2>
        {bt.faq.map((f) => (
          <details class="ep__faq"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </section>
  )}

  {bt && bt.similar.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container">
        <h2 class="mdcf-h2">{t(locale, "breed.similar")}</h2>
        <div class="ep__related">
          {bt.similar.map((s) => <a class="mdcf-card ep__rel" href={s.href}><b>{s.label}</b></a>)}
        </div>
      </div>
    </section>
  )}

  {petRelief && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.pet_relief")}</h2>
        <article class={`mdcf-card ep__relief ep__relief--${petRelief.available}`}>
          <div class="ep__reliefhead">
            <span class="ep__pawic" aria-hidden="true">🐾</span>
            <b>{petRelief.available === "yes" ? t(locale, "petrelief.yes") : t(locale, "petrelief.no")}</b>
            {petRelief.available === "yes" && petRelief.postSecurity && (
              <span class="ep__pill ep__pill--air">{t(locale, "petrelief.airside")}</span>
            )}
          </div>
          {petRelief.locations.length > 0 && (
            <ul class="ep__relieflist">
              {petRelief.locations.map((l) => <li>{l}</li>)}
            </ul>
          )}
          {petRelief.note && <p class="ep__reliefnote">{petRelief.note}</p>}
          {petRelief.src && (
            <p class="ep__src">
              {t(locale, "section.sources")}: <a href={petRelief.src.url} rel="nofollow noopener" target="_blank">{petRelief.src.host}</a>
              <span> · {petRelief.src.date}</span><span> · {stars(petRelief.src.confidence)}</span>
            </p>
          )}
        </article>
      </div>
    </section>
  )}

  {ai && (ai.address || ai.website || ai.access) && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.airport_access")}</h2>
        <article class="mdcf-card ep__info">
          <div class="ep__infohead"><span class="ep__infoic" aria-hidden="true">📍</span></div>
          {ai.access && <p class="ep__infotext">{ai.access}</p>}
          <dl class="ep__kv">
            {ai.address && <div><dt>{t(locale, "airport.address")}</dt><dd>{ai.address}</dd></div>}
            {ai.website && <div><dt>{t(locale, "airport.website")}</dt><dd><a href={ai.website} rel="nofollow noopener" target="_blank">{host(ai.website)}</a></dd></div>}
          </dl>
        </article>
      </div>
    </section>
  )}

  {ai?.borderPost && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.border_post")}</h2>
        <article class="mdcf-card ep__info ep__info--alert">
          <div class="ep__infohead"><span class="ep__infoic" aria-hidden="true">🩺</span></div>
          <p class="ep__infotext">{ai.borderPost.note}</p>
          <dl class="ep__kv">
            {ai.borderPost.appliesWhen && <div><dt>{t(locale, "airport.applies_to")}</dt><dd>{ai.borderPost.appliesWhen}</dd></div>}
            {ai.borderPost.phone && <div><dt>{t(locale, "airport.phone")}</dt><dd>{ai.borderPost.phone}</dd></div>}
            {ai.borderPost.address && <div><dt>{t(locale, "airport.address")}</dt><dd>{ai.borderPost.address}</dd></div>}
            {ai.borderPost.hours && <div><dt>{t(locale, "airport.hours")}</dt><dd>{ai.borderPost.hours}</dd></div>}
          </dl>
          <p class="ep__src">
            {t(locale, "section.sources")}: <a href={ai.borderPost.src.url} rel="nofollow noopener" target="_blank">{ai.borderPost.src.host}</a>
            <span> · {ai.borderPost.src.date}</span><span> · {stars(ai.borderPost.src.confidence)}</span>
          </p>
        </article>
      </div>
    </section>
  )}

  {ai?.terminalRules && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.terminal_rules")}</h2>
        <article class="mdcf-card ep__info">
          <div class="ep__infohead"><span class="ep__infoic" aria-hidden="true">🐾</span></div>
          <ul class="ep__infolist">{ai.terminalRules.items.map((x) => <li>{x}</li>)}</ul>
          <p class="ep__src">
            {t(locale, "section.sources")}: <a href={ai.terminalRules.src.url} rel="nofollow noopener" target="_blank">{ai.terminalRules.src.host}</a>
            <span> · {ai.terminalRules.src.date}</span><span> · {stars(ai.terminalRules.src.confidence)}</span>
          </p>
        </article>
      </div>
    </section>
  )}

  {ai?.assistance && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.assistance_dogs")}</h2>
        <article class="mdcf-card ep__info">
          <div class="ep__infohead"><span class="ep__infoic" aria-hidden="true">🦮</span></div>
          <p class="ep__infotext">{ai.assistance.note}</p>
          {ai.assistance.src && (
            <p class="ep__src">
              {t(locale, "section.sources")}: <a href={ai.assistance.src.url} rel="nofollow noopener" target="_blank">{ai.assistance.src.host}</a>
              <span> · {ai.assistance.src.date}</span><span> · {stars(ai.assistance.src.confidence)}</span>
            </p>
          )}
        </article>
      </div>
    </section>
  )}

  {ai?.contacts && ai.contacts.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.contacts")}</h2>
        <article class="mdcf-card ep__info">
          <div class="ep__infohead"><span class="ep__infoic" aria-hidden="true">☎️</span></div>
          <dl class="ep__kv">
            {ai.contacts.map((c) => <div><dt>{c.label}</dt><dd>{c.value}</dd></div>)}
          </dl>
          {ai.contacts.find((c) => c.src) && (
            <p class="ep__src">
              {t(locale, "section.sources")}: <a href={ai.contacts.find((c) => c.src)!.src!.url} rel="nofollow noopener" target="_blank">{ai.contacts.find((c) => c.src)!.src!.host}</a>
              <span> · {ai.contacts.find((c) => c.src)!.src!.date}</span>
            </p>
          )}
        </article>
      </div>
    </section>
  )}

  {guide && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <article class="ep__guide" set:html={guide.html} />
        {guide.sources.length > 0 && (
          <div class="ep__guidesrc">
            <h3>{t(locale, "section.sources")}</h3>
            <ol>
              {guide.sources.map((s) => (
                <li id={`g-src-${s.id}`}>
                  <a href={s.url} rel="nofollow noopener" target="_blank">{s.publisher ?? host(s.url)}</a>
                  {s.accessed && <span> · {s.accessed}</span>}
                </li>
              ))}
            </ol>
            {guide.policySource && (
              <p class="ep__src">{t(locale, "section.pet_policy")}: <a href={guide.policySource} rel="nofollow noopener" target="_blank">{host(guide.policySource)}</a></p>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  {p?.summary && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.about")}</h2>
        <p class="ep__lede">{p.summary}</p>
      </div>
    </section>
  )}

  {p && p.policy.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container">
        <h2 class="mdcf-h2">{t(locale, "section.pet_policy")}</h2>
        <div class="ep__pol">
          {p.policy.map((pl) => (
            <article class="mdcf-card ep__polcard">
              <div class="ep__polhead">
                <span class="ep__polic"><Icon name={pl.key} size={18} /></span>
                <b>{pl.label}</b>
                <span class={`ep__pill ${pl.allowed ? "ep__pill--ok" : "ep__pill--no"}`}>
                  {pl.allowed ? t(locale, "premium.allowed") : t(locale, "premium.not_allowed")}
                </span>
              </div>
              <dl class="ep__specs">
                {pl.maxWeight && <div><dt>{t(locale, "premium.max_weight")}</dt><dd>{pl.maxWeight}</dd></div>}
                {pl.dims && <div><dt>{t(locale, "premium.carrier")}</dt><dd>{pl.dims}</dd></div>}
                {/* Le montant de premium.policy[canal].fee n'est plus rendu : chaîne libre, sans
                    devise séparée ni route, impossible à rapporter à un trajet. Voir
                    DOSSIER-TARIFS-PRELANCEMENT.md. */}
                <div><dt>{t(locale, "premium.fee")}</dt><dd>{t(locale, pl.key === "cargo" ? "tarif.devis_cargo" : "tarif.a_confirmer")}</dd></div>
              </dl>
              {pl.conditions && <p class="ep__polcond">{pl.conditions}</p>}
              <p class="ep__src">
                {t(locale, "section.sources")}: <a href={pl.src.url} rel="nofollow noopener" target="_blank">{pl.src.host}</a>
                <span> · {pl.src.date}</span><span> · {stars(pl.src.confidence)}</span>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {p?.booking && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.booking")}</h2>
        <p>{p.booking.text}</p>
        <p class="ep__src">
          {t(locale, "section.sources")}: <a href={p.booking.src.url} rel="nofollow noopener" target="_blank">{p.booking.src.host}</a>
          <span> · {p.booking.src.date}</span><span> · {stars(p.booking.src.confidence)}</span>
        </p>
      </div>
    </section>
  )}

  {p && p.history.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.history")}</h2>
        <ul class="ep__timeline">
          {p.history.map((h) => (
            <li>
              <span class="ep__year">{h.year}</span>
              <span class="ep__event">{h.event} <a class="ep__cite" href={h.src.url} rel="nofollow noopener" target="_blank">{h.src.host}</a></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {p && p.faq.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.faq")}</h2>
        {p.faq.map((f) => (
          <details class="ep__faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
            <p class="ep__src">
              {t(locale, "section.sources")}: <a href={f.src.url} rel="nofollow noopener" target="_blank">{f.src.host}</a>
              <span> · {f.src.date}</span><span> · {stars(f.src.confidence)}</span>
            </p>
          </details>
        ))}
      </div>
    </section>
  )}

  {p && p.tips.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.tips")}</h2>
        <ul class="ep__tips">
          {p.tips.map((tp) => (
            <li>{tp.text} <a class="ep__cite" href={tp.src.url} rel="nofollow noopener" target="_blank">{tp.src.host}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {rules.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container">
        <h2 class="mdcf-h2">{t(locale, "section.rules")}</h2>
        <div class="ep__rules">
          {rules.map((r) => (
            <article class="mdcf-card">
              <div class="ep__rulehead">
                <span class="ep__badge" style={`--c:${critColor[r.criticality] ?? "#64748b"}`}>{t(locale, `crit.${r.criticality}`, r.criticality)}</span>
                <span class="ep__cat">{t(locale, `cat.${r.category}`, r.category.replace(/_/g, " "))}</span>
              </div>
              <p class="ep__rationale">{r.rationale}</p>
              <p class="ep__src">
                {t(locale, "section.sources")}: <a href={r.source.url} rel="nofollow noopener" target="_blank">{host(r.source.url)}</a>
                <span> · {r.source.verified_date}</span>
                <span> · {stars(r.source.confidence)}</span>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {contact && contact.phones.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container ep__narrow">
        <h2 class="mdcf-h2">{t(locale, "section.contact_airline")}</h2>
        <article class="mdcf-card ep__info">
          <div class="ep__infohead"><span class="ep__infoic" aria-hidden="true">☎️</span></div>
          <dl class="ep__kv">
            {contact.phones.map((ph) => <div><dt>{ph.region}</dt><dd><a href={`tel:${ph.number.replace(/[^+0-9]/g, "")}`}>{ph.number}</a></dd></div>)}
          </dl>
          <p class="ep__src">
            {t(locale, "section.sources")}: <a href={contact.src.url} rel="nofollow noopener" target="_blank">{contact.src.host}</a>
            <span> · {contact.src.date}</span><span> · {stars(contact.src.confidence)}</span>
          </p>
        </article>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="mdcf-section">
      <div class="mdcf-container">
        <h2 class="mdcf-h2">{relatedTitle ?? t(locale, "section.related")}</h2>
        <div class="ep__related">
          {related.map((rl) => (
            <a class="mdcf-card ep__rel" href={rl.href}>
              {rl.flag && <span class="ep__relflag" aria-hidden="true">{rl.flag}</span>}
              <b>{rl.label}</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Base>

<style>
  .ep__head { display: flex; align-items: center; gap: 16px; }
  .ep__logo { flex: 0 0 auto; width: 56px; height: 56px; border-radius: 14px; border: 1px solid #bae6fd;
    display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px;
    color: #0369a1; background: #e0f2fe; letter-spacing: .02em; }
  .ep__title { font-size: clamp(24px, 3.4vw, 36px); margin: 0 0 6px; letter-spacing: -.01em; }
  .ep__sub { color: var(--mdcf-muted); margin: 0 0 16px; }
  .ep__facts { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 8px; }
  .ep__fact { display: flex; flex-direction: column; }
  .ep__fact span { font-size: 12px; color: var(--mdcf-muted); text-transform: uppercase; letter-spacing: .05em; }
  .ep__fact b { font-size: 18px; }
  .ep__rules { display: grid; gap: 12px; }
  .ep__rulehead { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
