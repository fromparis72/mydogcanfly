   * conteneur en `flex-wrap`, sans toucher au reste de l'en-tête. Discrète mais lisible —
   * une mention légale illisible ne détrompe personne. */
  .afp .hero-nonaff { flex: 1 1 100%; margin: 4px 0 0; padding-top: 10px;
    border-top: 1px solid var(--mdcf-border, #e6eaf0);
    color: var(--mdcf-muted, #5b6b7f); font-size: 12.5px; line-height: 1.45; }
  .afp .hv-row { display: flex; gap: 9px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }
  .afp .hv-score { display: inline-flex; align-items: baseline; gap: 1px; padding: 5px 11px; border-radius: 12px; font-weight: 800; line-height: 1;
    background: var(--mdcf-subtle, #f5f7fa); color: var(--mdcf-ink, #1a2433); border: 1.5px solid var(--mdcf-line, #e6ebf1); }
  .afp .hv-score b { font-size: 18px; } .afp .hv-score small { font-size: 11px; font-weight: 700; opacity: .6; }
  .afp .hv-score--ok { background: #dcfce7; color: #166534; border-color: #a7e3bf; }
  .afp .hv-score--warn { background: #fff3e2; color: #9a5a12; border-color: #f0d5aa; }
  .afp .hv-score--no { background: #fee2e2; color: #b3261e; border-color: #f2b8b2; }
  .afp .hv-pts { margin-top: 6px; font-size: 11.5px; font-weight: 600; color: var(--mdcf-muted, #5b6b7f); }
