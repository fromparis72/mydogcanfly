  .afp .ladder > div { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 0 6px; }
  .afp .ladder small { font-weight: 500; opacity: .9; }
  .afp .cratecta { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; padding: 9px 15px; border: 1px solid rgba(242,112,15,.4); border-radius: 999px; background: var(--mdcf-accent-soft, #fdf1e7); color: var(--mdcf-accent-ink, #b4530a); font-weight: 700; font-size: 13.5px; text-decoration: none; }
  .afp .cratecta:hover { border-color: var(--mdcf-accent-ink, #b4530a); }
  .afp .g { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .afp .mini { background: var(--mdcf-subtle, #f5f7fa); border-radius: 12px; padding: 14px 15px; }
  .afp .mini .t { display: flex; align-items: center; gap: 8px; font-weight: 700; }
  .afp .mini .t .ml { margin-left: auto; }
  .afp .mini .t .aci { color: #166534; font-weight: 800; }
  .afp .k { color: var(--mdcf-muted, #5b6b7f); font-size: 13.5px; margin-top: 6px; }
  /* Les cotes, les poids et la nature du sac, dans une phrase par ailleurs en gris. Le contraste
     vient de la COULEUR autant que de la graisse : sur du texte secondaire, un gras seul se
     remarque à peine. */
  .afp .k b { color: var(--mdcf-ink, #011d48); font-weight: 700; }
  .afp .amt { margin-top: 9px; font-weight: 800; }
  /* La cause de l'incertitude, et la preuve du canal : lisibles sans être criardes — elles
     accompagnent la décision, elles ne la remplacent pas. */
  .afp .why { margin-top: 8px; font-size: 12.5px; line-height: 1.45; color: #9a5a12; }
