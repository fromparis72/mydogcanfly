    background: var(--mdcf-subtle, #f5f7fa); color: var(--mdcf-ink, #1a2433); border: 1.5px solid var(--mdcf-line, #e6ebf1); }
  .afp .hv-score b { font-size: 18px; } .afp .hv-score small { font-size: 11px; font-weight: 700; opacity: .6; }
