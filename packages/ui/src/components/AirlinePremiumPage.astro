---
/* Generic graphical airline page — renders from src/data/airlines.ts (interim, before .yml ingest).
   Bilingual EN/FR. Wrapped in the site Base layout. */
import Base from "../layouts/Base.astro";
import OnwardNav from "./OnwardNav.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { airlineData } from "../data/airlines";
import PageActions from "./PageActions.astro";
import logos from "../data/airline-logos.generated.json";
import { loadKB, t as tt, inlineT, inlineF, localizer, dateFormatter } from "@mydogcanfly/knowledge";
import FaqBlock from "./FaqBlock.astro";
import { airlineFaq, faqJsonLd } from "../lib/faq";
import { airlineReach, brachyBreeds, brachyRestriction } from "../lib/cluster";
import { politiqueDuCanal, cleLibelleStatut, classeStatut, causeDeConfirmation, preuveAuditee, sourceAffichable, verdictDeFiche } from "../lib/decisionCanal";
interface Props { id: string; locale?: string }
const { id, locale = "en" } = Astro.props;
const fr = locale === "fr";
const d = airlineData[id];
const logo = (logos as Record<string, { src: string; dark?: boolean }>)[id];
const kb = loadKB();
const kbAirline = [...kb.airlines.values()].find((a) => a.id === id) as { rating?: { score: number; points: number }; country_id?: string } | undefined;
const rating = kbAirline?.rating;
// Home country of the carrier — the default "next step" suggestion on direct arrivals (most people
// flying an airline registered in a country often travel to that country); overridden by ?to=<iso> when coming from the finder.
const homeCountry = kbAirline?.country_id ? kb.countries.get(kbAirline.country_id) : undefined;
const homeIso = homeCountry ? homeCountry.iso2.toLowerCase() : undefined;
const homeName = homeCountry ? ((homeCountry.name as unknown as Record<string, string>)[locale] ?? (homeCountry.name as unknown as { en: string }).en) : undefined;
const scoreCls = rating ? (rating.score >= 4 ? "ok" : rating.score >= 3 ? "warn" : "no") : "";
const t = localizer(locale);
const T = inlineT(locale);
const fmtDate = dateFormatter(locale); // date visible à la langue de la page ; le JSON-LD garde l'ISO
const F = inlineF(locale); // phrases à trous : la donnée entre par {0}, {1}…
/* L'hôte d'une URL, pour un lien lisible. Une URL officielle brute de 140 caractères ne se lit
   pas ; le lien complet reste dans `href`, où le harnais le compare à l'octet près. */
const hote = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ""); } catch { return u; } };

/* LES CHIFFRES QUI DÉCIDENT, EN GRAS DANS LA PHRASE.
 *
 * « Chien ou chat < 8 kg, sac souple ventilé sous le siège (46 × 28 × 24 cm) » contient tout ce
 * qu'un voyageur veut savoir, mais noyé : il faut lire la phrase entière pour trouver la cote du
 * sac, qui est justement ce qu'il vient chercher avant d'en acheter un. Les trois valeurs passent
 * donc en gras et en couleur pleine, la phrase reste intacte autour.
 *
 * LE TRAITEMENT VAUT POUR LES TROIS CANAUX, pas seulement la cabine. C'était la remarque de
 * Philippe : les dimensions de la caisse en soute et les limites en fret méritent la même
 * lisibilité, et privilégier la cabine reviendrait à décider à sa place de ce qui compte.
 *
 * ON N'EMPHASE QUE CE QUI EST NON AMBIGU dans les quatre langues : les dimensions, les poids, et
 * la nature du sac — souple ou rigide, qui fait refuser au comptoir un sac pourtant au bon
 * gabarit. Le reste de la phrase n'est pas touché : une règle qui grossit s'attrape des mots
 * qu'elle ne devrait pas, et un gras partout ne met plus rien en valeur.
 *
 * ÉCHAPPEMENT D'ABORD, BALISES ENSUITE. Le texte vient des fiches, donc de nous — mais l'injecter
 * en HTML sans le neutraliser installerait une faille pour la première fiche qui contiendra un
 * chevron. On échappe, puis on ajoute les `<b>` sur le texte déjà sûr. */
const ECHAPPE: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" };
const SOUPLE = /\b(sacs? souples?|soft (?:sided )?(?:carrier|bag|kennel)|bolsos? blandos?|transport[íi]n(?:es)? blandos?|bolsas? male[áa]vel(?:eis)?|caixas? male[áa]vel(?:eis)?|sacs? rigides?|hard(?:-| )sided|r[íi]gidos?|r[íi]gidas?)\b/gi;
/* Trois nombres séparés par × : une cote de sac. L'unité est facultative — certaines fiches
 * l'écrivent une seule fois en fin de parenthèse. */
const COTES = /\d{1,3}(?:[.,]\d)?\s*[×x]\s*\d{1,3}(?:[.,]\d)?\s*[×x]\s*\d{1,3}(?:[.,]\d)?(?:\s*(?:cm|in\b|"))?/g;
/* Un poids, comparateur compris : « < 8 kg » se lit d'un bloc, et le couper laisserait un
 * « chat < » orphelin devant un gras.
 *
 * Le comparateur est cherché sous sa forme ÉCHAPPÉE — `&lt;`, `&gt;` — parce que l'échappement
 * a déjà eu lieu quand cette règle s'applique. Une première version cherchait `<` et ne trouvait
 * plus rien : elle produisait « chat &lt;<b> 8 kg</b> », comparateur exclu et espace prise dans
 * le gras. Les deux branches sont séparées pour que la variante sans comparateur ne capture pas
 * l'espace qui la précède. */
const POIDS = /(?:&lt;|&gt;|[≤≥])\s*\d{1,3}(?:[.,]\d)?\s*(?:kg|lbs?|lb)\b|\d{1,3}(?:[.,]\d)?\s*(?:kg|lbs?|lb)\b/g;

function chiffresEnGras(texte: string): string {
  const sur = String(texte ?? "").replace(/[&<>"]/g, (c) => ECHAPPE[c]);
  /* Les cotes AVANT les poids : « 46 × 28 × 24 cm » ne doit pas être entamé par une règle qui
   * chercherait un nombre isolé. */
  return sur
    .replace(COTES, (m) => `<b>${m}</b>`)
    .replace(POIDS, (m) => (m.includes("<b>") ? m : `<b>${m}</b>`))
    .replace(SOUPLE, (m) => `<b>${m}</b>`);
}
// Préfixe de langue : dérivé du code de langue, jamais énuméré — une liste en dur ici
// renvoyait les pages portugaises vers les URL anglaises.
const base = locale === "en" ? "" : `/${locale}`;
const reachAll = airlineReach(kb, id, locale, 16, 8);
/* Le bloc « Où <compagnie> vole avec les chiens » lit le réseau commercial, qui ne sait rien de
 * la politique animaux. Sur Volotea, il affichait Malte et le Royaume-Uni — deux pays où la
 * compagnie écrit noir sur blanc qu'elle ne transporte aucun animal. On retire donc les pays
 * que la fiche déclare fermés, et on les redit juste en dessous plutôt que de les laisser dans
 * une liste dont le titre promet le contraire. Sans la clé, rien ne change. */
const noPet = new Set((d.noPetCountries ?? []).map((c) => c.toUpperCase()));
const reach = noPet.size
  ? { ...reachAll, countries: reachAll.countries.filter((c) => !noPet.has(c.iso2.toUpperCase())) }
  : reachAll;
const noPetNames = noPet.size
  ? reachAll.countries.filter((c) => noPet.has(c.iso2.toUpperCase())).map((c) => c.name)
  : [];
// Restriction brachycéphale : la seule restriction de race que les données portent de façon
// structurée. La liste est donnée en entier, jamais tronquée — sur une restriction, une liste
// partielle laisse croire à celui qui n'y voit pas sa race qu'il n'est pas concerné.
const kbAir = kb.airlines.get(id);
const brachy = kbAir ? brachyRestriction(kbAir) : null;
const brachyList = brachy ? brachyBreeds(kb, locale) : [];
const chanName = (c: string) => c === "cabin" ? T("cabin", "cabine", "cabina") : c === "hold" ? T("the hold", "soute", "bodega") : T("cargo", "cargo", "carga");
const chanList = (brachy?.channels ?? []).map(chanName).join(" / ");
// Titre SEO ≠ H1. Search Console montre que la requête tapée est « <compagnie> pet policy » :
// on met donc « pet » (générique, très recherché) ET « dog » (spécialité du site). Le suffixe
// de marque est retiré : sur un site jeune il consomme des caractères sans rien rapporter.
/* ── LE VERDICT DE TÊTE EST DÉRIVÉ DES TROIS CANAUX, TOUJOURS ─────────────────────────────────
 *
 * Première rédaction, refusée par la contre-revue du 05/09/2026 et à juste titre : elle passait en
 * état prudent tant qu'aucun canal n'était décidé, PUIS rendait la main au verdict YAML dès qu'un
 * canal l'était. Une simple citation cabine aurait donc pu faire réapparaître un « No pets » ou un
 * « Easy » historique sans rapport avec les décisions canoniques — la contradiction qu'on ferme
 * serait revenue par la porte de derrière, et personne ne l'aurait vue venir.
 *
 * La règle est donc SANS ÉCHAPPATOIRE : aucun chemin public ne relit `d.verdict.cls` ni
 * `d.verdict.label`. Le sens ET la couleur descendent des trois politiques runtime :
 *
 *   au moins un `allowed`                        → transport possible sur un canal vérifié (ok)
 *   aucun `allowed`, au moins un à confirmer      → conditions à confirmer (warn)
 *   trois `denied` prouvés                        → aucun canal accepté (no)
 *
 * Le libellé vient des chaînes PUBLIÉES, jamais du YAML. */
const verdictDerive = verdictDeFiche(kbAir?.premium?.policy);

/* LE SCORE ET LA NOTE SONT MASQUÉS, SANS CONDITION DE RETOUR.
 *
 * Ma rédaction précédente les rendait dès qu'un canal devenait `allowed` — et la contre-revue du
 * 05/09/2026 l'a refusée pour la même raison que le verdict : un canal cabine cité ne rend pas
 * canonique un `rating` calculé sur des politiques non prouvées, ni une phrase éditoriale écrite
 * avant tout cela. « Cabin and hold are both open » resterait faux le jour où seule la cabine est
 * citée. C'était une seconde porte de derrière, ouverte au même endroit que la première.
 *
 * Ils ne reparaîtront donc PAS par une condition d'affichage : ils reparaîtront le jour où on les
 * aura reconstruits depuis les décisions prouvées — c'est-à-dire par un autre code que celui-ci.
 * La constante est écrite en clair pour que sa suppression soit un geste délibéré, jamais un effet
 * de bord. */
const scoreEtNoteAffichables = false as boolean;
/* ── LES SURFACES ÉDITORIALES CATÉGORIQUES SONT MASQUÉES (contre-revue du 05/09/2026) ──────────
 *
 * Deux blocs de cette page affirmaient encore des faits que rien n'établit :
 *
 *   `ladder`        — « Cabine ≤ 8 kg · Soute 8–75 kg · Fret > 75 kg », des seuils publiés comme
 *                     acquis, sur des canaux dont la décision vaut « à confirmer » ;
 *   `restrictions`  — 201 entrées sur l'ensemble des fiches, et MESURÉ : aucune ne porte de
 *                     source. Leurs clés sont `icon`, `title`, `pills`, `note` — rien d'autre.
 *
 * Ils suivent donc le score et le détail de canal : masqués tant qu'une preuve ne les fonde pas,
 * par une CONSTANTE et non par une condition sur la donnée — rebrancher à la première fiche
 * prouvée republierait les 101 autres. Ils reviendront compagnie par compagnie, quand chacune
 * aura sa source ; rien n'est supprimé de la donnée elle-même.
 *
 * Ce n'est pas une mise à jour de harnais : c'est une correction de véracité publique. */
const surfacesEditorialesAffichables = false as boolean;

const seoLong = F("{0} pet policy: dog in cabin, hold & cargo", "{0} : animaux et chien en cabine ou en soute", "{0}: mascotas y perro en cabina o bodega", d.name);
const seoShort = F("{0} pet policy: dog in cabin & hold", "{0} : animaux en cabine ou en soute", "{0}: mascotas en cabina o bodega", d.name);
const seoTitle = seoLong.length <= 65 ? seoLong : seoShort;
// WebPage about the airline (entity grounding for GEO / rich results).
const webpageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: t(d.metaDesc),
  inLanguage: locale,
  isPartOf: { "@id": "https://mydogcanfly.com/#website" },
  about: { "@type": "Airline", name: d.name },
};
/* FAQ construite sur la POLITIQUE CANONIQUE, la même que les cartes de canaux ci-dessous —
   `kbAir?.premium?.policy` lui est passée explicitement. Sans elle, `airlineFaq` ne produit
   aucune réponse de canal : elle ne se rabat JAMAIS sur `channels[].detail`, dont le texte
   éditorial repartait autrefois dans le balisage `FAQPage`. Le détail est en tête de `faq.ts`.
   Le balisage n'est émis que si des questions ont réellement pu être construites. */
const faqItems = airlineFaq(d, locale, kbAir?.premium?.policy);
const jsonLd = faqItems.length ? [webpageLd, faqJsonLd(faqItems)] : [webpageLd];
---
<Base title={seoTitle} description={t(d.metaDesc)} locale={locale} ogType="article" jsonLd={jsonLd}>
  <div class="mdcf-container afp">
    <Breadcrumb locale={locale} items={[
      { label: T("Home", "Accueil", "Inicio"), href: "/" },
      { label: T("Airlines", "Compagnies", "Aerolíneas"), href: "/airlines/" },
      { label: d.name },
    ]} />

    <div class="card hero">
      {logo
        ? <div class={`logo${logo.dark ? " logo--dark" : ""}`}><img src={logo.src} alt={`${d.name} logo`} loading="lazy" width="140" height="56" /></div>
        : <div class="mono">{d.mono}</div>}
      <div class="hero-id">
        <h1>{tt(locale, "airline.h1").replace("{name}", d.name)}</h1>
        <div class="chips">
          {/* ── LES PUCES QUI AFFIRMENT SONT RETIRÉES (contre-revue du 05/09/2026) ──────────────
              Mesuré sur les 102 fiches : 277 puces, dont 102 « Mise à jour le … » et 6 qui
              énoncent un refus (« No cabin, no hold », « Cargo only », « No pets in the cabin »).

              La puce de DATE est la plus trompeuse des deux : posée en tête, elle ne se rattache
              à aucune preuve et laisse croire que TOUT ce que la page affirme a été vérifié ce
              jour-là. Seule une date attachée à une preuve précise peut paraître — celle du canal
              audité, dans son bloc.

              Les 6 puces de refus énoncent une décision de canal que la frontière ne tient plus
              pour établie : elles contrediraient les pastilles de la même page.

              Ce qui reste est l'identité STRUCTURELLE — alliance, pays, aéroports : ni décision,
              ni date de vérification. Le filtre porte sur l'icône parce que c'est ce que la donnée
              offre ; il est mesuré et gardé par un contrôle DOM. */}
          {d.chips.filter((c) => c.icon !== "🗓" && c.icon !== "🚫").map((c) => (<span class={`pill ${c.cls ?? "neutral"}`}>{c.icon} {t(c.label)}</span>))}
        </div>
      </div>
      <div class="hero-verdict">
        <div class="hv-row">
          {/* LE VERDICT DE TÊTE DESCEND DES DÉCISIONS, PLUS DE L'ÉDITORIAL (arbitrage du
            * 05/09/2026). Il était écrit à la main dans le YAML — « ★ Easy » en vert, « ★ No pets »
            * en rouge — et ne consultait pas `policies:`. Mesuré avant correction : 8 fiches vertes
            * et 29 rouges surmontaient TROIS canaux « à confirmer », zéro canal décidé sous aucune.
            *
            * C'est la faute que `decisionCanal.ts` a fermée un étage plus bas : « une classe
            * VISUELLE ne décide plus d'un verdict ». Elle n'avait jamais été fermée ici.
            *
            * LA RÈGLE : tant qu'aucun canal n'est décidé, la fiche affiche la réserve PUBLIÉE
            * (`air.to_confirm`) dans la classe prudente, et le libellé éditorial s'efface. Dès
            * qu'une citation vérifiée décide un canal, le verdict DÉRIVÉ change de lui-même —
            * mais il reste dérivé : l'ancien libellé YAML ne revient jamais. */}
          <span class={`pill ${verdictDerive.cls} big`}>★ {tt(locale, verdictDerive.cle)}</span>
          {scoreEtNoteAffichables && rating && (
            <span class={`hv-score hv-score--${scoreCls}`} title={T("MyDogCanFly score", "Note MyDogCanFly", "Puntuación MyDogCanFly")}>
              <b>{rating.score.toFixed(1)}</b><small>/5</small>
            </span>
          )}
        </div>
        {scoreEtNoteAffichables && rating && <div class="hv-pts">{rating.points}/100 · {T("MyDogCanFly score", "note MyDogCanFly", "puntuación MyDogCanFly")}</div>}
        {scoreEtNoteAffichables && <p>{t(d.verdictNote)}</p>}
      </div>
      {/* Non-affiliation, sous le logo et non enterrée dans les mentions légales.
        *
        * Deux raisons, dont une seule est celle qu'on croit. La première est le droit des
        * marques : reproduire 76 logos déposés relève de l'usage nominatif loyal, qui suppose
        * qu'on dise n'être pas l'ayant droit. La seconde est la levée d'ambiguïté — un site
        * récent qui affiche une marque aérienne et un formulaire peut se lire comme un faux
        * site de réservation, par une machine comme par un lecteur pressé.
        *
        * Elle vit ici, dans le bloc d'en-tête, parce que c'est là que naît la confusion. La
        * même phrase au fond des mentions légales n'aurait détrompé personne. */}
      <p class="hero-nonaff">{F(
        "MyDogCanFly is not affiliated with {0}. The logo is shown for identification only. We do not sell tickets and take no bookings.",
        "MyDogCanFly n'est pas affilié à {0}. Le logo est affiché à seule fin d'identification. Nous ne vendons pas de billets et ne prenons aucune réservation.",
        "MyDogCanFly no está afiliado a {0}. El logotipo se muestra únicamente con fines de identificación. No vendemos billetes ni gestionamos reservas.",
        d.name,
      )}</p>
    </div>

    <div class="card">
      <h2>⚖️ {T("Where does your dog travel?", "Où voyage ton chien ?", "¿Dónde viaja tu perro?")}</h2>
      <div class="ladder">
        {surfacesEditorialesAffichables && d.ladder.map((s) => (<div style={`flex:${s.flex};background:${s.color}`}>{t(s.label)}<small>{typeof s.sub === "string" ? s.sub : t(s.sub)}</small></div>))}
      </div>
      <p class="muted mt6">{T("Weight includes the carrier or kennel.", "Poids incluant le sac de transport ou la caisse.", "El peso incluye el bolso de transporte o la jaula.")}</p>
      <div class="g mt14">
        {d.channels.map((c) => {
          /* LA DÉCISION VIENT DE LA POLITIQUE CANONIQUE, PAS DE LA PASTILLE ÉDITORIALE.
           *
           * `c.cls` et `c.statusLabel` sont écrits à la main dans la fiche ; sur 78 canaux de
           * 71 fiches ils contredisent la politique. Celle-ci est lue dans la base de
           * connaissances — le MÊME objet runtime que celui dont le moteur tire les cartes du
           * Finder — et `politiqueDuCanal` lève si elle manque : la page casse le build plutôt
           * que de se rabattre sur l'éditorial. */
          const decision = politiqueDuCanal(kbAir?.premium?.policy, c.placement, id);
          const statut = decision.status;
          const cause = causeDeConfirmation(decision);
          const preuve = preuveAuditee(decision);
          /* Le lien officiel SANS phrase citée n'est pas une preuve : il se montre, mais sans
             bouclier, sans « vérifié le… » et sans indice de confiance — ces trois signes
             disent « nous avons lu », et personne n'a lu. */
          const lienOfficiel = preuve ? null : sourceAffichable(decision);
          return (
            <div class="mini" data-placement={c.placement} data-status={statut}>
              <div class="t">{c.icon} {t(c.name)}<span class={`pill ${classeStatut(statut)} ml`}>{tt(locale, cleLibelleStatut(statut))}</span></div>
              {/* ── `c.detail` NE SORT PLUS TEL QUEL (contre-revue du 05/09/2026) ─────────────
                  J'avais écrit que « rien de faux n'atteint l'écran » après n'avoir vérifié que
                  la PASTILLE. C'était inexact, et la contre-revue l'a montré : juste sous une
                  pastille « à confirmer », cette ligne publiait le texte éditorial historique —
                  « moins de 8 kg », « 46 × 28 × 24 cm », « soute jusqu'à 75 kg » pour Air France,
                  l'âge minimal et les exceptions de routes pour Thai Airways — et
                  `chiffresEnGras` mettait ces seuils EN GRAS. Le visiteur lisait donc « à
                  confirmer » et, deux lignes plus bas, une règle détaillée donnée pour certaine.

                  Une citation qui prouve l'ACCEPTATION ne prouve ni le poids, ni les dimensions,
                  ni l'âge, ni les exceptions : ce détail n'est donc pas davantage publiable sur
                  un canal prouvé. Ce que la preuve établit est publié à sa place, verbatim, dans
                  le bloc `proof` ci-dessous — avec son lien et son emplacement. */}
              {/* La phrase générique DIT « rien n'a été confirmé sur une source citée » : sur le
                  seul canal qui l'est — British Airways cabine — elle serait fausse. Elle ne
                  paraît donc que faute de preuve ; là où la preuve existe, c'est le bloc `proof`
                  ci-dessous qui parle, et il ne dit que la phrase citée. */}
              {!preuve && <div class="k">{tt(locale, "premium.channel_unproven")}</div>}
              {/* LE MONTANT A ÉTÉ RETIRÉ (micro-lot Tarifs, 29/08/2026). Il venait de
                  premium.policy[canal].fee — une chaîne libre, sans devise séparée, sans route,
                  sans date d'applicabilité : lisible, mais impossible à rapporter à un trajet.
                  Le statut du canal suffit tant qu'aucune table tarifaire structurée et sourcée
                  n'existe. */}
              {/* ON NE TARIFE PAS UN CANAL QU'ON REFUSE. La première rédaction rendait le statut
                  tarifaire sans regarder le statut du canal : une soute « denied » recevait donc
                  « Tarif à confirmer », ce qui laisse croire qu'un tarif existe pour un canal
                  fermé. Le statut ne paraît que pour « allowed » et « confirmation_required ». */}
              {statut !== "denied" && (
                <div class="amt">{tt(locale, c.placement === "cargo" ? "tarif.devis_cargo" : "tarif.a_confirmer")}</div>
              )}
              {/* La CAUSE de l'incertitude, dite pour ce qu'elle est : la nôtre (donnée non
                * revérifiée) ou celle de la compagnie (rien de publié, accord au cas par cas).
                * Les confondre attribuerait à la compagnie un doute qui vient de nous. */}
              {cause && <div class="why">{tt(locale, `premium.${cause === "legacy_unreviewed" ? "unreviewed" : cause}`)}</div>}
              {/* LA PREUVE DU CANAL, dans le bloc du canal — jamais la source racine de la fiche,
                * ni une auto-citation MyDogCanFly. Absente quand la politique n'a pas été
                * auditée : une politique non revue reste sans source. */}
              {preuve && (
                <div class="proof">
                  <div class="proof-h">🛡️ {tt(locale, "premium.channel_source")}</div>
                  <a class="proof-lnk" href={preuve.url} rel="nofollow noopener" target="_blank">{hote(preuve.url)}</a>
                  {preuve.quote && <blockquote class="proof-q" lang={preuve.quote_language}>« {preuve.quote} »</blockquote>}
                  {preuve.locator && <div class="proof-loc">{preuve.locator}</div>}
                  <div class="proof-m">
                    <span>{tt(locale, "premium.verified_on").replace("{date}", fmtDate(preuve.verified_date))}</span>
                    <span>{tt(locale, "premium.confidence").replace("{n}", String(preuve.confidence))}</span>
                  </div>
                </div>
              )}
              {/* LA PAGE OFFICIELLE ASSOCIÉE — un lien pour aller lire, pas une preuve. Ni date de
                * vérification ni indice de confiance : les afficher ferait exactement ce que ce
                * lot corrige, affirmer une vérification qui n'a pas eu lieu. */}
              {lienOfficiel && (
                <div class="proof proof-weak">
                  <div class="proof-h">🔗 {tt(locale, "premium.channel_official_page")}</div>
                  <a class="proof-lnk" href={lienOfficiel.url} rel="nofollow noopener" target="_blank">{hote(lienOfficiel.url)}</a>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>

    {/* LA GRILLE « TARIFS PAR ZONE » N'EST PLUS RENDUE (micro-lot Tarifs, 29/08/2026), et c'est
        une perte assumée, pas un oubli. Deux fiches la portaient — Air France et TAROM —, avec des
        montants par zone et une note d'applicabilité : la donnée tarifaire la mieux formée du
        site. Elle reste hors du nouveau contrat (ni montant et devise séparés, ni preuve citée
        avec locator, ni date d'applicabilité structurée), et la règle du lot ne souffre pas
        d'exception : aucun montant tant qu'une table structurée et sourcée ne permet pas de le
        calculer. CES DEUX GRILLES SONT LES PREMIÈRES CANDIDATES à la migration. */}

    {/* LE TABLEAU « TARIFS » N'EST PLUS RENDU (micro-lot Tarifs, 29/08/2026) — et c'était la
        surface la plus LARGE : 90 fiches sur 102. J'avais corrigé trois surfaces à la main ;
        c'est le contrôle du DOM CONSTRUIT qui a trouvé les trois autres — la FAQ, la grille par
        zone, puis ce tableau. Une relecture, si attentive soit-elle, cherche là où elle pense à
        regarder ; un contrôle qui lit le HTML servi cherche partout.

        Ces lignes portent un libellé et une valeur libres, sans devise séparée, sans route, sans
        date d'applicabilité — impossibles à rapporter au trajet demandé. Elles reviendront quand
        une table structurée et sourcée permettra de calculer, et elles répondront alors POUR UN
        TRAJET, pas en général. */}

    <div class="card danger">
      <h2>⚠️ {T("Key restrictions", "Restrictions importantes", "Restricciones importantes")}</h2>
      <div class="g">
        {surfacesEditorialesAffichables && d.restrictions.map((r) => (
          <div class="mini">
            <div class="t">{r.icon} {t(r.title)}</div>
            <div class="chips mt8">{r.pills.map((p) => (<span class={`pill ${p.cls}`}>{t(p.label)}</span>))}</div>
            <div class="k">{t(r.note)}</div>
          </div>
        ))}
      </div>
    </div>

    {/* NOTRE TAXONOMIE N'EST PAS CELLE DE LA COMPAGNIE.
      *
      * Ce bloc affichait les races que MyDogCanFly classe comme brachycéphales sous un titre
      * — « Races concernées par cette politique » — et une phrase — « les N races que nous
      * documentons sont concernées » — qui les faisaient lire comme la liste publiée par le
      * transporteur. Elles ne le sont pas, et l'audit du 8 août 2026 a montré que le gabarit
      * produisait ce glissement sur 37 des 92 fiches : partout où une restriction
      * brachycéphale existe, la MÊME liste de 31 races s'affiche, quelle que soit la
      * compagnie.
      *
      * L'erreur coûte dans les deux sens : une race que la compagnie n'a jamais nommée
      * apparaît refusée (le saint-bernard chez Air France et Aegean), et une race que la
      * compagnie refuse vraiment mais que notre taxonomie ignore n'apparaît pas.
      *
      * La liste reste — c'est une aide au repérage utile, et le maillage vers les fiches
      * races en dépend — mais elle est désormais nommée pour ce qu'elle est. Ce que la
      * compagnie a écrit, elle, vit dans `restrictions` de sa fiche, sourcé au cas par cas. */}
    {brachy && brachyList.length > 0 && (
      <div class="card">
        <h2>🐶 {T("Check whether your dog is snub-nosed", "Vérifie si ton chien est brachycéphale", "Comprueba si tu perro es braquicéfalo")}</h2>
        {/* CETTE PHRASE RENVOYAIT À UN BLOC QUE LE MASQUAGE VIENT DE FAIRE DISPARAÎTRE.
            Elle dit « ce que la compagnie a écrit figure dans les restrictions ci-dessus » —
            or `restrictions` n'est plus rendu, faute de source. Elle affirmait en outre, au
            nom de la compagnie, un refus tiré de ces mêmes `restrictions` non sourcées. Elle
            ne paraît donc plus tant que ces données n'ont pas de citation ; la phrase générique
            la remplace, et la liste ci-dessous — qui se déclare NOTRE classification et sert
            le maillage vers les fiches races — reste. */}
        {!surfacesEditorialesAffichables && <p class="k">{tt(locale, "premium.editorial_unproven")}</p>}
        {surfacesEditorialesAffichables && <p class="k">
          {brachy.kind === "explicit"
            ? F("{0} refuses brachycephalic (snub-nosed) breeds in {1}. What the airline itself wrote is in the restrictions above — that text alone says which breeds it turns away.",
                "{0} refuse les races brachycéphales (museau court) en {1}. Ce que la compagnie a écrit elle-même figure dans les restrictions ci-dessus — ce texte seul dit quelles races elle écarte.",
                "{0} rechaza las razas braquicéfalas (hocico chato) en {1}. Lo que la propia aerolínea ha escrito está en las restricciones de arriba — solo ese texto dice qué razas rechaza.",
                d.name, chanList)
            : F("{0}'s published conditions mention snub-nosed breeds ({1}) without stating a general refusal. Check your breed's fiche, then confirm with the airline before booking.",
                "Les conditions publiées par {0} évoquent les races à museau court ({1}) sans énoncer de refus général. Vérifie la fiche de ta race, puis confirme auprès de la compagnie avant de réserver.",
                "Las condiciones publicadas por {0} mencionan las razas de hocico chato ({1}) sin declarar un rechazo general. Consulta la ficha de tu raza y confírmalo con la aerolínea antes de reservar.",
                d.name, chanList)}
        </p>}
        <div class="reach-chips mt8">
          {brachyList.map((b) => (<a class="reach-chip" href={`${base}/breeds/${b.slug}/`}>{b.name} <span class="reach-iata">{b.weightKg} kg</span></a>))}
        </div>
        {/* La phrase évite « la liste de {compagnie} » : l'élision française tombe faux dès que le
          * nom commence par une voyelle (« de Aegean », « de Air France »). On dit donc « la liste
          * publiée par {compagnie} », qui marche pour les 92 fiches sans table d'exceptions. */}
        <p class="muted mt8">{F("These {0} breeds are MyDogCanFly's own brachycephalic classification, heaviest first — it is not the list published by {1}. Use it to situate your dog, then read the airline's own wording above and confirm with it before booking.",
            "Ces {0} races sont la classification brachycéphale de MyDogCanFly, les plus lourdes d'abord — ce n'est pas la liste publiée par {1}. Sers-t'en pour situer ton chien, puis lis le texte de la compagnie ci-dessus et confirme auprès d'elle avant de réserver.",
            "Estas {0} razas son la clasificación braquicéfala propia de MyDogCanFly, las más pesadas primero — no es la lista publicada por {1}. Úsala para situar a tu perro, luego lee el texto de la aerolínea más arriba y confírmalo con ella antes de reservar.",
            brachyList.length, d.name)}</p>
      </div>
    )}

    {/* ── CAISSE, TEMPÉRATURE, CHIEN D'ASSISTANCE : MASQUÉS TANT QU'ILS NE SONT PAS PROUVÉS ──
        Même mouvement que `ladder` et `restrictions`, et même mesure : `crate`, `temperature`
        et `assistance` sont du texte libre quadrilingue — une entrée de `crate` n'a que les
        clés `en`/`fr`/`es`/`pt`, il n'y a pas même de place pour une source. Ils affirmaient
        pourtant, compagnie nommée, « max 55 × 40 × 23 cm », « mais 40 × 25 × 25 cm sur DH8-100
        et ATR », « animal moyen (8–25 kg) ». C'est le contrôle DOM des fiches sentinelles qui
        les a trouvés : j'avais masqué la ligne `detail` de la carte en croyant avoir tout vu.
        Le lien vers l'outil de caisse SURVIT au masquage : il ne dit rien de la compagnie, il
        mène à un calcul que le visiteur fait lui-même. */}
    {surfacesEditorialesAffichables && d.crate && (
      <div class="card">
        <h2>📦 {T("The travel crate for the hold", "La cage de transport en soute", "El transportín para viajar en bodega")}</h2>
        <div class="cols">
          {d.crate.map((c) => (<div class="chk"><span class="ci ok">✓</span> {t(c)}</div>))}
        </div>
      </div>
    )}

    <div class="card warnb">
      <h2>🌡️ {T("Temperature & hold", "Température & soute", "Temperatura y bodega")}</h2>
      {surfacesEditorialesAffichables && (
        <div class="chips mb8">
          {d.temperature.pills.map((p) => (<span class={`pill ${p.cls}`}>{t(p.label)}</span>))}
        </div>
      )}
      <p class="muted">{surfacesEditorialesAffichables ? t(d.temperature.note) : tt(locale, "premium.editorial_unproven")}</p>
      <a class="cratecta" data-carry="breed" href={`${locale === "en" ? "/tools/crate/" : `/${locale}/tools/crate/`}#air=${id}`}>📦 {T("Check your crate size for this airline", "Vérifier la taille de cage pour cette compagnie", "Comprueba el tamaño de la jaula para esta aerolínea")} →</a>
    </div>

    {surfacesEditorialesAffichables && (
      <div class="card">
        <h2>🦮 {T("Assistance dog", "Chien d'assistance", "Perro de asistencia")}</h2>
        <div class="g">
          {d.assistance.map((a) => (
            <div class="mini"><div class="t"><span class="aci">{a.icon}</span> {t(a.label)}</div><div class="k">{t(a.value)}</div></div>
          ))}
        </div>
      </div>
    )}

    {/* `goodToKnow` relève de la MÊME classe, et je l'avais laissé passer : « accord préalable
        obligatoire · soute ≥ 24 h · États-Unis 48 h », « 15 semaines, vaccins à jour », « Air
        France n'accepte pas les animaux ordinaires en cabine Business sur les vols
        intercontinentaux ». Ce sont des règles de compagnie, catégoriques, sans source. */}
    {surfacesEditorialesAffichables && (
      <div class="card">
        <h2>ℹ️ {T("Good to know", "Bon à savoir", "Conviene saber")}</h2>
        {d.goodToKnow.map((g) => (
          <div class="row"><span class="lbl">{g.icon} {t(g.label)}</span><span class="muted r">{t(g.value)}</span></div>
        ))}
      </div>
    )}

    {(reach.countries.length > 0 || reach.hubs.length > 0) && (
      <div class="card reach">
        <h2>🗺️ {F("Where {0} flies with dogs", "Où {0} vole avec les chiens", "Adónde vuela {0} con perros", d.name)}</h2>
        {reach.hubs.length > 0 && (
          <div class="reach-blk">
            <div class="reach-lbl">{T("Main hubs", "Principaux hubs", "Hubs principales")}</div>
            <div class="reach-chips">
              {reach.hubs.map((h) => (<a class="reach-chip" href={`${base}/airports/${h.slug}/`}>{h.city} <span class="reach-iata">{h.iata}</span></a>))}
            </div>
          </div>
        )}
        {reach.countries.length > 0 && (
          <div class="reach-blk">
            <div class="reach-lbl">{T("Destinations — entry rules", "Destinations — formalités d'entrée", "Destinos — reglas de entrada")}{reach.totalCountries > reach.countries.length && F(" ({0} of {1})", " ({0} sur {1})", " ({0} de {1})", reach.countries.length, reach.totalCountries)}</div>
            <div class="reach-chips">
              {reach.countries.map((c) => (<a class="reach-chip" href={`${base}/countries/${c.slug}/`}>{c.name}</a>))}
            </div>
            {noPetNames.length > 0 && (
              <p class="muted mt8">{F("{0} also flies to {1}, but carries no pets on those routes — they're left out of the list above.",
                  "{0} dessert aussi {1}, mais n'y transporte aucun animal — ces pays sont donc hors de la liste ci-dessus.",
                  "{0} también vuela a {1}, pero no transporta ninguna mascota en esas rutas — por eso quedan fuera de la lista de arriba.",
                  d.name, noPetNames.join(" · "))}</p>
            )}
          </div>
        )}
      </div>
    )}

    <FaqBlock
      items={faqItems}
      title={F("Flying with a dog on {0}: common questions",
               "Voyager avec un chien sur {0} : questions fréquentes",
               "Viajar con un perro en {0}: preguntas frecuentes", d.name)}
      {/* LA FAQ NE DATE PLUS UNE VÉRIFICATION QU'ELLE NE PEUT PAS ÉTABLIR (contre-revue du
        * 05/09/2026). Elle affirmait « dernière vérification le 8 août 2026 » sur une fiche dont
        * aucune politique ne porte de citation. Ce qui reste est vrai et utile : les réponses
        * viennent des conditions publiées par la compagnie, et ces conditions changent. */}
      note={T("This page summarises the information currently on record. Conditions can change: confirm them with the airline before booking.",
              "Cette page résume les informations actuellement enregistrées. Les conditions peuvent changer : confirme-les auprès de la compagnie avant de réserver.",
              "Esta página resume la información registrada actualmente. Las condiciones pueden cambiar: confírmalas con la aerolínea antes de reservar.")}
    />

    <OnwardNav locale={locale} currentAirlineId={id} defaultIso={homeIso} defaultName={homeName} />

    <div class="card src">
      {/* LE BLOC HISTORIQUE `d.sources` N'EST PLUS RENDU (contre-revue du 05/09/2026).
        *
        * Il affichait, sous un bouclier vert « Source officielle », une ligne du genre « Air France
        * sources · confidence 5/5 · collected 8 August 2026 ». Trois affirmations, dont aucune
        * n'est rattachable aux faits de la page : un bouclier qui valide, une confiance chiffrée
        * qui ne vient d'aucune preuve, une date de collecte globale qui ne dit rien de la politique
        * cabine ni de la soute. Retirer le NOMBRE de sources ne suffisait pas — c'est la promesse
        * entière qu'il fallait retirer.
        *
        * Seuls les blocs de CANAL parlent encore de provenance, et sous condition stricte : une
        * `T0bAuditSource` affiche citation, locator, date et confiance ; une
        * `official_source_unquoted` n'affiche que son lien et la réserve prudente.
        *
        * `verified_date` reste en donnée interne : il porte la cadence de revue (ADR-0007). */}
      {/* G minimal (arbitrage Codex 28/08/2026) : la fiche décrit la compagnie qui vend — en
          partage de code, l'opérateur effectif peut différer et ses conditions avec. Présence
          quadrilingue garantie par test-mention-transporteur.mjs. */}
      <p class="muted codeshare">{tt(locale, "codeshare.notice")}</p>
    </div>

    <PageActions locale={locale} airlineId={id} bookUrl={d.book?.url} bookLabel={T("Book on {n}", "Réserver sur {n}", "Reservar en {n}").replace("{n}", d.book?.host ?? d.name)} emailSubject={seoTitle} />
  </div>
</Base>

<style>
