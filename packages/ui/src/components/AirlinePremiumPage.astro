  .afp .hero { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .afp .mono { flex: 0 0 auto; width: 72px; height: 72px; border-radius: 16px; background: #001e50; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 26px; font-weight: 800; letter-spacing: .5px; }
  .afp .logo { flex: 0 0 auto; height: 72px; min-width: 72px; max-width: 200px; padding: 12px 16px; border-radius: 16px; background: #fff; border: 1px solid var(--mdcf-border, #e6eaf0); display: flex; align-items: center; justify-content: center; }
  .afp .logo--dark { background: #001e50; border-color: #001e50; }
