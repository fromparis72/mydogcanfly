  .afp .ok { background: #dcfce7; color: #166534; } .afp .no { background: #fee2e2; color: #b3261e; } .afp .warn { background: #fff3e2; color: #9a5a12; }
  .afp .neutral { background: var(--mdcf-subtle, #f5f7fa); color: var(--mdcf-muted, #5b6b7f); }
