  .afp .reach-lbl { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 700; color: var(--mdcf-muted, #5b6b7f); margin-bottom: 9px; }
  .afp .reach-chips { display: flex; flex-wrap: wrap; gap: 8px; }
