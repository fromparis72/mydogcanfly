   * une mention légale illisible ne détrompe personne. */
  .afp .hero-nonaff { flex: 1 1 100%; margin: 4px 0 0; padding-top: 10px;
    border-top: 1px solid var(--mdcf-border, #e6eaf0);
    color: var(--mdcf-muted, #5b6b7f); font-size: 12.5px; line-height: 1.45; }
  .afp .hv-row { display: flex; gap: 9px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }
