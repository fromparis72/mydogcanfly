  .afp .proof-h { font-weight: 700; color: var(--mdcf-ink, #1a2433); }
  .afp .proof-lnk { display: inline-block; margin-top: 3px; font-weight: 600; color: var(--mdcf-accent-ink, #b4530a); word-break: break-word; }
  .afp .proof-q { margin: 6px 0 0; padding-left: 9px; border-left: 2px solid var(--mdcf-line, #e6ebf1); color: var(--mdcf-muted, #5b6b7f); font-style: italic; line-height: 1.45; }
  .afp .proof-loc { margin-top: 5px; color: var(--mdcf-muted, #5b6b7f); }
  .afp .proof-m { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; font-weight: 600; color: var(--mdcf-muted, #5b6b7f); }
  /* Le lien officiel non cité est visuellement PLUS SOBRE que la preuve : même bloc, titre en
     retrait, aucune métadonnée. La hiérarchie visuelle dit la hiérarchie de confiance. */
  .afp .proof-weak .proof-h { font-weight: 600; color: var(--mdcf-muted, #5b6b7f); }
  .afp table.fare { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .afp table.fare th, .afp table.fare td { padding: 9px 10px; border-bottom: 1px solid var(--mdcf-line, #e6ebf1); text-align: left; }
  .afp table.fare th { font-size: 12.5px; font-weight: 700; color: var(--mdcf-muted, #5b6b7f); text-transform: uppercase; letter-spacing: .04em; }
  .afp table.fare .r { text-align: right; font-weight: 800; white-space: nowrap; }
  .afp .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 26px; }
  .afp .chk { display: flex; gap: 10px; align-items: flex-start; padding: 6px 0; font-size: 14.5px; }
  .afp .ci { flex: 0 0 auto; font-weight: 800; } .afp .ci.ok { color: #166534; }
  .afp .row { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--mdcf-line, #e6ebf1); }
  .afp .row:last-child { border-bottom: 0; }
  .afp .row .lbl { font-weight: 700; } .afp .row .r { text-align: right; }
  .afp .danger { border-color: #f3c9c4; } .afp .warnb { border-color: #f0d9b8; }
  .afp .src { background: var(--mdcf-subtle, #f5f7fa); border: 0; }
  .afp .cta { display: flex; gap: 12px; align-items: stretch; justify-content: center; flex-wrap: wrap; margin: 0 0 16px; }
  /* Both capsules share the exact same height ("gabarit"). */
  .afp .cta > .mdcf-btn, .afp .cta > .book { min-height: 44px; box-sizing: border-box; }
  .afp .cta .book { display: inline-flex; align-items: center; justify-content: center; gap: 6px; color: var(--mdcf-accent-ink, #b4530a); font-weight: 700; font-size: 14px; text-decoration: none;
    background: var(--mdcf-surface, #fff); border: 1px solid var(--mdcf-line, #e6ebf1); border-radius: 999px; padding: 0 16px;
    transition: border-color .12s ease, box-shadow .12s ease; }
  .afp .cta .book:hover { border-color: var(--mdcf-accent-ink, #b4530a); box-shadow: 0 2px 8px rgba(15, 23, 42, .06); }
  @media (max-width: 640px) {
    .afp .hero { gap: 12px 14px; }
    .afp .hero-verdict { flex: 1 1 100%; max-width: none; min-width: 0; text-align: left; }
    .afp .hv-row { justify-content: flex-start; }
    .afp .hero-verdict p { margin-top: 6px; }
  }
  .afp .reach-blk { margin-top: 12px; }
  .afp .reach-blk:first-of-type { margin-top: 0; }
  .afp .reach-lbl { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 700; color: var(--mdcf-muted, #5b6b7f); margin-bottom: 9px; }
  .afp .reach-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .afp .reach-chip { display: inline-flex; align-items: center; gap: 7px; text-decoration: none; font-weight: 600; font-size: 13.5px; color: var(--mdcf-ink, #1a2433); background: var(--mdcf-subtle, #f5f7fa); border: 1px solid var(--mdcf-line, #e6ebf1); border-radius: 999px; padding: 6px 12px; }
  .afp .reach-chip:hover { border-color: var(--mdcf-muted, #5b6b7f); }
  .afp .reach-iata { font-size: 11.5px; font-weight: 800; color: var(--mdcf-muted, #5b6b7f); letter-spacing: .03em; }
</style>
