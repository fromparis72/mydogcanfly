---
/* Heat-risk calculator — will the hold/cargo be under a summer heat embargo on this route/month?
   Route-based (departure + arrival airports), month granularity. Honest & data-driven:
   - Temperatures are SEASONAL ESTIMATES from airport latitude + month (same model as the engine's
     destinations tool: SUMMER_HIGH/WINTER_HIGH piecewise curves). Clearly labelled as estimates.
   - Embargo threshold 30°C, risk band 27-30°C (matches engine). Snub-nosed breeds get stricter
     thresholds (27 / 24) because carriers apply lower cut-offs for them (e.g. BA 24°C / 75°F).
   - Scope: HOLD / CARGO only (cabin is climate-controlled — one honest caveat line). */
import { loadKB, breedName, cityName, inlineT } from "@mydogcanfly/knowledge";
import { hrefFor } from "../lib/routes";

interface Props { locale?: string }
const { locale = "en" } = Astro.props;
const fr = locale === "fr";
const T = inlineT(locale);
const kb = loadKB();
const loc = (lt: unknown): string => (lt as Record<string, string>)?.[locale] ?? (lt as { en: string })?.en ?? "";

const airports = [...kb.airports.values()]
  .filter((a) => (a as any).geo?.lat != null)
  .map((a: any) => {
    const c = kb.countries.get(a.country_id);
    return { id: a.id, iata: a.iata, city: cityName(a, locale), country: c ? loc(c.name) : "", iso2: c?.iso2 ?? "", lat: a.geo.lat };
  })
  .sort((x, y) => x.city.localeCompare(y.city, locale));

const breeds = [...kb.breeds.values()]
  .map((b) => ({ id: b.id, label: breedName(b, locale), br: b.brachycephalic }))
  .sort((x, y) => x.label.localeCompare(y.label, locale));

const months = locale === "fr"
  ? ["janv.", "févr.", "mars", "avril", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."]
  : locale === "es"
  ? ["ene.", "feb.", "mar.", "abr.", "may.", "jun.", "jul.", "ago.", "sept.", "oct.", "nov.", "dic."]
  : ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

const L = {
  locale,
  airports,
  breeds: Object.fromEntries(breeds.map((b) => [b.label.toLowerCase(), { id: b.id, br: b.br }])),
  breedById: Object.fromEntries(breeds.map((b) => [b.id, b.label])),
  months,
  finderHref: (locale === "en" ? "/" : `/${locale}/`) + "#flight-finder",
  crateHref: locale === "en" ? "/tools/crate/" : `/${locale}/tools/crate/`,
  s: {
    depPh: T("Departure airport (city or code)", "Aéroport de départ (ville ou code)", "Aeropuerto de salida (ciudad o código)"),
    arrPh: T("Arrival airport (city or code)", "Aéroport d'arrivée (ville ou code)", "Aeropuerto de llegada (ciudad o código)"),
    breedPh: T("Breed (optional — refines the risk)", "Race (facultatif — affine le risque)", "Raza (opcional: afina el riesgo)"),
    submit: T("Check the heat risk", "Évaluer le risque chaleur", "Evaluar el riesgo por calor"),
    needBoth: T("Pick a departure and an arrival airport.", "Choisis un aéroport de départ et un d'arrivée.", "Elige un aeropuerto de salida y uno de llegada."),
    at: T("at", "à", "a"),
    // Retest 09/08/2026, point 4 (option A) : le libellé affirmait une "estimation saisonnière"
    // sans réserve suffisante pour un usage aussi sensible qu'un embargo chaleur — renommé pour
    // dire clairement le niveau de précision réel (latitude + mois, sans altitude ni climat local).
    estimate: T("Very approximate climate indicator", "Indicateur climatique très approximatif", "Indicador climático muy aproximado"),
    verdictTitle: T("Hold / cargo heat verdict", "Verdict chaleur soute / cargo", "Veredicto de calor en bodega / carga"),
    /* P0 climat (13/08/2026) : « Feu vert » affirmait une autorisation, et « plage sûre » une
       sécurité, sur la foi d'une estimation latitude + mois. Une estimation ne peut dire qu'une
       chose : cet indicateur ne détecte aucun signal. */
    ok: T("No heat signal from this indicator", "Aucun signal chaleur détecté par cet indicateur", "Sin señal de calor de este indicador"),
    risk: T("Elevated risk", "Risque élevé", "Riesgo elevado"),
    // Retest 09/08/2026, point 5 : "Embargo probable" affirmait un pronostic sur LE vol réservé ;
    // la valeur sous-jacente est une moyenne climatique mensuelle, pas la météo du jour du vol.
    /* v3 (contre-revue P0-C v2) : « historiquement » revendiquait un historique d'embargos que
       cet outil ne possède pas — sa seule donnée est une courbe latitude+mois. On dit le seuil
       dépassé, rien de plus. */
    embargo: T("Estimated heat above the usual threshold", "Chaleur estimée au-dessus du seuil habituel", "Calor estimado por encima del umbral habitual"),
    okD: T("This latitude + month estimate finds no heat signal for hold/cargo on this route — it is not a forecast and not a safety guarantee: confirm with the airline.", "Cette estimation latitude + mois ne détecte aucun signal chaleur pour la soute/le fret sur cette route — ce n'est ni une prévision ni une garantie de sécurité : confirme auprès de la compagnie.", "Esta estimación por latitud + mes no detecta ninguna señal de calor para bodega/carga en esta ruta; no es una previsión ni una garantía de seguridad: confírmalo con la aerolínea."),
    riskD: T("Warm enough that airlines may restrict hold/cargo travel — confirm with the carrier.", "Assez chaud pour que des compagnies restreignent la soute/cargo — à confirmer avec la compagnie.", "Hace suficiente calor como para que las aerolíneas restrinjan la bodega/carga: confírmalo con la aerolínea."),
    embargoD: T("The latitude+month estimate exceeds the threshold some carriers publish for hold/cargo. This is a modelled estimate — not a record of past embargoes, not a forecast: check the policy with the airline.", "L'estimation latitude+mois dépasse le seuil que certaines compagnies publient pour la soute/le fret. C'est une estimation modélisée — ni un historique d'embargos, ni une prévision : vérifie la politique auprès de la compagnie.", "La estimación por latitud+mes supera el umbral que algunas aerolíneas publican para bodega/carga. Es una estimación modelada, no un historial de embargos ni una previsión: verifica la política con la aerolínea."),
    // Retest 09/08/2026, point 5 : précise que la valeur est une moyenne climatique mensuelle, pas
    // la température maximale ni celle réellement prévue le jour du vol.
    avgClarify: T("This value is a monthly climate average — not the maximum temperature, nor the forecast for the actual flight day.", "Cette valeur est une moyenne climatique mensuelle, pas la température maximale ni celle du jour du vol.", "Este valor es un promedio climático mensual, no la temperatura máxima ni la prevista para el día real del vuelo."),
    // Retest 09/08/2026, point 7 : les seuils (déjà codés) n'étaient jamais montrés à l'utilisateur.
    thresholdLine: T("MyDogCanFly indicative threshold: amber from {risk} °C, red from {emb} °C.", "Seuil indicatif MyDogCanFly : ambre à partir de {risk} °C, rouge à partir de {emb} °C.", "Umbral indicativo de MyDogCanFly: ámbar a partir de {risk} °C, rojo a partir de {emb} °C."),
    thresholdCaveat: T("Some carriers apply a lower threshold, or an independent seasonal embargo regardless of temperature.", "Certaines compagnies appliquent un seuil plus bas, ou un embargo saisonnier indépendant de la température.", "Algunas aerolíneas aplican un umbral más bajo, o un embargo estacional independiente de la temperatura."),
    brachy: T("Snub-nosed breed: stricter limits apply, and many carriers ban them from the hold year-round regardless of temperature.", "Race brachycéphale : seuils plus stricts, et de nombreuses compagnies l'interdisent en soute toute l'année, quelle que soit la température.", "Raza de hocico chato: se aplican límites más estrictos y muchas aerolíneas las prohíben en bodega todo el año, sea cual sea la temperatura."),
    calendar: T("Heat by month on this route", "Chaleur par mois sur cette route", "Calor por mes en esta ruta"),
    calNote: T("Worst of the two airports each month. Green = no signal, amber = elevated estimate, red = estimate above threshold.", "Pire des deux aéroports chaque mois. Vert = aucun signal, ambre = estimation élevée, rouge = estimation au-dessus du seuil.", "El peor de los dos aeropuertos cada mes. Verde = sin señal, ámbar = estimación elevada, rojo = estimación por encima del umbral."),
    bestMonths: T("Best months", "Meilleurs mois", "Mejores meses"),
    // Retest 09/08/2026, point 8 : pour une race brachycéphale, "Meilleurs mois" laissait entendre
    // qu'elle serait acceptée en soute ces mois-là, alors que beaucoup de compagnies l'interdisent
    // toute l'année indépendamment de la température (cf. la note "brachy" déjà affichée juste au-dessus).
    bestMonthsBrachy: T("Climatically least unfavourable months — this does not mean the breed is accepted in the hold.", "Mois climatiquement les moins défavorables — cela ne signifie pas que la race est acceptée en soute.", "Meses climáticamente menos desfavorables: esto no significa que la raza esté aceptada en bodega."),
    caveat: T("Estimates from airport latitude + month only — no altitude, coastal/continental climate, or local normals. Not a live forecast. Heat embargoes apply to hold/cargo; a small dog travelling in the climate-controlled cabin is not affected. Always confirm with the airline.", "Estimations d'après la seule latitude de l'aéroport + le mois — sans altitude, climat continental/maritime ni normales locales. Pas une prévision en temps réel. Les embargos chaleur concernent la soute/cargo ; un petit chien voyageant en cabine climatisée n'est pas concerné. Confirme toujours avec la compagnie.", "Estimaciones basadas solo en la latitud del aeropuerto + el mes, sin altitud, clima continental/marítimo ni normales locales. No es una previsión en tiempo real. Los embargos por calor afectan a la bodega/carga; un perro pequeño que viaja en la cabina climatizada no se ve afectado. Confirma siempre con la aerolínea."),
    onwardAir: T("Find the best airline for this trip", "Trouver la meilleure compagnie pour ce voyage", "Encontrar la mejor aerolínea para este viaje"),
    onwardCrate: T("Which travel crate size?", "Quelle taille de cage ?", "¿Qué talla de jaula?"),
    degC: "°C",
    // Retest 09/08/2026, points 1, 2, 3
    breedInvalid: T("Choose a breed from the list, or clear the field to continue without one.", "Sélectionne une race dans la liste ou efface le champ pour continuer sans race.", "Elige una raza de la lista, o borra el campo para continuar sin raza."),
    staleHint: T("Criteria changed — rerun the check.", "Critères modifiés — relance l'évaluation.", "Criterios modificados: repite la evaluación."),
    sameAirport: T("Departure and arrival must be different.", "Le départ et l'arrivée doivent être différents.", "La salida y la llegada deben ser diferentes."),
  },
};
---
<div class="hx">
  <form id="hx-form" class="hx-form" autocomplete="off">
    <div class="hx-field"><label for="hx-dep">{T("Departure", "Départ", "Salida")}</label>
      <input id="hx-dep" data-ac="dep" role="combobox" aria-autocomplete="list" aria-expanded="false" placeholder={L.s.depPh} autocomplete="off" data-lpignore="true" data-1p-ignore data-form-type="other" /></div>
    <div class="hx-field"><label for="hx-arr">{T("Arrival", "Arrivée", "Llegada")}</label>
      <input id="hx-arr" data-ac="arr" role="combobox" aria-autocomplete="list" aria-expanded="false" placeholder={L.s.arrPh} autocomplete="off" data-lpignore="true" data-1p-ignore data-form-type="other" /></div>
    <div class="hx-field hx-field--sm"><label for="hx-month">{T("Month", "Mois", "Mes")}</label>
      <select id="hx-month">{months.map((m, i) => <option value={i + 1}>{m}</option>)}</select></div>
    <div class="hx-field"><label for="hx-breed">{T("Breed", "Race", "Raza")}</label>
      <input id="hx-breed" data-ac="breed" role="combobox" aria-autocomplete="list" aria-expanded="false" placeholder={L.s.breedPh} autocomplete="off" data-lpignore="true" data-1p-ignore data-form-type="other" /></div>
    <button class="mdcf-btn hx-submit" type="submit">{L.s.submit}</button>
  </form>
  <div id="hx-out" class="hx-out" hidden></div>
</div>

<script type="application/json" id="hx-data" set:html={JSON.stringify(L)} is:inline />
<script>
  import { attachCombobox } from "../lib/combobox";
  const L = JSON.parse(document.getElementById("hx-data").textContent);
  const $ = (s) => document.querySelector(s);
  const norm = (s) => (s ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
  const esc = (s) => (s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

  // --- climate model (mirrors engine destinations.ts) ---
  const SUMMER = [[0,31],[10,32],[20,35],[27,37],[35,33],[45,27],[55,21],[65,17],[90,9]];
  const WINTER = [[0,30],[10,30],[20,27],[30,22],[40,12],[50,6],[60,0],[90,-20]];
  function piece(p, x){ if(x<=p[0][0])return p[0][1]; for(let i=1;i<p.length;i++){const[x1,y1]=p[i]; if(x<=x1){const[x0,y0]=p[i-1]; return y0+((y1-y0)*(x-x0))/(x1-x0);}} return p[p.length-1][1]; }
  function tempAt(lat, month){ const a=Math.abs(lat), su=piece(SUMMER,a), wi=piece(WINTER,a); const peak=lat<0?1:7; const dist=Math.min(Math.abs(month-peak),12-Math.abs(month-peak)); const s=(Math.cos((dist/6)*Math.PI)+1)/2; return Math.round(wi+(su-wi)*s); }

  // thresholds: [embargo, risk] — snub-nosed breeds get stricter cut-offs
  function bands(brachy){ return brachy ? { emb:27, risk:24 } : { emb:30, risk:27 }; }
  function level(temp, b){ return temp> b.emb ? "no" : temp> b.risk ? "warn" : "ok"; }

  const airByKey = {};
  L.airports.forEach((a)=>{ airByKey[a.id]=a; });
  function findAirport(text){
    const q=norm(text); if(!q) return null;
    // exact "City (IATA)" match first, then startsWith, then includes
    let hit=L.airports.find((a)=>norm(a.city+" ("+a.iata+")")===q) ||
            L.airports.find((a)=>norm(a.iata)===q) ||
            L.airports.find((a)=>norm(a.city).startsWith(q)) ||
            L.airports.find((a)=>norm(a.city+" "+a.iata+" "+a.country).includes(q));
    return hit||null;
  }
  const label = (a)=> a.city+" ("+a.iata+")";

  // --- autocomplete, shared with the other tools.
  // Retest 09/08/2026, point 9 : motif ARIA complet centralisé dans lib/combobox.ts — cet outil
  // n'avait auparavant aucun rôle ARIA sur sa liste de suggestions. ---
  const breedLabels=Object.values(L.breedById);
  function acItems(key, q){
    const n=norm(q);
    if(key==="breed"){ return (n?breedLabels.filter(k=>norm(k).includes(n)):breedLabels).slice(0,8).map(k=>({display:k,value:k})); }
    const src=L.airports;
    const arr=(n?src.filter(a=>norm(a.city+" "+a.iata+" "+a.country).includes(n)):src).slice(0,8);
    return arr.map(a=>({display:label(a)+" — "+a.country, value:label(a)}));
  }
  ["#hx-dep","#hx-arr","#hx-breed"].forEach((s)=>{
    const input=$(s);
    const key=input.getAttribute("data-ac");
    attachCombobox({ input, hostSelector: ".hx-field", getItems: (q)=>acItems(key, q) });
  });

  const badge=(lv,txt)=>`<span class="hx-pill hx-${lv}">${txt}</span>`;
  const emoji={ok:"🟢",warn:"🟡",no:"🔴"};

  // Retest 09/08/2026, point 2 : aucun mécanisme n'invalidait un résultat affiché quand un critère
  // changeait ensuite (départ, arrivée, mois, race) — même patron que les 3 autres outils.
  function markStale(){
    const out=$("#hx-out");
    if(!out||out.hidden) return;
    if(out.querySelector(".hx-msg")) return; // pas un vrai résultat (message d'aide/erreur)
    if(out.querySelector(".hx-stale")) return;
    const banner=document.createElement("div");
    banner.className="hx-stale";
    banner.textContent=L.s.staleHint;
    out.insertBefore(banner, out.firstChild);
  }
  ["#hx-dep","#hx-arr","#hx-breed"].forEach((s)=>{ const el=$(s); el?.addEventListener("input",markStale); el?.addEventListener("change",markStale); });
  $("#hx-month")?.addEventListener("change",markStale);

  $("#hx-form").addEventListener("submit",(e)=>{
    e.preventDefault();
    const dep=findAirport($("#hx-dep").value), arr=findAirport($("#hx-arr").value);
    const out=$("#hx-out"); out.hidden=false;
    if(!dep||!arr){ out.innerHTML=`<div class="hx-msg">${L.s.needBoth}</div>`; return; }
    // Retest 09/08/2026, point 3 : même aéroport accepté comme départ ET arrivée.
    if(dep.id===arr.id){ out.innerHTML=`<div class="hx-msg">${L.s.sameAirport}</div>`; return; }
    // Retest 09/08/2026, point 1 : une race tapée sans correspondance retombait silencieusement sur
    // "sans race" (donc sans seuils brachycéphales) alors que le champ affichait toujours le texte
    // saisi — texte et race sélectionnée sont désormais distingués, et une saisie non reconnue
    // bloque le calcul plutôt que de l'ignorer.
    const breedRaw=$("#hx-breed").value.trim();
    const bv=norm(breedRaw);
    const bkey=bv?Object.keys(L.breeds).find(k=>norm(k)===bv):null;
    if(breedRaw && !bkey){ out.innerHTML=`<div class="hx-msg">${L.s.breedInvalid}</div>`; return; }
    const month=parseInt($("#hx-month").value,10);
    const breed=bkey?L.breeds[bkey]:null;
    const brachy=!!(breed&&breed.br); const b=bands(brachy);

    const dt=tempAt(dep.lat,month), at=tempAt(arr.lat,month);
    const worst=Math.max(dt,at);
    const lv=level(worst,b);
    const vTitle={ok:L.s.ok,warn:L.s.risk,no:L.s.embargo}[lv];
    const vDesc={ok:L.s.okD,warn:L.s.riskD,no:L.s.embargoD}[lv];

    // 12-month calendar (worst airport per month)
    const cal=[]; for(let m=1;m<=12;m++){ const w=Math.max(tempAt(dep.lat,m),tempAt(arr.lat,m)); cal.push({m,t:w,lv:level(w,b)}); }
    const best=cal.filter(c=>c.lv==="ok").map(c=>L.months[c.m-1]);

    // Retest 09/08/2026, point 7 : les seuils utilisés par le calcul (déjà codés) n'étaient jamais
    // montrés à l'utilisateur.
    const threshLine=L.s.thresholdLine.replace("{risk}",b.risk).replace("{emb}",b.emb);

    // Retest 09/08/2026, point 6 : le lien vers le finder ne transmettait que la race. Il transmet
    // maintenant aussi le trajet et le mois — `from`/`dest` (identifiants aéroport internes, même
    // convention que `breed=breed_xxx`) + `month`, ajoutés dans le dièse via `mdcfPut` comme `breed`
    // (voir le commentaire détaillé dans FlightFinder.astro : les paramètres restent volontairement
    // après le dièse pour des raisons SEO, `to=<iso2>` désigne déjà un PAYS et n'est donc pas
    // réutilisable tel quel pour un aéroport précis).
    let finderHref=L.finderHref;
    if (typeof window.mdcfPut === "function") {
      finderHref = window.mdcfPut(finderHref, "from", dep.id);
      finderHref = window.mdcfPut(finderHref, "dest", arr.id);
      finderHref = window.mdcfPut(finderHref, "month", String(month));
      if (breed) finderHref = window.mdcfPut(finderHref, "breed", breed.id);
    } else if (breed) {
      finderHref = `${finderHref}?breed=${breed.id}`; // repli si mdcfPut n'est pas chargé
    }

    // Retest 09/08/2026, point 8 : pour une race brachycéphale, "Meilleurs mois" laissait entendre
    // qu'elle serait acceptée en soute ces mois-là.
    const bestBlock = best.length
      ? (brachy
          ? `<p class="hx-best">${esc(L.s.bestMonthsBrachy)} <span class="hx-best-list">${best.join(", ")}</span></p>`
          : `<p class="hx-best"><b>${esc(L.s.bestMonths)}:</b> ${best.join(", ")}</p>`)
      : "";

    out.innerHTML=`
      <div class="hx-card hx-verdict hx-b-${lv}">
        <div class="hx-vhead"><span class="hx-vemoji">${emoji[lv]}</span><span class="hx-vtitle">${vTitle}</span></div>
        <p class="hx-vdesc">${vDesc}</p>
        <p class="hx-avgnote">${L.s.avgClarify}</p>
        <div class="hx-legs">
          <div class="hx-leg"><span class="hx-legcap">${esc(dep.city)} (${dep.iata})</span>${badge(level(dt,b),dt+L.s.degC)}</div>
          <div class="hx-legarrow">→</div>
          <div class="hx-leg"><span class="hx-legcap">${esc(arr.city)} (${arr.iata})</span>${badge(level(at,b),at+L.s.degC)}</div>
        </div>
        <p class="hx-est">${L.s.estimate} · ${L.months[month-1]}</p>
        <p class="hx-thresh">${threshLine}<br>${L.s.thresholdCaveat}</p>
        ${brachy?`<p class="hx-brachy">⚠ ${L.s.brachy}</p>`:""}
      </div>
      <div class="hx-card">
        <div class="hx-calhd">${L.s.calendar}</div>
        <div class="hx-cal">${cal.map(c=>`<div class="hx-mon hx-m-${c.lv} ${c.m===month?"is-sel":""}"><span class="hx-mlab">${L.months[c.m-1]}</span><span class="hx-mt">${c.t}°</span></div>`).join("")}</div>
        <p class="hx-calnote">${L.s.calNote}</p>
        ${bestBlock}
      </div>
      <div class="hx-onward">
        <a class="hx-onav" href="${esc(finderHref)}" data-carry="breed air">✈ ${L.s.onwardAir}</a>
        <a class="hx-onav" href="${L.crateHref}" data-carry="breed air">📦 ${L.s.onwardCrate}</a>
      </div>
      <p class="hx-caveat">${L.s.caveat}</p>`;
    if(window.mdcfCtx&&breed) window.mdcfCtx.setBreed(breed.id);
    out.scrollIntoView({behavior:"smooth",block:"nearest"});
  });

  // Race pré-remplie depuis « ?breed= » UNIQUEMENT — pas depuis la mémoire de session seule.
  // Même règle que le Finder (commentaire détaillé dans FlightFinder.astro) : une race retenue
  // plus tôt dans la visite n'est pas une déclaration du visiteur, et le risque chaleur n'est
  // pas le même pour un carlin et pour un husky. Le bloc du deep-link ci-dessous lit déjà
  // « ?breed= » : ce n'est donc pas une perte de fonction, seulement le retrait d'une supposition.

  // Deep-link depuis le Finder ou une fiche : ?dep=CDG&arr=JFK&month=8&breed=<id>
  // On accepte le code IATA ou le nom de ville (findAirport gère les deux), et on lance
  // le calcul tout seul si le trajet est complet — sinon l'utilisateur devrait resaisir
  // ce qu'il vient déjà de renseigner ailleurs.
  (function(){
    try{
      const q=window.mdcfQuery();
      const setAirport=(param,sel)=>{
        const raw=q.get(param); if(!raw) return false;
        const a=findAirport(raw); if(!a) return false;
        $(sel).value=label(a); return true;
      };
      const okDep=setAirport("dep","#hx-dep");
      const okArr=setAirport("arr","#hx-arr");
      const m=parseInt(q.get("month")||"",10);
      if(m>=1&&m<=12) $("#hx-month").value=String(m);
      const b=q.get("breed");
      if(b&&L.breedById[b]) $("#hx-breed").value=L.breedById[b];
      // Calcul immédiat seulement si les deux extrémités sont connues.
      if(okDep&&okArr) $("#hx-form").dispatchEvent(new Event("submit",{cancelable:true,bubbles:true}));
    }catch(e){}
  })();
</script>

