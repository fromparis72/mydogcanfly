---
import { loadKB, t, breedName, cityName, searchCityName, inlineT } from "@mydogcanfly/knowledge";
import { hrefFor } from "../lib/routes";
import { countryData } from "../data/countries";

interface Props { locale?: string }
const { locale = "en" } = Astro.props;
const T = inlineT(locale);

// Options generated from the Knowledge Base at build time (values = entity IDs).
const kb = loadKB();
// Localized country name, so the autocomplete also matches a country (type "France" → Orly + CDG; "Pérou" → Lima).
const countryName = (id: string) => { const c = kb.countries.get(id); return c ? ((c.name as Record<string, string>)[locale] ?? c.name.en) : ""; };
const airports = [...kb.airports.values()].map((a) => ({ id: a.id, iata: a.iata, label: `${a.iata} · ${cityName(a, locale)} · ${countryName(a.country_id)}` })).sort((x, y) => x.label.localeCompare(y.label));
// Airport "popularity" (how many airlines reach it) — the busiest airport of a city becomes its representative.
const airportPop = new Map<string, number>();
for (const a of kb.airlines.values()) for (const id of ((a as { served_airport_ids?: string[] }).served_airport_ids ?? [])) airportPop.set(id, (airportPop.get(id) ?? 0) + 1);
// Cities with several airports → a "City (all airports)" option so a search spans them (Paris = CDG + ORY).
const allLabel = t(locale, "finder.all_airports");
const cityGroups = new Map<string, { city: string; country: string; ids: string[] }>();
for (const a of kb.airports.values()) {
  // searchCityName (pas cityName) : Newark rejoint le groupe "New York" ici, sans que sa
  // propre fiche (qui utilise cityName) n'affiche jamais "Ville : New York" (10/08/2026).
  const key = `${searchCityName(a, locale)}|${countryName(a.country_id)}`;
  const g = cityGroups.get(key) ?? { city: searchCityName(a, locale), country: countryName(a.country_id), ids: [] };
  g.ids.push(a.id); cityGroups.set(key, g);
}
const cities = [...cityGroups.values()].filter((g) => g.ids.length >= 2)
  .map((g) => ({ label: `${g.city} · ${g.country} · ${allLabel}`, ids: [...g.ids].sort((x, y) => (airportPop.get(y) ?? 0) - (airportPop.get(x) ?? 0)) }))
  .sort((x, y) => x.label.localeCompare(y.label));
const breeds = [...kb.breeds.values()].map((b) => ({ id: b.id, label: breedName(b, locale), weight: b.weight_kg, brachy: b.brachycephalic })).sort((x, y) => x.label.localeCompare(y.label));
// Map each airport of a multi-airport city → that city's "all airports" label. Used so the
// geolocation prefill (and the SSR default) land on the CITY rather than a single airport —
// otherwise the nearest airport can be a domestic-only one (Orly) and a long-haul search
// silently returns zero results with no hint that the departure airport was the problem.
const airCityLabel: Record<string, string> = {};
for (const c of cities) for (const id of c.ids) airCityLabel[id] = c.label;
const DEF = { origin: "airport_cdg", placement: "any" };
const defOriginLabel = airCityLabel[DEF.origin] ?? (airports.find((a) => a.id === DEF.origin)?.label ?? "");
// Deep-link ?to=<iso2> depuis une fiche pays : quel libellé écrire dans le champ « Arrivée ».
// On vise l'aéroport le mieux desservi du pays ; si sa ville en compte plusieurs, on prend
// l'entrée « ville · tous les aéroports » pour que la recherche les couvre tous.
const destByCountry: Record<string, string> = {};
{
  const best = new Map<string, { id: string; pop: number }>();
  for (const a of kb.airports.values()) {
    const iso = ((kb.countries.get(a.country_id) as { iso2?: string } | undefined)?.iso2 ?? "").toLowerCase();
    if (!iso) continue;
    const pop = airportPop.get(a.id) ?? 0;
    const cur = best.get(iso);
    if (!cur || pop > cur.pop) best.set(iso, { id: a.id, pop });
  }
  for (const [iso, { id }] of best) {
    const label = airCityLabel[id] ?? airports.find((a) => a.id === id)?.label;
    if (label) destByCountry[iso] = label;
  }
}

// Round-trip flag (client-side): per-country regime + whether it carries sourced exit formalities,
// + page slug; and airport → country iso2, so the client can flag "outbound + return" at result level.
// BUG corrigé (audit du 09/08/2026) : L3() ne gérait que fr/es, jamais pt — plusieurs libellés
// (domTitle, domFallback, domTerr, rt.*, heatTool*) s'affichaient en anglais pour les visiteurs
// portugais alors que des traductions correctes existent déjà dans translations/pt/inline.json
// (domTitle/domFallback/domTerr, confirmé). Remplacé par `T` (inlineT(locale), déjà utilisé plus
// bas dans ce même fichier) qui consulte cette table pour le pt et ne retombe sur l'anglais que
// pour les chaînes réellement pas encore traduites — jamais pour le portugais en bloc.
const RT_COUNTRY: Record<string, { regime: string; exit: boolean; name: string; slug: string }> = {};
for (const [, g] of Object.entries(countryData as Record<string, any>)) {
  if (!g.regime) continue;
  RT_COUNTRY[g.iso2.toLowerCase()] = { regime: g.regime, exit: !!g.exit, name: (g.name[locale] ?? g.name.en), slug: g.iso2.toLowerCase() };
}
// Domestic travel (no border): what actually applies instead of the country's import rules, localized.
const pickLT = (lt: Record<string, string> | undefined) => (lt ? (lt[locale] ?? lt.en) : "");
const DOM_COUNTRY: Record<string, { intro: string; points: string[]; territories: { name: string; note: string; url?: string }[] }> = {};
for (const [, g] of Object.entries(countryData as Record<string, any>)) {
  if (!g.domestic) continue;
  DOM_COUNTRY[g.iso2.toLowerCase()] = {
    intro: pickLT(g.domestic.intro),
    points: (g.domestic.points ?? []).map(pickLT),
    territories: (g.domestic.territories ?? []).map((t: any) => ({ name: pickLT(t.name), note: pickLT(t.note), url: t.url })),
  };
}
const airportCountry = Object.fromEntries([...kb.airports.values()].map((a) => [a.id, ((kb.countries.get(a.country_id) as { iso2?: string } | undefined)?.iso2 ?? "").toLowerCase()]));

/* Les 27 États membres, en ISO2. Sert UNIQUEMENT à décider si la question du passeport européen
   a un sens sur ce trajet (destination dans l'UE ET départ hors UE). L'appartenance à l'UE est un
   fait public, pas une donnée à sourcer — même liste que packages/knowledge/scripts/regles-ue-origine.mjs. */
const EU_ISO2 = ["at", "be", "bg", "hr", "cy", "cz", "dk", "ee", "fi", "fr", "de", "gr", "hu", "ie",
  "it", "lv", "lt", "lu", "mt", "nl", "pl", "pt", "ro", "sk", "si", "es", "se"];

// Localized labels handed to the island as JSON (report rendering runs client-side).
const labels = {
  locale,
  loading: t(locale, "finder.loading"),
  answerQ: t(locale, "answer.question"),
  compatibility: t(locale, "section.compatibility"),
  compatibilityNote: t(locale, "section.compatibility_note"),
  why: t(locale, "section.why"),
  before: t(locale, "report.before"),
  warnings: t(locale, "section.warnings"),
  risks: t(locale, "section.risks"),
  alternatives: t(locale, "section.alternatives"),
  sources: t(locale, "section.sources"),
  partners: t(locale, "section.partners"),
  airlines: t(locale, "section.airlines"),
  direct: t(locale, "air.direct"),
  connection: t(locale, "air.connection"),
  noPets: t(locale, "air.no_pets"),
  /* Plus de « Race non acceptée » posé par défaut : le moteur ne connaissait pas la cause du refus
     et l'interface en inventait une. Le badge est neutre, le motif réel vient du moteur (label). */
  notCompatible: t(locale, "air.not_compatible_short"),
  unverifiedShort: t(locale, "air.unverified_short"),
  unverifiedNote: t(locale, "air.unverified_note"),
  directCount: t(locale, "air.direct_count"),
  directCountPlural: t(locale, "air.direct_count_plural"),
  airlinesCount: t(locale, "air.airlines_count"),
  airlinesCountOne: t(locale, "air.airlines_count_one"),
  entryReq: t(locale, "air.entry_req"),
  countryBase: locale === "en" ? "/countries/" : `/${locale}/countries/`,
  cabinShort: t(locale, "placement.cabin"),
  holdShort: t(locale, "placement.hold"),
  cargoShort: t(locale, "placement.cargo"),
  natlOrigin: t(locale, "air.national_origin"),
  natlDest: t(locale, "air.national_dest"),
  fromAirport: t(locale, "air.from_airport"),
  toAirport: t(locale, "air.to_airport"),
  climateTitle: t(locale, "report.climate_title"),
  climateEst: t(locale, "report.climate_est"),
  climateEstNote: t(locale, "report.climate_est_note"),
  climateEmbargo: t(locale, "report.climate_embargo"),
  climateOk: t(locale, "report.climate_ok"),
  climateRiskTitle: t(locale, "report.climate_risk_title"),
  climateRisk: t(locale, "report.climate_risk"),
  heatEmbargo: t(locale, "air.heat_embargo"),
  heatEmbargoShort: t(locale, "air.heat_embargo_short"),
  confidence: T("confidence", "confiance", "confianza"),
  answer: {
    compatible: t(locale, "answer.compatible"),
    conditional: t(locale, "answer.conditional"),
    incompatible: t(locale, "answer.incompatible"),
  },
  // Breed lookup for the client: name (lowercased) → id, median weight (kg), snub-nosed flag.
  breeds: Object.fromEntries(breeds.map((b) => [b.label.toLowerCase(), { id: b.id, w: b.weight, br: b.brachy }])),
  breedById: Object.fromEntries(breeds.map((b) => [b.id, b.label])),   // for ?breed= deep-link prefill
  brachyNote: t(locale, "finder.brachy_note"),
  fillHint: t(locale, "finder.fill_hint"),
  errorTitle: t(locale, "finder.error_title"),
  errorBody: t(locale, "finder.error_body"),
  // Retest 09/08/2026 : un seul message générique ("choisis une destination et le poids") couvrait
  // 5 causes différentes (destination absente, aéroport invalide des deux côtés, départ = arrivée,
  // poids manquant/nul/invraisemblable) — l'utilisateur ne savait jamais LEQUEL des champs corriger.
  staleHint: t(locale, "finder.stale_hint"),
  originInvalid: t(locale, "finder.origin_invalid"),
  destInvalid: t(locale, "finder.dest_invalid"),
  sameEndpoint: t(locale, "finder.same_endpoint"),
  weightMissing: t(locale, "finder.weight_missing"),
  weightInvalid: t(locale, "finder.weight_invalid"),
  weightTooHigh: t(locale, "finder.weight_too_high"),
  matchTitle: t(locale, "finder.match_title"),
  altTitle: t(locale, "finder.alt_title"),
  noMatchMode: t(locale, "finder.no_match_mode"),
  airMap: Object.fromEntries(airports.map((a) => [a.label.toLowerCase(), a.id])),
  airRev: Object.fromEntries(airports.map((a) => [a.id, a.label])),
  airShort: Object.fromEntries(airports.map((a) => [a.id, a.iata])),
  cityMap: Object.fromEntries(cities.map((c) => [c.label.toLowerCase(), c.ids])),
  airCityLabel,   // airport id → "City · Country · all airports" label (multi-airport cities only)
  destByCountry,  // iso2 → label to type into "To", for ?to=<iso> deep-links from country pages
  // Round-trip "country formalities (outbound + return)" flag — data + localized copy.
  countryRT: RT_COUNTRY,
  countryDom: DOM_COUNTRY,
  domTitle: T("Domestic flight — no import formalities", "Vol intérieur — aucune formalité d'import", "Vuelo nacional — sin trámites de importación"),
  domFallback: T(
    "No border is crossed, so no import formality applies. Check your airline's own conditions (health certificate, age, crate).",
    "Aucune frontière n'est franchie, donc aucune formalité d'import ne s'applique. Vérifie les conditions propres à ta compagnie (certificat de santé, âge, caisse).",
    "No se cruza ninguna frontera, así que no se aplica ningún trámite de importación. Consulta las condiciones de tu aerolínea (certificado de salud, edad, jaula)."),
  domTerr: T("Watch out — special territories", "Attention — territoires à régime particulier", "Atención — territorios con régimen especial"),
  airportCountry,
  euIso: EU_ISO2, // pour n'afficher la question du passeport que sur un retour vers l'UE
  rt: {
    titleCrit: T("Country formalities — plan before you leave", "Formalités pays — à anticiper avant de partir", "Trámites del país — anticípalos antes de salir"),
    titleWarn: T("Country formalities — outbound AND return", "Formalités pays — aller ET retour", "Trámites del país — ida Y vuelta"),
    titleInfo: T("Country formalities — outbound and return", "Formalités pays — aller et retour", "Trámites del país — ida y vuelta"),
    bodyTiter: T("The return needs a long procedure (rabies titer) started BEFORE you leave — not on the way back.", "Le retour impose une démarche longue (titrage antirabique) à lancer AVANT ton départ, pas au moment de rentrer.", "La vuelta exige un trámite largo (titulación antirrábica) que debes iniciar ANTES de salir, no al regresar."),
    bodyIsland: T("Entry requires an import permit and quarantine — plan several months ahead.", "L'entrée impose un permis d'importation et une quarantaine — compte plusieurs mois d'anticipation.", "La entrada exige un permiso de importación y cuarentena — cuenta con varios meses de antelación."),
    bodyWarn: T("Leaving the destination needs official steps arranged on site; the return isn't automatic.", "Sortir du pays de destination demande des démarches officielles à préparer sur place ; le retour n'est pas automatique.", "Salir del país de destino exige trámites oficiales que se preparan in situ; la vuelta no es automática."),
    bodyInfo: T("Formalities apply on entry and on return — plan a vet certificate each way.", "Des formalités s'appliquent à l'entrée et au retour — prévois un certificat vétérinaire dans chaque sens.", "Se aplican trámites a la entrada y a la vuelta — prevé un certificado veterinario en cada sentido."),
    cta: T("See the 4 steps", "Voir les 4 étapes", "Ver los 4 pasos"),
  },
  // Per-airline links for the result cards: our airline page + the official website (booking).
  airlineHref: Object.fromEntries([...kb.airlines.values()].map((a) => [a.id, hrefFor(a.id, locale)])),
  airlineSite: Object.fromEntries([...kb.airlines.values()].map((a) => [a.id, (a as { website?: string }).website ?? ""])),
  airlineInfo: t(locale, "air.airline_info"),
  bookLabel: t(locale, "air.book_official"),
  nextTitle: t(locale, "air.next_title"),
  step: t(locale, "air.step"),
  actEntry: t(locale, "air.act_entry"),
  actAirline: t(locale, "air.act_airline"),
  actBook: t(locale, "air.act_book"),
  crateBase: locale === "en" ? "/tools/crate/" : `/${locale}/tools/crate/`,
  heatBase: locale === "en" ? "/tools/heat/" : `/${locale}/tools/heat/`,
  heatToolName: T("Heat risk calculator", "Calculateur de risque chaleur", "Calculadora de riesgo de calor"),
  heatToolWhy: T(
    "Check the expected temperature at both ends for your travel date — hold and cargo are suspended above the carriers' heat threshold.",
    "Vérifie la température attendue au départ et à l'arrivée pour ta date — soute et fret sont suspendus au-delà du seuil de chaleur des compagnies.",
    "Comprueba la temperatura prevista en origen y destino para tu fecha — bodega y carga se suspenden por encima del umbral de calor de las aerolíneas."),
  // BUG corrigé (audit du 09/08/2026) : ternaire fr/en uniquement, pas de branche es/pt du tout —
  // pire que L3 ci-dessus. Non lu ailleurs dans ce fichier aujourd'hui (code mort), corrigé par
  // cohérence avec le reste des libellés plutôt que d'attendre qu'un futur usage l'expose.
  actCrate: T("Verify travel crate size", "Vérifier la taille de la cage de transport", "Verificar el tamaño de la jaula de transporte"),
  crateTgt: T("Crate calculator", "Calculateur de cage", "Calculadora de jaula"),
  ficheBase: locale === "en" ? "/tools/fiche/" : `/${locale}/tools/fiche/`,
  ficheCta: T("See detailed requirements", "Voir modalités détaillées", "Ver trámites detallados"),
};
---
<section id="flight-finder" class="finder" aria-label="Flight Finder">
  <form id="mdcf-finder" class="finder__form">
    <div class="finder__row">
      <div class="finder__field">
        <label for="f-origin">{t(locale, "finder.from")}</label>
        <input id="f-origin" name="origin" data-ac="mdcf-airports" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" value={defOriginLabel} placeholder={t(locale, "finder.choose_airport")} />
      </div>
      <div class="finder__field">
        <label for="f-dest">{t(locale, "finder.to")}</label>
        <input id="f-dest" name="destination" data-ac="mdcf-airports" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" placeholder={t(locale, "finder.choose_dest")} />
      </div>
      <datalist id="mdcf-airports">{cities.map((c) => <option value={c.label}></option>)}{airports.map((a) => <option value={a.label}></option>)}</datalist>
      <div class="finder__field">
        <label for="f-breed">{t(locale, "finder.breed")}</label>
        <input id="f-breed" name="breed" data-ac="mdcf-breeds" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" placeholder={t(locale, "finder.breed_ph")} />
        <datalist id="mdcf-breeds">{breeds.map((b) => <option value={b.label}></option>)}</datalist>
      </div>
      <div class="finder__field finder__field--sm">
        <label for="f-weight">{t(locale, "finder.weight")}</label>
        <div class="finder__weight">
          <input id="f-weight" name="weight" type="number" min="0" step="0.1" placeholder="—" />
          <div class="finder__units" role="group" aria-label="unit">
            <button type="button" id="u-kg" class="finder__unit is-on" data-u="kg">kg</button>
            <button type="button" id="u-lb" class="finder__unit" data-u="lb">lb</button>
          </div>
        </div>
      </div>
    </div>
    {/* Retour vers l'UE. Volontairement MASQUÉ par défaut et affiché par le script uniquement
        quand il sert — arrivée dans l'UE ET départ hors UE. Ailleurs (Madrid → Paris, Paris → New
        York) il n'y a rien à demander, et une question de plus sur un formulaire est une réponse de
        moins.

        DEUX OPTIONS, ET LE TROISIÈME ÉTAT EST L'ABSENCE DE CLIC. La question portait autrefois sur
        le document et au passé (« un passeport dont le vaccin était valide avant de quitter l'UE »),
        ce qui n'avait aucun sens pour l'Américain qui s'installe en France : il n'a jamais quitté
        l'UE, et il cochait « je ne sais pas » faute de comprendre une question dont sa situation
        donnait pourtant la réponse. On interroge donc la situation, au présent — « ton chien vit-il
        habituellement dans l'UE ? » —, ce que tout propriétaire sait sans rien ouvrir. « Je ne sais
        pas » n'a plus de répondant et disparaît : tant que rien n'est coché, les deux parcours
        restent affichés, ce qui est l'état naturel avant le clic. Le comportement prudent est
        conservé sans avoir à le nommer. Bonus : « vit habituellement » attrape la nuance que la
        Commission pose et que l'ancienne formulation ratait — la dispense vaut pour un séjour, pas
        pour un propriétaire qui réside désormais hors UE. */}
    <fieldset id="f-eupass-row" class="finder__row finder__eupass" hidden>
      <legend class="finder__eupass-q">{t(locale, "finder.eu_passport")}</legend>
      <div class="finder__eupass-opts" role="radiogroup">
        <label class="finder__radio"><input type="radio" name="eu_passport" value="yes" /><span>{t(locale, "finder.eu_passport_yes")}</span></label>
        <label class="finder__radio"><input type="radio" name="eu_passport" value="no" /><span>{t(locale, "finder.eu_passport_no")}</span></label>
      </div>
      <p class="finder__eupass-hint">{t(locale, "finder.eu_passport_hint")}</p>
    </fieldset>
    <div class="finder__row finder__row--controls">
      <div class="finder__field finder__field--sm">
        <label for="f-placement">{t(locale, "finder.placement")}</label>
        <select id="f-placement" name="placement">
          <option value="any" selected={DEF.placement === "any"}>{t(locale, "placement.any")}</option>
          <option value="cabin">{t(locale, "placement.cabin")}</option>
          <option value="hold">{t(locale, "placement.hold")}</option>
          <option value="cargo">{t(locale, "placement.cargo")}</option>
        </select>
      </div>
      <div class="finder__field finder__field--sm">
        <label for="f-date">{t(locale, "finder.date")}</label>
        <input id="f-date" name="date" type="date" title={t(locale, "finder.date_hint")} />
      </div>
      <div class="finder__spacer">
        <p id="f-muzzle" class="finder__muzzle" hidden></p>
      </div>
      <button class="mdcf-btn finder__submit" type="submit">{t(locale, "finder.submit")}</button>
    </div>
  </form>
  <script type="application/json" id="mdcf-finder-labels" set:html={JSON.stringify(labels)} is:inline />
  <div id="mdcf-finder-result" class="finder__result" aria-live="polite" hidden></div>
</section>

<script>
  import type { DecisionReport, ReportItem, FinderRequest } from "@mydogcanfly/engine";
  import { API_BASE } from "../lib/env";
  import { attachCombobox, type ComboItem } from "../lib/combobox";

  const form = document.getElementById("mdcf-finder") as HTMLFormElement | null;
  const out = document.getElementById("mdcf-finder-result") as HTMLDivElement | null;
  const L = JSON.parse(document.getElementById("mdcf-finder-labels")?.textContent ?? "{}");

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] ?? c));
  const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ""); } catch { return u; } };
  const flag = (iso2: string) => iso2.length === 2
    ? String.fromCodePoint(...[...iso2.toUpperCase()].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65))
    : "";
  const block = (title: string, items: ReportItem[]) =>
    items.length ? `<h4>${esc(title)}</h4><ul>${items.map((i) => `<li>${esc(i.text)}</li>`).join("")}</ul>` : "";

  /* Retest 09/08/2026, point 1 : après un calcul, modifier n'importe quel critère (départ, arrivée,
   * race, poids, unité, mode, date) laissait l'ANCIEN résultat affiché sans avertissement — par
   * exemple, passer le filtre de "Cabine" à "Fret" APRÈS un calcul gardait affiché "Aucune
   * compagnie ne prend ton chien en cabine", un message qui ne correspond plus au filtre à l'écran.
   * On n'auto-relance pas la recherche (un appel réseau silencieux, déclenché sans clic, s'écarterait
   * du reste de l'outil) : on marque clairement le résultat comme périmé et on laisse le visiteur
   * relancer lui-même. Le bandeau disparaît naturellement au prochain submit, qui remplace tout
   * `out.innerHTML` (chargement, puis nouveau rapport) — aucun état à nettoyer à la main.
   */
  function markStale() {
    if (!out || out.hidden) return;
    if (!out.querySelector(".report")) return; // pas de résultat réel affiché (hint/erreur/chargement) : rien à faire
    if (out.querySelector(".finder__stale")) return; // déjà marqué pour ce résultat
    const banner = document.createElement("p");
    banner.className = "finder__stale";
    banner.textContent = L.staleHint ?? "Criteria changed — rerun your search.";
    out.prepend(banner);
  }

  // Makes the (default) seasonal temperature filter visible: shows the estimated destination heat and,
  // when it's above the embargo threshold, warns that some airlines suspend hold/cargo.
  function climateBanner(r: DecisionReport): string {
    const c = r.climate;
    if (!c) return "";
    // Confirmed embargo: estimated temperature above the threshold → strong orange, glowing.
    if (c.embargo) {
      const est = (L.climateEst ?? "").replace("{temp}", String(c.temperature_c))
        + (c.estimated ? ` ${L.climateEstNote ?? ""}` : "");
      return `<div class="report__climate is-embargo">
        <span class="rc-ic" aria-hidden="true">🌡️</span>
        <div class="rc-body"><b>${esc(L.climateTitle ?? "")}</b> <span>${esc(est)} ${esc(L.climateEmbargo ?? "")}</span></div>
      </div>`;
    }
    // Possible but unconfirmed: temperate region in peak-summer months (climate-change heat waves) → softer amber.
    if (c.risk) {
      return `<div class="report__climate is-risk">
        <span class="rc-ic" aria-hidden="true">🌡️</span>
        <div class="rc-body"><b>${esc(L.climateRiskTitle ?? "")}</b> <span>${esc(L.climateRisk ?? "")}</span></div>
      </div>`;
    }
    // Otherwise (out of the hot season) the banner is hidden entirely.
    return "";
  }

  // Round-trip flag: one route-level banner warning that country formalities apply BOTH ways,
  // graduated by the origin/destination regimes (data-driven, no engine call). Links to the 4-step page.
  // BUG corrigé (audit du 09/08/2026) : cette fonction était entièrement écrite (logique + CSS
  // .rtflag) mais jamais appelée dans render() — le bandeau ne s'affichait pour PERSONNE, sur
  // AUCUN trajet, y compris un retour UE avec titrage requis (le cas "crit" le plus important).
  // Câblée maintenant juste après climateBanner(), l'autre bandeau de niveau trajet.
  function roundTripFlag(): string {
    const dest = (L.countryRT ?? {})[lastDestIso];
    if (!dest) return "";
    const orig = (L.countryRT ?? {})[lastOriginIso];
    const S = L.rt ?? {};
    let sev = "info", title = S.titleInfo, body = S.bodyInfo;
    if (orig && orig.regime === "eu" && dest.regime === "non_listed") { sev = "crit"; title = S.titleCrit; body = S.bodyTiter; }
    else if (dest.regime === "island_strict") { sev = "crit"; title = S.titleCrit; body = S.bodyIsland; }
    else if (dest.exit) { sev = "warn"; title = S.titleWarn; body = S.bodyWarn; }
    const link = (L.countryBase ?? "/countries/") + dest.slug + "/";
    return `<div class="rtflag rtflag--${sev}">
      <div class="rtflag__t">⚠ ${esc(title)}</div>
      <div class="rtflag__b">${esc(body)}</div>
      <a class="rtflag__cta" href="${esc(link)}">${esc(S.cta)} · ${esc(dest.name)} →</a>
    </div>`;
  }

  function render(r: DecisionReport): string {
    const stars = "★".repeat(r.confidence) + "☆".repeat(Math.max(0, 5 - r.confidence));
    const answer = (L.answer && L.answer[r.verdict]) || r.verdict;
    const why = (r.positives && r.positives.length)
      ? `<div class="report__sec"><h4>${esc(L.why)}</h4><ul class="checks">${r.positives.map((i) => `<li class="${i.tone === "negative" ? "is-neg" : ""}">${esc(i.text)}</li>`).join("")}</ul></div>`
      : "";
    // "X vols directs" ne doit compter que des options RÉELLEMENT praticables avec ce chien
    // (REPRISE.md APRÈS §3) — avant, `.direct` seul comptait n'importe quel vol passager direct sur
    // la route, y compris des compagnies qui n'acceptent l'animal sur aucun mode (cas type : Paris→
    // Londres affichait "5 vols directs probables" en comptant des vols que l'animal ne peut pas
    // prendre, faute d'agrément britannique pour la soute — voir rule_*_gb_not_approved).
    const usableDirect = (r.airlines ?? []).filter((a) => a.direct && (a.cabin || a.hold || a.cargo));
    /* Garde défensive (audit du 09/08/2026, tâche 24) : r.score vient du Worker et alimente à la
     * fois un `width:${...}%` CSS et un texte affiché — un score non numérique (NaN), négatif ou
     * au-delà de 100 (bug côté moteur, réponse tronquée, future évolution du contrat) produirait
     * une jauge cassée (largeur négative ou hors cadre) ou "NaN%" affiché tel quel. Le moteur est
     * déjà censé renvoyer 0..100 (cf. computeScore() dans explain.ts) : ceci est un filet, pas une
     * correction de logique métier — on ne renvoie jamais un score fantaisiste pour autant.
     */
    const score = Number.isFinite(r.score) ? Math.max(0, Math.min(100, Math.round(r.score))) : 0;
    // Retest 09/08/2026, point 6 : extrait de l'ancien `.map(a => ...)` inline pour pouvoir
    // l'appeler sur deux sous-listes (correspond au mode / alternatives) plutôt que sur une seule —
    // le contenu de chaque carte est inchangé, seul l'endroit où elle est rendue change.
    const airlineCard = (a: any): string => `
              <li class="acard ${(() => {
                  // Bug corrigé (audit du 09/08/2026, tâche 19) : le style de la carte (bordure + opacité)
                  // ignorait le cas "bloqué uniquement par la canicule" (a.heat_embargo) et retombait sur
                  // "acard--no" — le style rouge/terne d'une compagnie qui ne prend jamais ce chien. Le
                  // badge du haut affichait pourtant "✈ Direct" + "🌡️ Canicule" (cf. structuralNoPets
                  // ci-dessous), donnant une carte à l'apparence contradictoire : rouge et éteinte en
                  // dehors, "vol direct conditionnel" dedans. Depuis le correctif de la tâche 8,
                  // a.heat_embargo n'est vrai QUE quand c'est la seule raison de refus (reasons.length
                  // === 0 dans explain.ts) : ce n'est jamais un blocage permanent, donc la carte mérite
                  // un style distinct — ni "ça marche" (vert/ambre des placements), ni "ça ne marche
                  // jamais" (acard--no), mais "ça marche hors saison".
                  if (a.cabin) return "acard--cabin";
                  if (a.hold) return "acard--hold";
                  if (a.cargo) return "acard--cargo";
                  if (a.heat_embargo) return "acard--heat";
                  return "acard--no";
                })()}${a.itinerary_confidence === "connection_unverified" ? " acard--unverified" : ""}">
                <div class="acard__main">
                  ${(() => {
                    const structuralNoPets = !a.cabin && !a.hold && !a.cargo && !a.heat_embargo;
                    const caps = [];
                    if (structuralNoPets) {
                      // Une compagnie qui ne prend aucun animal ("Animaux refusés") reste distincte d'une
                      // compagnie qui en prend mais écarte CE chien. Pour la seconde, le badge ne nomme plus
                      // de cause — le motif exact (poids, race, soute non proposée…) est dans le libellé.
                      if (a.carries_pets) caps.push({ cls: "nomatch", ic: "🐾", txt: L.notCompatible });
                      else caps.push({ cls: "nopets", ic: "🚫", txt: L.noPets });
                    } else {
                      const viaCode = a.connect_airport_id ? (AIRSHORT[a.connect_airport_id] || "") : "";
                      caps.push(a.direct
                        ? { cls: "direct", ic: "✈", txt: L.direct }
                        : { cls: "conn", ic: "✈", txt: L.connection + (viaCode ? ` · via ${viaCode}` : "") });
                      // Correspondance seulement plausible : on le dit dès le badge, pas en petits caractères.
                      if (a.itinerary_confidence === "connection_unverified") caps.push({ cls: "unver", ic: "?", txt: L.unverifiedShort });
                      if (a.heat_embargo) caps.push({ cls: "heat", ic: "🌡️", txt: L.heatEmbargoShort });
                    }
                    return `<div class="acard__statusrow">${caps.map((s) => `<span class="acard__status acard__status--${s.cls}">${s.ic} ${esc(s.txt)}</span>`).join("")}</div>`;
                  })()}
                  <div class="acard__top"><b>${esc(a.name)}</b>${a.carrier_of_origin ? `<span class="acard__natl">★ ${esc(L.natlOrigin)}</span>` : a.carrier_of_destination ? `<span class="acard__natl">★ ${esc(L.natlDest)}</span>` : ""}</div>
                  <div class="acard__badges"><span class="ab ${a.cabin ? "ab--ok" : "ab--no"}">${esc(L.cabinShort)}</span><span class="ab ${a.hold ? "ab--ok" : "ab--no"}">${esc(L.holdShort)}</span><span class="ab ${a.cargo ? "ab--ok" : "ab--no"}">${esc(L.cargoShort)}</span></div>
                  <div class="acard__label">${esc(a.label)}${a.source_url ? ` · <a href="${esc(a.source_url)}" rel="nofollow noopener" target="_blank">${esc(host(a.source_url))}</a>` : ""}</div>
                  ${(a.origin_airport_id || a.destination_airport_id) ? `<div class="acard__via">✈ ${[a.origin_airport_id ? `${esc(L.fromAirport)} ${esc(AIRSHORT[a.origin_airport_id] || a.origin_airport_id)}` : "", a.destination_airport_id ? `${esc(L.toAirport)} ${esc(AIRSHORT[a.destination_airport_id] || a.destination_airport_id)}` : ""].filter(Boolean).join(" · ")}</div>` : ""}
                  ${a.itinerary_confidence === "connection_unverified"
                    ? `<div class="acard__unver">? ${esc(L.unverifiedNote)}</div>` : ""}
                  ${a.heat_embargo ? `<div class="acard__embargo">🌡️ ${esc(L.heatEmbargo)}</div>` : ""}
                  ${a.fee ? `<div class="acard__fee">${esc(a.fee)}</div>` : ""}
                </div>
                <div class="acard__mid">${(() => {
                  // One decisive action per airline: open the bespoke "Bible" sheet, carrying the whole
                  // context (route, airline snapshot) in the URL so it's a shareable permalink.
                  /* Option B (fiche.astro, 10/08/2026) a arrêté de LIRE ces champs depuis l'URL —
                   * mais jusqu'ici le Finder continuait de les ÉCRIRE, ce qui ne les exposait plus
                   * dans le rendu mais les laissait circuler dans des liens partagés (et dans le
                   * corps du "partager par email" de la fiche, qui reprend l'URL courante) sans
                   * plus jamais servir à rien. Corrigé suite à la contre-revue Codex du 10/08/2026 :
                   * seuls `from`/`to`/`air`/`breed`/`bid`/`w`/`eu_passport` sont encore nécessaires
                   * (contexte de navigation et chronologie pays, tous canoniques côté fiche) — le
                   * nom de compagnie, le score, cabine/soute/fret, le vol direct, le tarif,
                   * l'embargo et les liens sortants compagnie ne sont plus écrits du tout. */
                  const p = new URLSearchParams();
                  p.set("from", lastOriginIso); p.set("to", lastDestIso);
                  p.set("air", a.airline_id);
                  /* Correction P0 (contre-revue Codex, tour 6) : `lastBreedLabel`/`lastWeightKg`,
                   * figés au lancement de CETTE recherche (comme lastBreedId/lastOriginIso/
                   * lastEuPassport ci-dessus) — jamais relus en direct dans le formulaire, qui a pu
                   * changer pendant que la requête était en vol. `lastWeightKg` est toujours en
                   * kilogrammes, y compris quand le Finder affichait des livres au moment de la
                   * recherche (voir le commentaire de sa déclaration). */
                  if (lastBreedLabel) p.set("breed", lastBreedLabel);
                  if (lastBreedId) p.set("bid", lastBreedId);
                  if (lastWeightKg !== undefined) p.set("w", String(lastWeightKg));
                  /* La réponse sur le passeport européen suit le voyageur jusqu'aux modalités
                     détaillées : sans elle, la fiche retombait sur son propre filtrage d'origine
                     et réaffirmait le certificat sanitaire à qui venait de dire qu'il avait un
                     passeport. Le paramètre est OMIS quand la question n'a pas été posée ou reste
                     sans réponse — un "" transmis serait un « non » déguisé, et la fiche montre
                     les deux parcours quand elle ne sait pas. */
                  if (lastEuPassport) p.set("eu_passport", lastEuPassport);
                  /* La fiche imprimable est en noindex et ce lien naît après une recherche,
                     mais Google exécute le JavaScript : dièse ici aussi, par cohérence. */
                  const href = (L.ficheBase || "/tools/fiche/") + "#" + p.toString();
                  return `<a class="mdcf-btn acard__fiche" href="${esc(href)}"><span>${esc(L.ficheCta)}</span><span class="acard__fiche-go">→</span></a>`;
                })()}</div>
              </li>`;
    return `
      <div class="report report--${r.verdict}">
        <p class="report__q">${esc(L.answerQ)}</p>
        <p class="report__answer">${esc(answer)}</p>
        <div class="report__score">
          <div class="report__score-row">
            <div class="report__gauge"><span style="width:${score}%"></span></div>
            <div class="report__score-meta"><strong>${score}%</strong> ${esc(L.compatibility)}</div>
          </div>
          <div class="report__score-note">${esc(L.compatibilityNote)}</div>
        </div>
        ${climateBanner(r)}
        ${roundTripFlag()}
        ${why}
        ${r.domestic ? (() => {
          // Domestic: the country's import rules don't apply. Show what actually does, plus any
          // same-country special territory (Guyane, Hawaii…). Honest fallback when we have no sourced data.
          const d = (L.countryDom ?? {})[lastDestIso];
          const body = d
            ? `<p class="dom__intro">${esc(d.intro)}</p><ul>${d.points.map((p) => `<li>${esc(p)}</li>`).join("")}</ul>`
              + (d.territories && d.territories.length
                ? `<div class="dom__terr"><b>${esc(L.domTerr)}</b><ul>${d.territories.map((t) => `<li><b>${esc(t.name)}</b> — ${esc(t.note)}${t.url ? ` <a href="${esc(t.url)}" rel="nofollow noopener" target="_blank">↗</a>` : ""}</li>`).join("")}</ul></div>`
                : "")
            : `<p class="dom__intro">${esc(L.domFallback)}</p>`;
          return `<div class="report__sec dom"><h4>${esc(L.domTitle)}</h4>${body}</div>`;
        })() : block(L.before, r.conditions)}
        ${r.airlines && r.airlines.length
          ? (() => {
              const header = `<h4>${esc(L.airlines)}</h4>
              <div class="acap">✈ <b>${usableDirect.length}</b> ${esc(usableDirect.length === 1 ? L.directCount : L.directCountPlural)} · <b>${r.airlines.length}</b> ${esc(r.airlines.length === 1 ? L.airlinesCountOne : L.airlinesCount)}</div>`;
              // Retest 09/08/2026, point 6 : "any" reste une liste unique (rien à trier — le champ
              // demande "peu importe le mode"). Pour cabine/soute/fret, on scinde en deux groupes
              // titrés au lieu de faire disparaître les compagnies incompatibles avec CE mode :
              // l'info "alternative en soute/fret" a une vraie valeur pour le visiteur.
              if (lastPlacement === "any") {
                return `<div class="report__sec">${header}<ul class="acards">${r.airlines.map(airlineCard).join("")}</ul></div>`;
              }
              const key = lastPlacement as "cabin" | "hold" | "cargo";
              const matched = r.airlines.filter((a: any) => a[key]);
              const alt = r.airlines.filter((a: any) => !a[key]);
              const matchBlock = matched.length
                ? `<h5 class="acards__sub">${esc(L.matchTitle)}</h5><ul class="acards">${matched.map(airlineCard).join("")}</ul>`
                : `<p class="finder__hint">${esc(L.noMatchMode)}</p>`;
              const altBlock = alt.length
                ? `<h5 class="acards__sub">${esc(L.altTitle)}</h5><ul class="acards">${alt.map(airlineCard).join("")}</ul>`
                : "";
              return `<div class="report__sec">${header}${matchBlock}${altBlock}</div>`;
            })()
          : ""}
        ${block(L.warnings, r.warnings)}
        ${block(L.risks, r.risks)}
        ${block(L.alternatives, r.alternatives)}
        ${(() => {
          // Only the crate recommendation is surfaced, and it points to our own crate calculator
          // (internal tool, breed carried over) rather than any outbound partner link.
          const crate = (r.partners ?? []).find((p) => (p as { vertical?: string }).vertical === "equipment");
          if (!crate) return "";
          const crateLink = L.crateBase + (lastBreedId ? "#breed=" + lastBreedId : "");
          // Outil chaleur : service, pas modalité — il vit donc ici, en bas, et non dans le verdict.
          // On lui passe le trajet et la date déjà saisis pour qu'il s'ouvre en contexte.
          const iataOf = (id: string) => (L.airShort ?? {})[id] ?? "";
          const dateVal = (byId("f-date") as HTMLInputElement | null)?.value ?? "";
          const month = dateVal ? String(Number(dateVal.slice(5, 7))) : "";
          const hq = [
            iataOf(lastOriginId) ? "dep=" + iataOf(lastOriginId) : "",
            iataOf(lastDestId) ? "arr=" + iataOf(lastDestId) : "",
            month ? "month=" + month : "",
            lastBreedId ? "breed=" + lastBreedId : "",
          ].filter(Boolean).join("&");
          /* Dièse, comme partout ailleurs : ces liens naissent dans le rapport du Finder, donc
             après un clic, mais ils sont partageables — et une URL partagée finit indexée. */
          const heatLink = L.heatBase + (hq ? "#" + hq : "");
          const heatLi = `<li><a href="${esc(heatLink)}">${esc(L.heatToolName)}</a> — ${esc(L.heatToolWhy)}</li>`;
          return `<div class="report__sec"><h4>${esc(L.partners)}</h4><ul class="report__partners"><li><a href="${esc(crateLink)}">${esc(crate.name)}</a> — ${esc(crate.reason)}</li>${heatLi}</ul></div>`;
        })()}
        <details class="report__sources"><summary>${esc(L.sources)} · ${esc(L.confidence)} ${stars}</summary>
          <ul>${r.sources.map((s) => `<li><a href="${esc(s.url)}" rel="nofollow noopener" target="_blank">${esc(s.url)}</a></li>`).join("")}</ul>
        </details>
      </div>`;
  }

  // --- Breed autocomplete, median-weight autofill, kg/lb switch, snub-nosed note ---
  const byId = (id: string) => document.getElementById(id);
  const gv = (id: string) => (byId(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? "";
  const breedEl = byId("f-breed") as HTMLInputElement | null;
  const weightEl = byId("f-weight") as HTMLInputElement | null;
  const muzzleEl = byId("f-muzzle") as HTMLElement | null;
  const uKg = byId("u-kg"); const uLb = byId("u-lb");
  // Accent-insensitive key: strip diacritics so "grece" matches "Grèce", "perou" → "Pérou", etc.
  const norm = (s: string) => (s ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
  const reKey = <V,>(m: Record<string, V>): Record<string, V> => {
    const out: Record<string, V> = {};
    for (const k in m) out[norm(k)] = m[k];
    return out;
  };
  const BREEDS: Record<string, { id: string; w: number; br: boolean }> = reKey(L.breeds ?? {});
  const LB = 2.20462;
  let unit: "kg" | "lb" = "kg";

  const resolveBreed = () => BREEDS[norm(breedEl?.value ?? "")];
  function refreshMuzzle() {
    const b = resolveBreed();
    if (muzzleEl) { muzzleEl.hidden = !b?.br; if (b?.br) muzzleEl.textContent = L.brachyNote ?? ""; }
  }
  function fillWeight() {
    const b = resolveBreed();
    if (b && weightEl) weightEl.value = String(unit === "lb" ? +(b.w * LB).toFixed(1) : b.w);
    refreshMuzzle();
  }
  function setUnit(u: "kg" | "lb") {
    if (u === unit) return;
    const v = parseFloat(weightEl?.value ?? "") || 0;
    if (weightEl) weightEl.value = String(u === "lb" ? +(v * LB).toFixed(1) : +(v / LB).toFixed(1));
    unit = u;
    uKg?.classList.toggle("is-on", u === "kg"); uLb?.classList.toggle("is-on", u === "lb");
  }
  breedEl?.addEventListener("change", fillWeight);
  breedEl?.addEventListener("input", refreshMuzzle);
  uKg?.addEventListener("click", () => setUnit("kg"));
  uLb?.addEventListener("click", () => setUnit("lb"));
  refreshMuzzle();
  // Point 1 : chaque champ qui influence le calcul marque le résultat affiché comme périmé.
  breedEl?.addEventListener("change", markStale);
  breedEl?.addEventListener("input", markStale);
  weightEl?.addEventListener("input", markStale);
  uKg?.addEventListener("click", markStale);
  uLb?.addEventListener("click", markStale);

  // --- Custom autocomplete: replaces the native <datalist>, whose filtering is accent-SENSITIVE
  // (typing "grece" would drop "Grèce" and surface "Zagreb"). This one matches on the accent-folded
  // form, so "gre"/"grece" lists every Greek airport, "perou" finds Lima, etc.
  // Retest 09/08/2026, point 9 : implémentation ARIA propre centralisée dans lib/combobox.ts,
  // partagée par les 4 outils (Finder, Destinations, Cage, Chaleur) — voir ce fichier pour le détail
  // du motif combobox/listbox/option + aria-controls/aria-activedescendant. ---
  const datalistItems = (listId: string) => {
    const dl = document.getElementById(listId);
    const opts = dl ? [...dl.querySelectorAll("option")].map((o) => o.getAttribute("value") ?? "") : [];
    return (q: string): ComboItem[] => {
      const nq = norm(q);
      return (nq ? opts.filter((v) => norm(v).includes(nq)) : opts).slice(0, 60).map((v) => ({ display: v, value: v }));
    };
  };
  document.querySelectorAll<HTMLInputElement>("[data-ac]").forEach((el) => {
    const listId = el.getAttribute("data-ac");
    if (!listId) return;
    attachCombobox({ input: el, hostSelector: ".finder__field", getItems: datalistItems(listId) });
  });

  const ctx = (window as { mdcfCtx?: { breed?: string; setBreed?: (v: string) => void } }).mdcfCtx;
  /**
   * La race n'est pré-remplie QUE depuis un « ?breed= » présent dans l'URL — jamais depuis la
   * mémoire de session seule.
   *
   * Ce bloc lisait `ctx.breed`, qui mélange deux choses très différentes : un paramètre
   * d'URL (le visiteur vient de cliquer un lien à propos d'une race précise : intention
   * explicite) et une valeur mémorisée plus tôt dans la session (intention supposée). Le
   * 30/07/2026, deux surprises en découlaient : lire la fiche du Jack Russell suffisait à
   * voir « Jack Russell, 7 kg » pré-rempli au retour sur l'accueil, et un « Golden Retriever,
   * 32 kg » traînant en mémoire s'affichait sur une page d'entrée sans que rien ne l'explique.
   *
   * Le risque n'est pas cosmétique : un visiteur qui ne remarque pas la race pré-remplie
   * repart avec une réponse calculée pour un autre chien que le sien. La mémoire continue de
   * servir les outils atteints par un lien porteur de contexte (`data-carry`), qui écrit le
   * paramètre dans l'URL — donc l'intention reste vérifiable dans la barre d'adresse.
   */
  (function () {
    const bid = window.mdcfQuery().get("breed") || "";
    const label = bid ? (L.breedById ?? {})[bid] : "";
    if (label && breedEl) { breedEl.value = label; fillWeight(); }
  })();

  // ?to=<iso2> depuis une fiche pays : pré-remplit « Arrivée » avec l'aéroport le mieux
  // desservi de ce pays (ou l'entrée « ville · tous les aéroports » si la ville en a plusieurs).
  // Volontairement lu dans l'URL seulement, sans mémorisation : une destination est propre à
  // une recherche, contrairement à la race ou à la compagnie qui suivent le visiteur.
  const prefilledDest = (function () {
    try {
      const iso = window.mdcfQuery().get("to");
      const destEl = byId("f-dest") as HTMLInputElement | null;
      if (!iso || !destEl) return false;
      const label = ((L as { destByCountry?: Record<string, string> }).destByCountry ?? {})[iso.toLowerCase()];
      if (!label) return false;
      destEl.value = label;
      return true;
    } catch (e) { return false; }
  })();

  /* Retest 09/08/2026, point 6 (rapport HeatCalculator) : le lien « Trouver la meilleure compagnie
   * pour ce voyage » ne transmettait que la race, pas le trajet. `to=<iso2>` existe déjà mais
   * désigne un PAYS (fiches pays) — impossible à réutiliser tel quel pour un AÉROPORT précis sans
   * ambiguïté. Deux nouveaux paramètres dédiés, `from`/`dest` (identifiants aéroport internes,
   * même convention que `breed=breed_xxx`), coexistent avec `to` sans le redéfinir. `month` prend
   * une date indicative (1er jour du mois demandé, année en cours ou suivante si le mois est déjà
   * passé) — HeatCalculator ne connaît qu'un mois, pas un jour précis. */
  let originFromDeepLink = false;
  (function () {
    try {
      const q = window.mdcfQuery();
      const originEl = byId("f-origin") as HTMLInputElement | null;
      const fromId = q.get("from");
      if (fromId && originEl) {
        const label = (L.airCityLabel?.[fromId] as string | undefined) ?? (L.airRev?.[fromId] as string | undefined);
        if (label) { originEl.value = label; originFromDeepLink = true; }
      }
      const destId = q.get("dest");
      const destEl = byId("f-dest") as HTMLInputElement | null;
      if (destId && destEl && !prefilledDest) {
        const label = (L.airCityLabel?.[destId] as string | undefined) ?? (L.airRev?.[destId] as string | undefined);
        if (label) destEl.value = label;
      }
      const month = parseInt(q.get("month") || "", 10);
      const dateEl = byId("f-date") as HTMLInputElement | null;
      if (month >= 1 && month <= 12 && dateEl && !dateEl.value) {
        const now = new Date();
        let year = now.getFullYear();
        if (month < now.getMonth() + 1) year += 1; // mois déjà passé cette année → indicatif l'an prochain
        dateEl.value = `${year}-${String(month).padStart(2, "0")}-01`;
      }
    } catch (e) { /* ignore */ }
  })();

  // Prefill "From" with the nearest airport, using Cloudflare's edge geolocation (no browser permission prompt).
  // Une intention explicite (?from=<id> ci-dessus) l'emporte toujours sur une déduction géographique.
  (async () => {
    try {
      if (originFromDeepLink) return;
      const r = await fetch(`${API_BASE}/v1/nearest-airport`);
      if (!r.ok) return;
      const { airport_id, unit } = (await r.json()) as { airport_id?: string; unit?: "kg" | "lb" };
      const originEl = byId("f-origin") as HTMLInputElement | null;
      // Prefer the city "all airports" label so a nearby domestic-only airport (e.g. Orly)
      // doesn't silently exclude long-haul departures; fall back to the single airport label.
      const label = airport_id
        ? ((L.airCityLabel?.[airport_id] as string | undefined) ?? (L.airRev?.[airport_id] as string | undefined))
        : undefined;
      if (originEl && label) originEl.value = label;
      if (unit === "lb") setUnit("lb");
      // La géolocalisation écrit dans le champ sans émettre d'événement : la question du
      // passeport doit être réévaluée ici, sinon un visiteur localisé hors UE ne la verrait jamais.
      syncEuPassport();
    } catch { /* keep the default origin */ }
  })();

  const AIRMAP: Record<string, string> = reKey(L.airMap ?? {});
  const CITYMAP: Record<string, string[]> = reKey(L.cityMap ?? {});
  const AIRSHORT: Record<string, string> = L.airShort ?? {};
  // Resolve a field to a set of airport ids: a city option → all its airports; a single airport → [id].
  const resolveEndpoint = (id: string): { ids: string[]; primary: string } => {
    const v = norm(gv(id));
    const cityIds = CITYMAP[v];
    if (cityIds && cityIds.length) return { ids: cityIds, primary: cityIds[0] };
    const aid = AIRMAP[v];
    return aid ? { ids: [aid], primary: aid } : { ids: [], primary: "" };
  };

  /* Garde de course (audit du 09/08/2026, tâche 22) : deux recherches lancées à quelques centaines
   * de ms d'écart (double clic, correction rapide d'un champ puis renvoi) partent en parallèle ;
   * rien ne garantissait que la réponse la PLUS RÉCENTE gagne — le réseau peut très bien livrer la
   * première requête APRÈS la seconde, et son rendu écrase alors le bon résultat sans que le
   * visiteur s'en rende compte. On numérote chaque recherche et on n'écrit dans le DOM que si son
   * numéro est toujours le dernier émis au moment où la réponse arrive. */
  let searchSeq = 0;
  let lastBreedId = "";
  let lastOriginIso = "", lastDestIso = "";
  // Retest 09/08/2026, point 6 : le champ "mode" (cabine/soute/fret) n'a jamais filtré la liste
  // de compagnies — il change seulement l'évaluation par compagnie, et les 25+ compagnies
  // incompatibles restaient affichées comme si le champ n'avait aucun effet. On garde ce
  // comportement (les alternatives ont une vraie valeur) mais on scinde l'affichage en deux
  // groupes explicites dans render() ci-dessous, au lieu d'une liste unique trompeuse.
  let lastPlacement: FinderRequest["placement"] = "any";
  /* La réponse telle qu'elle était AU MOMENT DE LA RECHERCHE, et non au moment du clic.
   * Le rapport affiché décrit ce trajet-là ; la fiche qu'on ouvre depuis ce rapport doit décrire
   * le même. Relire le formulaire au clic laisserait passer une réponse changée depuis — et deux
   * pages du même outil se contrediraient de nouveau, ce que ce raccordement vient corriger. */
  let lastEuPassport = "";
  let lastOriginId = "", lastDestId = "";
  /* Correction P0 (contre-revue Codex, tour 6, 10/08/2026) : même principe que lastBreedId/
   * lastOriginIso/lastEuPassport ci-dessus, étendu à deux champs qui y avaient échappé — le lien
   * vers la fiche relisait encore `f-breed`/`f-weight` EN DIRECT dans le DOM au moment du rendu
   * (donc après la réponse réseau), pas la valeur qui avait servi à la recherche. Deux bugs de ce
   * seul oubli : (1) si le visiteur modifiait la race ou le poids pendant que la requête était en
   * vol, la fiche pouvait décrire un chien différent de celui du rapport qu'elle prolonge ; (2) le
   * poids n'était jamais converti — en unité livres, `f-weight` contient une valeur en lb, mais
   * `weight_kg` (déjà converti pour le moteur, juste en dessous) n'était jamais recopié vers la
   * fiche, qui recevait donc le nombre de livres étiqueté « kg » (ex. 50 lb → « Chien 50 kg »,
   * au lieu de 22,7 kg). `lastWeightKg` est toujours en kilogrammes, quelle que soit l'unité
   * affichée au moment de la recherche. */
  let lastWeightKg: number | undefined;
  let lastBreedLabel = "";
  const AIRCOUNTRY: Record<string, string> = L.airportCountry ?? {};

  /**
   * Question du lieu de vie du chien : affichée UNIQUEMENT sur une entrée dans l'UE depuis un
   * pays tiers.
   *
   * Elle ne sert que dans un cas — arrivée dans un État membre ET départ d'un pays tiers — parce
   * que c'est le seul où le moteur ne peut pas trancher seul : il connaît l'origine du vol, jamais
   * l'historique de l'animal. Paris → New York → Paris est le trajet type ; sans cette réponse le
   * site envoyait le propriétaire faire endosser un certificat sanitaire par l'USDA alors que son
   * passeport suffit. Partout ailleurs (Madrid → Paris, Paris → New York) la question n'a pas
   * d'objet, et on ne l'affiche donc pas : un champ de plus, c'est un formulaire abandonné de plus.
   *
   * Quand la question disparaît, on efface aussi la réponse : garder un « non » saisi pour un autre
   * trajet reviendrait à imposer un certificat sur la foi d'une réponse qui ne portait pas là-dessus.
   */
  const EU_ISO_SET = new Set<string>((L.euIso ?? []) as string[]);
  const euPassRow = byId("f-eupass-row") as HTMLFieldSetElement | null;
  /* Deux réponses possibles, et une troisième situation : rien de coché. Elle vaut « je ne sais
     pas » sans le dire — on renvoie `undefined`, jamais "" : une chaîne vide transmise au moteur
     serait un « non » déguisé, donc un certificat sanitaire imposé à qui n'a rien répondu. */
  function euPassAnswer(): "yes" | "no" | undefined {
    if (!euPassRow || euPassRow.hidden) return undefined;
    const on = euPassRow.querySelector<HTMLInputElement>('input[name="eu_passport"]:checked');
    return (on?.value as "yes" | "no" | undefined) ?? undefined;
  }
  function syncEuPassport() {
    if (!euPassRow) return;
    const o = resolveEndpoint("f-origin"), d = resolveEndpoint("f-dest");
    const oIso = AIRCOUNTRY[o.primary] ?? "";
    const dIso = AIRCOUNTRY[d.primary] ?? "";
    // Origine inconnue (aéroport non résolu) : on ne pose PAS la question — on ne sait pas encore
    // s'il s'agit d'un retour. Les deux parcours sortiront, ce qui est le comportement prudent.
    const useful = !!dIso && !!oIso && EU_ISO_SET.has(dIso) && !EU_ISO_SET.has(oIso);
    if (euPassRow.hidden === !useful) return;
    euPassRow.hidden = !useful;
    if (!useful) euPassRow.querySelectorAll<HTMLInputElement>('input[name="eu_passport"]').forEach((r) => { r.checked = false; });
  }
  for (const id of ["f-origin", "f-dest"]) {
    const el = byId(id);
    el?.addEventListener("change", syncEuPassport);
    el?.addEventListener("input", syncEuPassport);
    el?.addEventListener("change", markStale);
    el?.addEventListener("input", markStale);
  }
  // Départ pré-rempli côté serveur (CDG) et arrivée éventuellement pré-remplie par « ?to= » :
  // aucun événement n'a été émis, il faut donc une passe initiale.
  syncEuPassport();
  // Point 1 (suite) : mode (cabine/soute/fret) et date influencent aussi le calcul mais n'avaient
  // aucun écouteur avant ce correctif.
  byId("f-placement")?.addEventListener("change", markStale);
  byId("f-date")?.addEventListener("change", markStale);
  byId("f-date")?.addEventListener("input", markStale);

  function buildRequest(): FinderRequest {
    const b = resolveBreed();
    lastBreedId = b?.id ?? "";
    lastBreedLabel = (breedEl?.value ?? "").trim();
    if (lastBreedId) ctx?.setBreed?.(lastBreedId);   // remember the breed for the rest of the journey
    const w = parseFloat(weightEl?.value ?? "");
    const weight_kg = Number.isFinite(w) && w > 0 ? (unit === "lb" ? w / LB : w) : undefined;
    // Toujours en kilogrammes, arrondi comme partout ailleurs sur le site quand une conversion a
    // eu lieu (cf. fillWeight()/setUnit() plus haut, même arrondi à 1 décimale).
    lastWeightKg = weight_kg !== undefined ? +weight_kg.toFixed(1) : undefined;
    const o = resolveEndpoint("f-origin"), d = resolveEndpoint("f-dest");
    lastOriginIso = AIRCOUNTRY[o.primary] ?? "";
    lastDestIso = AIRCOUNTRY[d.primary] ?? "";
    lastOriginId = o.primary; lastDestId = d.primary;
    lastEuPassport = euPassAnswer() ?? "";
    lastPlacement = (gv("f-placement") as FinderRequest["placement"]) || "any";
    return {
      origin: o.primary,
      destination: d.primary,
      origins: o.ids.length > 1 ? o.ids : undefined,
      destinations: d.ids.length > 1 ? d.ids : undefined,
      dog: { breed_id: b?.id, weight_kg },
      travel_type: "pet",
      placement: lastPlacement,
      date: gv("f-date") || undefined,
      // Omis quand la question n'est pas posée ou reste sans réponse : le moteur affiche alors
      // les deux parcours. Ne jamais envoyer "no" par défaut.
      eu_passport: euPassAnswer(),
      locale: (L.locale as FinderRequest["locale"]) ?? "en",
    };
  }

  /**
   * POST vers le moteur. En cas d'échec, on lève : il n'y a PAS de repli.
   *
   * Ce code retombait auparavant sur un GET du même endpoint, qui renvoyait une démo
   * « CDG → Tokyo, Golden Retriever ». Dès que le POST échouait — réseau coupé, requête
   * bloquée, 5xx, endpoint absent en développement — le visiteur recevait donc un rapport
   * complet et crédible sur le Japon à la place de sa propre recherche, sans le moindre
   * avertissement. Un visiteur nous a signalé « du Tokyo qui apparaît sans raison » le
   * 30/07/2026 ; c'était ça.
   *
   * Une seule nouvelle tentative, pour absorber le vrai cas transitoire (démarrage à froid
   * du Worker, micro-coupure), puis on rend la main à l'appelant qui affichera une erreur.
   */
  async function fetchReport(req: FinderRequest): Promise<DecisionReport> {
    let lastStatus = 0;
    for (let attempt = 0; attempt < 2; attempt++) {
      try {
        const res = await fetch(`${API_BASE}/v1/finder`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(req) });
        if (res.ok) {
          const data = (await res.json()) as DecisionReport;
          // Garde-fou de forme : un corps sans verdict n'est pas un rapport, quel que soit
          // le code HTTP. On préfère une erreur visible à un rendu partiel muet.
          if (data && typeof (data as { verdict?: unknown }).verdict === "string") return data;
          throw new Error("malformed report");
        }
        lastStatus = res.status;
        if (res.status >= 400 && res.status < 500) break; // requête refusée : réessayer n'aide pas
      } catch { /* transitoire : on retente une fois */ }
    }
    throw new Error(`finder unavailable${lastStatus ? ` (${lastStatus})` : ""}`);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!out) return;

    /* Retest 09/08/2026, points 2/3/4/5 : un seul message générique ("choisis une destination et
     * le poids") couvrait 5 causes distinctes — le visiteur ne savait jamais LEQUEL des champs
     * corriger. Et un texte libre jamais choisi dans les suggestions (« VilleInventeeXYZ ») partait
     * quand même en requête vers le moteur, qui répondait 400 — affiché comme « le moteur n'a pas
     * répondu », alors que le moteur n'y est pour rien : la saisie n'était simplement associée à
     * aucun `airport_id`. On valide donc chaque champ séparément, AVANT tout appel réseau, en
     * relisant les mêmes suggestions que resolveEndpoint() utilisera de toute façon dans
     * buildRequest() — jamais le texte visible tel quel.
     */
    const oCheck = resolveEndpoint("f-origin"), dCheck = resolveEndpoint("f-dest");
    const showHint = (msg: string) => { out.hidden = false; out.innerHTML = `<p class="finder__hint">${esc(msg)}</p>`; };
    if (!oCheck.ids.length) return showHint(L.originInvalid ?? "Pick a departure city or airport from the suggestions.");
    if (!dCheck.ids.length) return showHint(L.destInvalid ?? "Pick a destination city or airport from the suggestions.");
    // Recoupement d'aéroports : identiques, ou un aéroport commun aux deux côtés (ex. CDG → « Paris
    // tous les aéroports », qui inclut CDG) — jamais un trajet réel, quelle que soit la formulation.
    const oSet = new Set(oCheck.ids);
    if (dCheck.ids.some((id) => oSet.has(id))) return showHint(L.sameEndpoint ?? "Departure and destination must be different.");
    // Poids : décision du 09/08/2026 — le poids reste obligatoire (choisir une race dans les
    // suggestions le pré-remplit déjà via fillWeight() ; le moteur n'a pas d'estimation-par-race
    // côté serveur, donc laisser croire que la race peut en tenir lieu était une fausse promesse).
    const wRaw = gv("f-weight").trim();
    const wNum = parseFloat(wRaw);
    if (!wRaw || !Number.isFinite(wNum)) return showHint(L.weightMissing ?? "Enter your dog's weight.");
    if (wNum <= 0) return showHint(L.weightInvalid ?? "Enter a weight greater than 0 kg.");
    if ((unit === "lb" ? wNum / LB : wNum) > 100) return showHint(L.weightTooHigh ?? "That weight looks too high.");

    const req = buildRequest();
    out.hidden = false;
    out.innerHTML = `<p class="finder__loading">${esc(L.loading ?? "…")}</p>`;
    const seq = ++searchSeq; // cf. commentaire près de la déclaration : gagne la dernière recherche lancée, pas la dernière arrivée
    try {
      const report = await fetchReport(req);
      if (seq !== searchSeq) return; // une recherche plus récente a démarré depuis — cette réponse est périmée
      out.innerHTML = render(report);
    } catch (err) {
      if (seq !== searchSeq) return; // idem côté erreur : ne pas écraser un résultat déjà rendu par une recherche plus récente
      // Message explicite plutôt qu'un rapport inventé : le visiteur doit savoir qu'il n'a
      // PAS de réponse, sans quoi il prend une démo pour son propre résultat.
      out.innerHTML = `<p class="finder__error">${esc(L.errorTitle ?? "The engine didn't answer.")}<br><span>${esc(L.errorBody ?? "Please try again in a moment.")}</span></p>`;
      // …mais la cause exacte va dans la console. Ce catch couvre DEUX familles de pannes très
      // différentes — le moteur qui ne répond pas, et le rendu du rapport qui échoue. Sans
      // cette trace, les deux se ressemblent, et on cherche du côté du serveur alors que le
      // problème est dans la page. Le visiteur ne voit que le message ci-dessus.
      console.error("[mdcf] finder failed:", err, "· request:", req);
    }
  });
</script>

<style>
  .finder { border: 1px solid rgba(242, 112, 15, .35); border-radius: var(--mdcf-radius); padding: 16px; background: var(--mdcf-surface); box-shadow: 0 6px 24px rgba(15, 23, 42, 0.06), 0 0 0 3px rgba(242, 112, 15, .06); }
  .finder__form { display: flex; flex-direction: column; gap: 14px; }
  .finder__row { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; }
  .finder__field { display: flex; flex-direction: column; gap: 6px; flex: 1 1 180px; }
  .finder__field--sm { flex: 0 0 150px; }
  .finder__spacer { flex: 1 1 40px; display: flex; align-items: center; min-width: 0; padding: 0 4px; }
  .finder__submit { flex: 0 0 auto; padding: 12px 24px; font-size: 15px; }
  @media (max-width: 640px) {
    .finder__spacer:has(#f-muzzle[hidden]) { display: none; }
    .finder__spacer { flex-basis: 100%; }
    .finder__submit { flex: 1 1 100%; justify-content: center; }
  }
  .finder__field label { font-size: 12px; color: var(--mdcf-muted); font-weight: 600; }
  /* Retour vers l'UE. `hidden` sur un <fieldset> est neutralisé par `display:flex` du .finder__row :
     on le rétablit explicitement, sans quoi la question s'afficherait sur tous les trajets. */
  .finder__eupass { flex-direction: column; align-items: stretch; gap: 8px; margin: 0; padding: 12px 14px;
    border: 1px solid var(--mdcf-line); border-left: 3px solid var(--mdcf-accent); border-radius: 10px; background: var(--mdcf-subtle, #f8fafc); }
  .finder__eupass[hidden] { display: none; }
  .finder__eupass-q { padding: 0; font-size: 13.5px; font-weight: 700; line-height: 1.35; color: var(--mdcf-ink); }
  .finder__eupass-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .finder__radio { display: inline-flex; align-items: center; gap: 7px; padding: 7px 13px; border: 1px solid var(--mdcf-line);
    border-radius: 999px; background: var(--mdcf-surface); font-size: 13.5px; font-weight: 600; cursor: pointer; }
  .finder__radio:has(input:checked) { border-color: var(--mdcf-accent); background: var(--mdcf-accent-soft); color: var(--mdcf-accent-ink); }
  .finder__radio input { margin: 0; accent-color: var(--mdcf-accent); }
  .finder__eupass-hint { margin: 0; font-size: 12px; line-height: 1.4; color: var(--mdcf-muted); }
  .finder__field input, .finder__field select { box-sizing: border-box; height: 44px; padding: 10px 12px; border: 1px solid var(--mdcf-line); border-radius: 10px; font: inherit; line-height: 1.2; background: var(--mdcf-surface); }
  .finder__field--sm { flex: 0 0 150px; }
  .finder__weight { display: flex; gap: 6px; align-items: stretch; }
  .finder__weight input { flex: 1 1 auto; min-width: 0; width: 100%; }
  .finder__units { display: inline-flex; border: 1px solid var(--mdcf-line); border-radius: 10px; overflow: hidden; flex: 0 0 auto; }
  .finder__unit { border: 0; background: var(--mdcf-surface); color: var(--mdcf-muted); font: inherit; font-weight: 700; font-size: 12px; padding: 0 10px; cursor: pointer; }
  .finder__unit.is-on { background: var(--mdcf-accent); color: #fff; }
  .finder__muzzle { margin: 0; font-size: 12px; line-height: 1.3; color: #dc2626; font-weight: 600; }
  /* Custom accent-insensitive autocomplete dropdown.
     :global() is required: the <ul>/<li> are created in JS at runtime and therefore lack Astro's
     scoped data-attribute, so scoped rules would never match them (the box would render in-flow). */
  :global(.ac-host) { position: relative; }
  :global(.ac-list) { position: absolute; z-index: 40; top: calc(100% + 4px); left: 0; right: 0; margin: 0; padding: 4px;
    list-style: none; max-height: 260px; overflow-y: auto; background: var(--mdcf-surface);
    border: 1px solid var(--mdcf-line); border-radius: 10px; box-shadow: 0 16px 32px rgba(15, 23, 42, 0.14); }
  :global(.ac-item) { padding: 9px 10px; border-radius: 7px; font-size: 14px; color: var(--mdcf-ink); cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.ac-item:hover), :global(.ac-item.is-cur) { background: var(--mdcf-accent-soft); }
  .finder__result { margin-top: 16px; }
  .finder__loading { color: var(--mdcf-muted); margin: 8px 0; }
  .finder__hint { color: var(--mdcf-accent-ink); background: var(--mdcf-accent-soft); border-radius: 10px; padding: 10px 12px; margin: 8px 0; font-size: 14px; }
  /* Point 1 : bandeau "critères modifiés", posé au-dessus d'un résultat désormais périmé — distinct
     du hint orange (action requise) et de l'erreur rouge (panne) : ici le résultat existe encore,
     il n'est simplement plus à jour. */
  .finder__stale { color: #78350f; background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 9px 12px; margin: 0 0 14px; font-size: 13.5px; font-weight: 700; }
  /* Panne du moteur : rouge, pas orange. Le visiteur doit comprendre qu'il n'a pas de réponse. */
  .finder__error { color: #b3261e; background: #fee2e2; border: 1px solid rgba(179, 38, 30, .25); border-radius: 10px; padding: 12px 14px; margin: 8px 0; font-size: 14px; font-weight: 700; }
  .finder__error span { display: inline-block; margin-top: 4px; font-weight: 500; color: #7f1d1d; }
</style>

<!-- The report is injected via innerHTML at runtime, so its styles must be global:
     Astro's scoped styles cannot reach DOM created dynamically after render. -->
<style is:global>
  .report { border-top: 1px solid var(--mdcf-line); padding-top: 16px; }
  .report__q { margin: 0 0 2px; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--mdcf-muted); }
  .report__answer { font-weight: 800; font-size: clamp(22px, 3vw, 30px); letter-spacing: -.01em; line-height: 1.1; margin: 0 0 14px; }
  .report--incompatible .report__answer { color: var(--mdcf-risk); }
  .report--conditional .report__answer { color: var(--mdcf-warn); }
  .report--compatible .report__answer { color: var(--mdcf-ok); }
  .report__score { margin: 0 0 4px; }
  .report__score-row { display: flex; align-items: center; gap: 12px; }
  .report__gauge { flex: 1 1 auto; height: 10px; border-radius: 999px; background: color-mix(in srgb, var(--mdcf-line) 70%, transparent); overflow: hidden; }
  .report__gauge span { display: block; height: 100%; border-radius: 999px; background: var(--mdcf-warn); transition: width .5s ease; }
  .report--incompatible .report__gauge span { background: var(--mdcf-risk); }
  .report--compatible .report__gauge span { background: var(--mdcf-ok); }
  .report__score-meta { font-size: 14px; color: var(--mdcf-muted); white-space: nowrap; }
  .report__score-meta strong { color: var(--mdcf-ink); font-size: 16px; }
  /* Sous-texte qui désambiguïse : ce nombre porte sur TOUTES les compagnies du trajet, jamais
     sur une compagnie précise (voir explain.ts, computeScore). Discret mais toujours visible —
     directement sous la jauge, pas dans une infobulle qu'on peut manquer. */
  .report__score-note { font-size: 12px; color: var(--mdcf-muted); margin-top: 2px; }
  .report__sec { margin-top: 4px; }
