---
import { inlineT } from "@mydogcanfly/knowledge";
/* Presse & partenariats — une page par langue, dans le design du site.
 *
 * Parti pris : la page est écrite ici, en HTML léger et indexable, et NON servie depuis
 * l'export de l'outil de design. Les exports autonomes pèsent 10 Mo et construisent leurs
 * images en JavaScript : parfaits comme document à télécharger, inutilisables comme page web
 * (invisibles des moteurs, lentes, non imprimables). Les deux usages sont donc séparés :
 * cette page pour être trouvée et lue, les fichiers pour être emportés.
 */
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { LEGAL } from "../../lib/legal";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { join, resolve } from "node:path";

export function getStaticPaths() {
  return [
    { params: { loc: undefined }, props: { locale: "en" } },
    { params: { loc: "fr" }, props: { locale: "fr" } }, { params: { loc: "es" }, props: { locale: "es" } },
    { params: { loc: "pt" }, props: { locale: "pt" } },
  ];
}
const { locale } = Astro.props as { locale: string };
const T = inlineT(locale);
// Préfixe de langue : dérivé du code de langue, jamais énuméré — une liste en dur ici
// renvoyait les pages portugaises vers les URL anglaises.
const base = locale === "en" ? "" : `/${locale}`;

/* Un lien de téléchargement n'est rendu que si le fichier existe vraiment dans /public/press.
 * Sans ce garde-fou, la page annoncerait un dossier de presse absent — le pire défaut possible
 * sur une page destinée à des journalistes, et un lien mort dans l'audit. */
/* `import.meta.url` ne désigne PAS ce fichier au moment du build : Astro empaquette la page
 * dans un chunk, dont la profondeur varie avec le découpage de Vite. Le chemin relatif est
 * donc tombé sur `<repo>/public/presskit/` — inexistant —, `has()` a répondu « non » pour les
 * six fichiers, et la page a cessé d'afficher ses téléchargements sans que rien n'échoue.
 * Un garde-fou qui se trompe en silence est pire que pas de garde-fou : on essaie donc
 * plusieurs racines, et si aucune n'est trouvée on affiche les liens plutôt que de les
 * escamoter — un lien mort, au moins, l'audit du site le voit. */
const CANDIDATES = [
  fileURLToPath(new URL("../../../public/presskit/", import.meta.url)),
  resolve(process.cwd(), "packages/ui/public/presskit/"),
  resolve(process.cwd(), "public/presskit/"),
];
const PUBLIC_DIR = CANDIDATES.find((d) => existsSync(d));
if (!PUBLIC_DIR) console.warn("[presskit] dossier /public/presskit introuvable : les liens sont affichés sans vérification");
/* `join`, pas une concaténation : `resolve()` rend un chemin SANS barre finale, et le
 * « + » collait le nom du fichier au nom du dossier. */
const has = (file: string) => (PUBLIC_DIR ? existsSync(join(PUBLIC_DIR, file)) : true);

/* Les chiffres de cette page sont ceux de l'accueil, à la virgule près.
 *
 * Le 30/07 la page n'en portait aucun, pour éviter de contredire l'accueil. Le bloc « en bref »
 * en réclame — un journaliste ne doit pas ouvrir un PDF de 3,7 Mo pour trouver une date de
 * lancement. La règle est donc : **on recopie ce que le site publie déjà**, on n'introduit pas
 * une seconde série de chiffres. Une page de presse qui compterait autrement que la page
 * d'accueil serait le pire des signaux, et c'est précisément là qu'un journaliste vérifie. */

/* Documents. `file` est le nom attendu dans /public/presskit/ ; l'absence masque la ligne. */
const docs = [
  {
    key: "en", flag: "🇬🇧", label: "English",
    pdf: "press-kit-en.pdf", html: "press-kit-en.html",
    /* « Press Book » n'existe pas en anglais courant : on dit « press kit » ou « media kit ».
     * La page employait déjà « press kit » dans son propre texte pendant que le document
     * affichait « Press Book ». Un seul terme, partout. */
    name: T("Press kit (English)", "Dossier (anglais)", "Dosier (inglés)"),
  },
  {
    key: "fr", flag: "🇫🇷", label: "Français",
    pdf: "press-kit-fr.pdf", html: "press-kit-fr.html",
    name: T("Press kit (French)", "Plaquette", "Dosier (francés)"),
  },
  {
    key: "es", flag: "🇪🇸", label: "Español",
    pdf: "press-kit-es.pdf", html: "press-kit-es.html",
    name: T("Press kit (Spanish)", "Dossier (espagnol)", "Dosier"),
  },
  {
    /* Le portugais est une langue en préparation, mais son dossier est complet : il est donc
     * proposé au même titre que les trois autres. Un journaliste brésilien n'a aucune raison
     * de recevoir la version anglaise parce que le site n'a pas fini de basculer. */
    key: "pt", flag: "🇧🇷", label: "Português",
    pdf: "press-kit-pt.pdf", html: "press-kit-pt.html",
    name: T("Press kit (Portuguese)", "Dossier (portugais)", "Dosier (portugués)"),
  },
].map((d) => ({ ...d, hasPdf: has(d.pdf), hasHtml: has(d.html) }))
  .filter((d) => d.hasPdf || d.hasHtml)
  /* Le dossier de la langue lue passe en tête, l'anglais juste après.
   * Un journaliste français arrivé sur /fr/ n'a aucune raison de voir la version anglaise
   * en premier ; l'anglais reste second parce que c'est la langue de repli du dossier —
   * et sur /pt/, qui n'a pas encore son dossier, il redevient naturellement le premier. */
  .sort((a, b) => (a.key === locale ? -2 : a.key === "en" ? -1 : 0) - (b.key === locale ? -2 : b.key === "en" ? -1 : 0));

/* Les « decks » (présentations) ne sont pas publiés : seuls les trois dossiers de presse le
 * sont, dans leur version corrigée. Le tableau reste pour le jour où un deck sera à jour —
 * vide, il ne rend rien. */
const decks: { file: string; label: string }[] = [];

/* Les aperçus portent un numéro de version, comme les photos et les captures. Trois fois de
 * suite, un fichier a changé de contenu en gardant son nom : le navigateur servait l'ancienne
 * image et on croyait la correction ratée alors qu'elle était faite. Toute image dont le
 * contenu change doit changer de nom — c'est la seule parade fiable.
 *
 * Les logos sont désormais de VRAIS vectoriels. Le fichier livré jusqu'ici sous l'extension
 * `.svg` n'en était pas un : zéro chemin, une image bitmap encapsulée en base64, donc du flou
 * dès qu'un média l'agrandissait. On annonce le format réellement disponible, pièce par pièce. */
const vectorFormats = T("SVG · PDF · PNG", "SVG · PDF · PNG", "SVG · PDF · PNG");
const logos = [
  { prev: "previews/emblem-v3.png", big: true,
    name: T("Emblem", "Emblème", "Emblema"),
    meta: vectorFormats + " · " + T("vector", "vectoriel", "vectorial") },
  { prev: "previews/wordmark-v3.png", big: false,
    name: T("Wordmark", "Logotype", "Logotipo"),
    meta: vectorFormats + " · " + T("vector", "vectoriel", "vectorial") },
  { prev: "previews/logo-v3.png", big: false,
    name: T("Full logo", "Logo complet", "Logotipo completo"),
    meta: vectorFormats + " · " + T("vector", "vectoriel", "vectorial") },
];

/* Captures du produit. Un journaliste doit voir ce que le site fait, pas seulement la marque —
 * c'est ce qui manquait le plus. Chaque vignette est cliquable vers le PNG pleine résolution. */
const shots = [
  { file: "screenshots/01-flight-finder-2",
    name: T("Flight Finder", "Le Finder", "El buscador"),
    note: T("The starting point: route, breed, weight, cabin or hold, travel date.",
            "Le point de départ : trajet, race, poids, cabine ou soute, date du voyage.",
            "El punto de partida: ruta, raza, peso, cabina o bodega, fecha del viaje.") },
  { file: "screenshots/02-recommendation-2",
    name: T("The recommendation", "La recommandation", "La recomendación"),
    note: T("A verdict with a compatibility score, the reasons behind it, and the airlines that actually fly the route.",
            "Un verdict avec son taux de compatibilité, les raisons qui le motivent, et les compagnies qui font vraiment la route.",
            "Un veredicto con su porcentaje de compatibilidad, las razones que lo motivan y las aerolíneas que cubren la ruta.") },
  { file: "screenshots/03-requirements-sheet-3",
    name: T("The tailored requirements sheet", "La fiche d'exigences sur mesure", "La ficha de requisitos a medida"),
    note: T("Step by step, outbound and return — each rule carrying the authority it comes from.",
            "Étape par étape, aller et retour — chaque règle porte l'autorité dont elle vient.",
            "Paso a paso, ida y vuelta — cada norma indica la autoridad de la que procede.") },
  { file: "screenshots/04-breed-report-2",
    name: T("The breed travel report", "Le rapport de voyage par race", "El informe de viaje por raza"),
    note: T("Cabin, hold, cargo, heat and cold — read from the breed's own data.",
            "Cabine, soute, cargo, chaleur et froid — lus sur les données de la race.",
            "Cabina, bodega, carga, calor y frío — leídos de los datos de la raza.") },
];

/* Photos réelles. Le reste de l'univers visuel du site est illustré ou généré ; ces images-ci
 * sont des photographies, prises par Philippe. C'est ce qui équilibre la campagne créative.
 *
 * Quatre, et toutes en 16:9. Le premier jet en proposait huit, dans des formats mêlés —
 * portrait, carré, 4:3, 9:16. La grille recadre au centre avec `object-fit: cover` : sur les
 * sources verticales, le chien sortait du cadre. On ne compte donc plus sur le navigateur
 * pour recadrer, on livre les fichiers déjà cadrés sur le sujet, tous au même format.
 *
 * Le 16:9 est serré pour un chien debout : sur la photo du Mexique, la fenêtre fait à peine
 * plus que sa hauteur, d'où un calage au pixel — 30 pixels plus haut et les pattes sont
 * coupées, 70 plus bas et c'est la tête.
 *
 * Le suffixe `-2` n'est pas décoratif. Deux de ces quatre images ont changé de contenu en
 * gardant leur nom : le navigateur et le CDN ont alors continué à servir l'ancienne version,
 * et on croyait corriger un cadrage qui était déjà bon. Toute image dont le contenu change
 * doit changer de nom. */
const photos = [
  /* Retouche fournie le 02/08/2026. Nouveau NOM de fichier, et non écrasement : c'est la règle
   * rappelée juste au-dessus, et c'est ce qui garantit qu'aucun cache ne resserve l'ancienne
   * version. L'ancien fichier reste en place tant qu'on n'a pas vérifié qu'il n'est cité
   * nulle part ailleurs. */
  { file: "photos/philippe-bailey-3.jpg",
    name: T("Philippe & Bailey", "Philippe et Bailey", "Philippe y Bailey") },
  { file: "photos/bailey-crate-2.jpg",
    /* Bailey est un mâle partout ailleurs dans le corpus — « him » dans le dossier anglais,
     * « un Golden Retriever » en français, « llevarlo » en espagnol. On s'y tient. */
    name: T("Bailey and his IATA crate", "Bailey et sa caisse IATA", "Bailey y su jaula IATA") },
  { file: "photos/philippe-bailey-snow.jpg",
    /* Bailey est à gauche sur l'image, Philippe à droite : la légende suit ce qu'on voit. */
    name: T("Bailey & Philippe in the mountains", "Bailey et Philippe à la montagne", "Bailey y Philippe en la montaña") },
  { file: "photos/bailey-mexico-3.jpg",
    name: T("Bailey in Mexico", "Bailey au Mexique", "Bailey en México") },
];

/* Le résumé copiable. Un journaliste doit pouvoir prendre les faits sans ouvrir le PDF.
 * Les décomptes sont ceux publiés sur l'accueil : une page de presse qui annoncerait
 * d'autres chiffres que le site lui-même serait le pire des signaux. */
const brief = [
  [T("Site", "Nom du site", "Nombre del sitio"), "MyDogCanFly.com"],
  [T("Purpose", "Objectif", "Objetivo"),
   T("Check if your dog can fly with your chosen airline to your destination country, along with the legal and veterinary requirements and applicable restrictions.",
     "Vérifiez si votre chien peut voler avec la compagnie choisie vers votre pays de destination, ainsi que les formalités légales et vétérinaires, et les restrictions applicables.",
     "Comprueba si tu perro puede volar con la aerolínea elegida al país de destino, así como los requisitos legales y veterinarios y las restricciones aplicables.")],
  [T("Price", "Prix", "Precio"), T("Free, no account needed", "Gratuit, sans compte", "Gratuito, sin cuenta")],
  [T("Airlines", "Compagnies", "Aerolíneas"), "90+"],
  [T("Destinations", "Destinations", "Destinos"), "160+"],
  [T("Dog breeds", "Races de chiens", "Razas de perro"), "200+"],
  [T("Airports listed", "Aéroports listés", "Aeropuertos listados"), "250+"],
  [T("Languages", "Langues", "Idiomas"), T("English, French, Spanish, Portuguese", "anglais, français, espagnol, portugais", "inglés, francés, español, portugués")],
  [T("Publisher", "Éditeur", "Editor"), "B2B VENUES LLC"],
  /* Le fondateur signe « Philippe BENOIST » sur tout ce qui est destiné à la presse — cette
     page et les quatre plaquettes — depuis le 01/08/2026. Le reste du site porte encore
     « Phil Albert-Benoist » (mentions légales, JSON-LD, page À propos) : c'est un écart connu,
     à résorber le jour où l'on décide du nom unique. Ne pas propager l'un ou l'autre à
     l'aveugle. */
  [T("Founder", "Fondateur", "Fundador"), "Philippe BENOIST"],
  [T("Press contact", "Contact presse", "Contacto de prensa"), "press@mydogcanfly.com"],
  [T("Launch", "Lancement", "Lanzamiento"), T("15 August 2026", "15 août 2026", "15 de agosto de 2026")],
];
const briefText = brief.map(([k, v]) => `${k}: ${v}`).join("\n");

const videos: Record<string, { id: string; label: string }> = {
  en: { id: "j2vI3Zan1FY", label: "English" },
  fr: { id: "eldt1BPV_4Q", label: "Français" },
  es: { id: "wOvbxhPQvq4", label: "Español" },
};
const ownVideo = videos[locale] ?? videos.en;
const otherVideos = Object.entries(videos).filter(([k]) => k !== locale).map(([, v]) => v);

/* Le code d'intégration, prêt à coller dans un article.
 *
 * On le donne écrit plutôt que de laisser le journaliste le récupérer sur YouTube, pour trois
 * raisons : le code de YouTube est en dimensions fixes (560 × 315) et casse sur mobile, il
 * pointe sur `youtube.com` qui dépose des cookies avant même la lecture — beaucoup de
 * rédactions l'interdisent —, et il ne porte pas de titre accessible. Celui-ci est en 16/9
 * fluide (le `padding-top: 56.25%` est le rapport 9/16), en mode `nocookie`, avec un `title`.
 * Tout est en styles en ligne : un CMS qui filtre les feuilles de style ne cassera rien. */
const embedCode = `<!-- MyDogCanFly — ${T("Launch film", "Film de lancement", "Película de lanzamiento")} (${ownVideo.label}) -->
<div style="position:relative;width:100%;padding-top:56.25%">
  <iframe src="https://www.youtube-nocookie.com/embed/${ownVideo.id}"
    title="MyDogCanFly — ${ownVideo.label}"
    style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
    loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>`;

// Google tronque au-delà de 65 caractères : les trois titres sont calibrés dessous.
const title = T(
  "Press & partnerships — MyDogCanFly press kit, logos and media",   // 61
  "Presse & partenariats — dossier de presse et logos MyDogCanFly",  // 62
  "Prensa y colaboraciones — dosier y logotipos MyDogCanFly",        // 56
);
const desc = T(
  "MyDogCanFly press kit, downloadable logos, launch film and contacts. Everything is on this page — no email needed.",
  "Dossier de presse MyDogCanFly, logos à télécharger, film de lancement et contacts. Tout est sur cette page, sans passer par un email.",
  "Dosier de prensa de MyDogCanFly, logotipos descargables, película de lanzamiento y contactos. Todo está en esta página, sin necesidad de correo.",
);
---
<Base locale={locale} title={title} description={desc}>
  <section class="mdcf-section prs-sec">
    <div class="mdcf-container prs">
      {/* Filigrane décoratif — jamais annoncé aux lecteurs d'écran, jamais cliquable. */}
      {/* Version officielle de l'emblème — celle qui porte l'hélice et l'arc pointillé. Le
          fichier précédent (`emblem-watermark.webp`) était une version antérieure, sans hélice ;
          il est conservé pour ne rien casser ailleurs, mais ne doit plus être utilisé. Nouveau
          nom de fichier, et non écrasement de l'ancien : c'est ce qui garantit que les caches,
          navigateur comme réseau, servent bien la nouvelle image. */}
      <img class="prs-mark" src="/presskit/emblem-watermark-v2.webp" alt="" aria-hidden="true"
           width="1400" height="797" loading="lazy" decoding="async" />
      <Breadcrumb locale={locale} items={[
        { label: T("Home", "Accueil", "Inicio"), href: "/" },
        { label: T("Press", "Presse", "Prensa") },
      ]} />


      {/* Deux colonnes : le texte porte l'information, l'image donne le ton. Sur mobile, le
          texte reste en premier — l'illustration est un plaisir, pas une porte d'entrée. */}
      <div class="prs-hero">
        <div class="prs-hero-txt">
          <p class="mdcf-eyebrow">{T("Press & partnerships", "Presse & partenariats", "Prensa y colaboraciones")}</p>
          <h1 class="mdcf-h2">{T("Press kit, logos and media", "Dossier de presse, logos et médias", "Dosier de prensa, logotipos y medios")}</h1>
        </div>
        {/* Tirage photo légèrement incliné, sur une auréole dégradée aux couleurs de la marque.
            Le cadre blanc plus épais en bas et l'ombre portée donnent l'objet posé sur la page ;
            l'inclinaison se redresse au survol. Sans légende : elle n'ajoutait rien que l'image
            ne dise déjà, et le texte alternatif porte la description pour qui ne voit pas. */}
        <div class="prs-photo">
          {/* Deux largeurs servies : 39 Ko sur mobile au lieu de 90. Le PNG d'origine faisait
              2,1 Mo — inadapté à une photographie. */}
          <img src="/presskit/press-illustration.webp"
               srcset="/presskit/press-illustration-760.webp 760w, /presskit/press-illustration.webp 1400w"
               sizes="(max-width: 900px) 100vw, 552px"
               width="1400" height="933" decoding="async"
               alt={T(
                 "A golden retriever wearing sunglasses sits in an armchair facing a journalist taking notes, under a studio microphone, in front of a MyDogCanFly backdrop.",
                 "Un golden retriever en lunettes de soleil, assis dans un fauteuil face à un journaliste qui prend des notes, sous un micro de studio, devant un fond MyDogCanFly.",
                 "Un golden retriever con gafas de sol, sentado en un sillón frente a un periodista que toma notas, bajo un micrófono de estudio, ante un fondo de MyDogCanFly.",
               )} />
        </div>
      </div>

      <!-- CE QUE FAIT LE SITE -->
      <div class="prs-what">
        {/* `set:html` : la question centrale porte une balise <b>, et Astro échappe par défaut
            tout ce qu'on interpole. La chaîne vient de notre propre table, jamais d'une saisie. */}
        <p set:html={T(
          "<b>MyDogCanFly</b> answers one question: <b>can my dog fly — on this airline, to this country?</b> The site compares what each airline allows in the cabin, in the hold and in cargo, what each destination requires on arrival, and what each breed's size and morphology change in practice.",
          "<b>MyDogCanFly</b> répond à une seule question : <b>mon chien peut-il prendre l'avion, sur cette compagnie, vers ce pays ?</b> Le site compare ce que chaque compagnie autorise en cabine, en soute et en cargo, ce que chaque destination exige à l'arrivée, et ce que la taille et la morphologie de chaque race changent concrètement.",
          "<b>MyDogCanFly</b> responde a una sola pregunta: <b>¿puede volar mi perro, en esta aerolínea, a este país?</b> El sitio compara lo que cada aerolínea permite en cabina, en bodega y en carga, lo que cada destino exige a la llegada, y lo que el tamaño y la morfología de cada raza cambian en la práctica.",
        )}</p>
        <p class="prs-claim">{T(
          "Every rule carries its source, its verification date and a confidence level. Airlines are re-checked every 90 days, countries every 180. Free, no account, in four languages.",
          "Chaque règle porte sa source, sa date de vérification et un niveau de confiance. Les compagnies sont revérifiées tous les 90 jours, les pays tous les 180. Gratuit, sans compte, en quatre langues.",
          "Cada norma incluye su fuente, su fecha de verificación y un nivel de confianza. Las aerolíneas se revisan cada 90 días, los países cada 180. Gratis, sin cuenta, en cuatro idiomas.",
        )}</p>
      </div>

      {/* EN BREF — les faits, copiables d'un geste.
          Un journaliste pressé ne doit pas avoir à ouvrir un PDF de 3,7 Mo pour retrouver
          une date de lancement ou l'adresse de l'éditeur. Le bouton copie le bloc entier
          en texte brut ; sans JavaScript, le tableau reste lisible et sélectionnable. */}
      <h2 class="prs-h2">{T("MyDogCanFly in brief", "MyDogCanFly en bref", "MyDogCanFly en breve")}</h2>
      <div class="prs-brief">
        <dl class="prs-brief-list" id="prs-brief">
          {/* La ligne « Objectif » est la seule à porter une phrase entière ; les autres sont
              des valeurs courtes. Le repérage se fait sur la longueur, pas sur un index : une
              ligne ajoutée ou déplacée ne doit pas déplacer la mise en forme avec elle. */}
          {brief.map(([k, v]) => (
            <div class={`prs-brief-row${String(v).length > 90 ? " prs-brief-row--phrase" : ""}`}>
              <dt>{k}</dt><dd>{v}</dd>
            </div>
          ))}
        </dl>
        <button class="mdcf-btn prs-btn prs-copy" type="button" data-copy={briefText}>
          {T("Copy these facts", "Copier ces informations", "Copiar estos datos")}
        </button>
      </div>

      <!-- DOSSIER DE PRESSE -->
      <h2 class="prs-h2">{T("Press kit", "Dossier de presse", "Dosier de prensa")}</h2>
      {docs.length > 0 ? (
        <div class="prs-docs">
          {docs.map((d) => (
            <div class="prs-doc">
              <div class="prs-doc-name"><span aria-hidden="true">{d.flag}</span> {d.name} <span class="prs-doc-lang">{d.label}</span></div>
              <div class="prs-doc-links">
                {d.hasPdf && (<a class="mdcf-btn prs-btn" href={`/presskit/${d.pdf}`} download>{T("Download PDF", "Télécharger le PDF", "Descargar PDF")}</a>)}
                {d.hasHtml && (<a class="prs-alt" href={`/presskit/${d.html}`} target="_blank" rel="noopener">{T("Read in browser", "Lire dans le navigateur", "Leer en el navegador")} →</a>)}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="prs-note">{T("The press kit is being finalised. Write to us and we will send the link as soon as it is online.", "Le dossier de presse est en cours de finalisation. Écris-nous et nous t'enverrons le lien dès sa mise en ligne.", "El dosier de prensa se está finalizando. Escríbenos y te enviaremos el enlace en cuanto esté disponible.")}</p>
      )}
      {decks.length > 0 && (
        <p class="prs-note">
          {T("Also available:", "Également disponible :", "También disponible:")}{" "}
          {decks.map((d) => (<a href={`/presskit/${d.file}`} target="_blank" rel="noopener">{d.label}</a>))}
        </p>
      )}

      <!-- VIDÉO -->
      {/* Ne décrit pas le contenu du film : la vignette YouTube montre un cochon ailé, pas le
          golden retriever, et annoncer « Bailey est le visage du site » juste au-dessus était
