  .prs-alt:hover { text-decoration: underline; }

  /* En bref */
  .prs-brief { border: 1px solid var(--mdcf-line); border-radius: 14px; padding: 18px 20px; background: var(--mdcf-subtle); }
  .prs-brief-list { margin: 0 0 14px; }
  .prs-brief-row { display: flex; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--mdcf-line); }
  .prs-brief-row:last-child { border-bottom: 0; }
  .prs-brief-row dt { flex: 0 0 42%; color: var(--mdcf-muted); font-size: 14px; margin: 0; }
  .prs-brief-row dd { margin: 0; font-weight: 600; font-size: 14px; }
  /* Une phrase de trois lignes en demi-gras se lit comme un pavé, là où le même poids met en
     valeur une donnée courte. Elle passe donc en 500 et en italique — le même traitement que
     le chapô de la page, ce qui la rattache au discours plutôt qu'au tableau de chiffres. */
  .prs-brief-row--phrase dd { font-weight: 500; font-style: italic; }
  .prs-copy[data-done] { border-color: var(--mdcf-ok, #1d7a4d); }

  /* Captures du produit */
  /* Chaque capture est une carte : l'image et son texte tiennent dans le même bloc, avec de
     la marge autour. Avant, l'image touchait sa légende et la légende touchait la capture
     suivante — rien ne disait où finissait l'une et où commençait l'autre. */
  .prs-shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .prs-shot { margin: 0; background: #fff; border: 1px solid var(--mdcf-line); border-radius: 14px; padding: 14px 14px 16px; box-shadow: 0 1px 2px rgba(1,29,72,.05); transition: box-shadow .18s ease, transform .18s ease; }
  .prs-shot:hover { box-shadow: 0 10px 28px rgba(1,29,72,.13); transform: translateY(-2px); }
  .prs-shot a { display: block; border: 1px solid var(--mdcf-line); border-radius: 9px; overflow: hidden; background: #fff; cursor: zoom-in; }
  .prs-shot img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top center; }


  /* Visionneuse */
  .prs-lb { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 96vh; width: min(1400px, 96vw); overflow: visible; }
  .prs-lb::backdrop { background: rgba(1, 29, 72, .86); }
  .prs-lb-img { display: block; width: 100%; max-height: 84vh; object-fit: contain; border-radius: 10px; background: #fff; cursor: zoom-out; }
  .prs-lb-x { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: #fff; color: #011d48; font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 2px 10px rgba(0,0,0,.25); }
  .prs-lb-x:hover { background: #F2700F; color: #fff; }
  .prs-lb-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: #011d48; font-size: 30px; line-height: 1; cursor: pointer; box-shadow: 0 2px 10px rgba(0,0,0,.25); }
  .prs-lb-nav:hover { background: #F2700F; color: #fff; }
  .prs-lb-prev { left: -22px; }
  .prs-lb-next { right: -22px; }
  @media (max-width: 700px) { .prs-lb-prev { left: 6px; } .prs-lb-next { right: 6px; } }
  .prs-lb-foot { display: flex; flex-wrap: wrap; gap: 6px 16px; justify-content: space-between; align-items: baseline; margin: 10px 2px 0; color: #fff; font-size: 14px; }
  .prs-lb-dl { color: #fff; text-decoration: underline; }
  .prs-shot figcaption { padding: 14px 4px 0; font-size: 13px; line-height: 1.55; }
  .prs-shot figcaption b { display: block; font-size: 15px; margin-bottom: 4px; }
  .prs-shot figcaption span { color: var(--mdcf-muted); }

  /* Photos réelles */
  .prs-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .prs-photo { display: flex; flex-direction: column; text-decoration: none; color: inherit; text-align: center; }
  .prs-photo { cursor: zoom-in; }
  .prs-photo img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 10px; border: 1px solid var(--mdcf-line); }
  .prs-photo-name { font-size: 13px; font-weight: 600; margin-top: 14px; }
  .prs-photo-meta { font-size: 12px; color: var(--mdcf-muted); }
  /* Note d'auteur */
  .prs-author { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 26px; align-items: start;
    background: #FCFBF9; border: 1px solid var(--mdcf-line); border-left: 3px solid #F2700F; border-radius: 0 14px 14px 0; padding: 26px 28px; margin-top: 22px; }
  /* Ratio natif de la photo (2122 × 2971) : `contain` plutôt que `cover`, et aucune hauteur
     imposée — c'est la seule façon d'être certain qu'aucun des deux ne soit rogné. */
  .prs-author-img { width: 190px; height: auto; aspect-ratio: 2122 / 2971; object-fit: contain;
    border-radius: 4px; box-shadow: 0 6px 18px rgba(1,29,72,.14); }
  .prs-author-eyebrow { margin: 0; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--mdcf-muted); }
  .prs-author-name { margin: 6px 0 0; font-family: Georgia, "Times New Roman", serif; font-size: 22px; font-weight: 700; }
  .prs-author-role { margin: 2px 0 12px; font-size: 13px; color: var(--mdcf-muted); }
  .prs-author-body { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 16px; line-height: 1.72; }
  /* Lettrine — le signe le plus court d'une page de livre. */
  .prs-author-body::first-letter { float: left; font-size: 52px; line-height: .84; padding: 4px 8px 0 0; color: #F2700F; font-weight: 700; }
  @media (max-width: 700px) {
    .prs-author { grid-template-columns: 1fr; gap: 16px; }
    .prs-author-img { width: 150px; }
  }
  /* La promesse de méthode : mise en italique pour la détacher du paragraphe qui la précède. */
  .prs-claim { font-style: italic; }

  .prs-logos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; }
  /* Les trois aperçus partagent exactement le même cadre, en 16:9.
     Deux essais avant celui-ci : `transform: scale(2)` sur l'emblème, qui débordait parce
     qu'une transformation ne repousse pas les bords ; puis une boîte deux fois plus haute,
     qui rendait la première tuile presque carrée à côté des deux autres. Un cadre commun et
     une image contenue règlent les deux — l'emblème paraît grand parce que son dessin est
     large, pas parce qu'on force sa boîte. */
  /* Damier discret : sans lui, un logo transparent sur fond blanc laisse croire qu'il a un fond blanc. */
  .prs-logo { display: block; text-decoration: none; border: 1px solid var(--mdcf-line); border-radius: 14px; padding: 14px; background: var(--mdcf-surface); }
  .prs-logo:hover { border-color: var(--mdcf-accent-ink, #b4530a); }
  .prs-logo-img { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; border-radius: 10px;
    background-color: #fff;
    background-image: linear-gradient(45deg, #f1f3f6 25%, transparent 25%, transparent 75%, #f1f3f6 75%),
                      linear-gradient(45deg, #f1f3f6 25%, transparent 25%, transparent 75%, #f1f3f6 75%);
    background-size: 16px 16px; background-position: 0 0, 8px 8px; }
  .prs-logo-img img { max-width: 92%; max-height: 84%; width: auto; height: auto; }
  .prs-logo-name { display: block; margin-top: 10px; font-weight: 700; font-size: 14px; color: var(--mdcf-ink); }
  .prs-logo-meta { display: block; font-size: 12px; color: var(--mdcf-muted); }
  .prs-pack { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 16px; }
  .prs-pack-note { font-size: 13px; color: var(--mdcf-muted); flex: 1 1 240px; }

  .prs-colours { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .prs-colour { border: 1px solid var(--mdcf-line); border-radius: 12px; padding: 12px; background: var(--mdcf-surface); }
  .prs-colour b { display: block; font-size: 13.5px; margin-top: 8px; }
  .prs-colour code { font-size: 12.5px; color: var(--mdcf-muted); }
  .prs-swatch { display: block; height: 46px; border-radius: 8px; border: 1px solid var(--mdcf-line); }

  .prs-video { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--mdcf-line); aspect-ratio: 16 / 9; }
  .prs-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* Code d'intégration — dans une fenêtre, ouverte depuis la phrase de description. */
  .prs-linkbtn { border: 0; background: none; padding: 0; font: inherit; cursor: pointer;
    color: var(--mdcf-accent-ink, #b4530a); font-weight: 600; text-decoration: underline;
    text-underline-offset: 2px; }
  .prs-linkbtn:hover { text-decoration-thickness: 2px; }
  .prs-embed-dlg { width: min(760px, calc(100vw - 32px)); max-height: min(80vh, 620px); padding: 0;
    border: 1px solid var(--mdcf-line); border-radius: 14px; background: var(--mdcf-subtle);
    color: var(--mdcf-ink); overflow: auto; box-shadow: 0 24px 60px rgba(1,29,72,.28); }
  .prs-embed-dlg::backdrop { background: rgba(1,29,72,.55); }
  .prs-embed-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    padding: 11px 14px; border-bottom: 1px solid var(--mdcf-line); position: sticky; top: 0;
    background: var(--mdcf-subtle); }
  .prs-embed-head span { font-weight: 700; font-size: 14px; }
  .prs-embed-actions { display: inline-flex; align-items: center; gap: 10px; }
  .prs-embed-x { width: 32px; height: 32px; border-radius: 999px; border: 1px solid var(--mdcf-line);
    background: var(--mdcf-surface); color: var(--mdcf-ink); font-size: 19px; line-height: 1; cursor: pointer; }
  .prs-embed-x:hover { background: #F7A263; border-color: #F49450; }
  .prs-embed-code { margin: 0; padding: 14px; overflow-x: auto; background: var(--mdcf-surface); }
  .prs-embed-code code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12.5px; line-height: 1.65; color: var(--mdcf-ink); white-space: pre; }
  .prs-embed-note { margin: 0; padding: 12px 14px; border-top: 1px solid var(--mdcf-line); }

  .prs-contacts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .prs-contact { border: 1px solid var(--mdcf-line); border-radius: 14px; padding: 15px 16px; background: var(--mdcf-surface); display: grid; gap: 6px; align-content: start; }
  .prs-contact b { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--mdcf-muted); }
  .prs-contact a { font-weight: 700; font-size: 14.5px; color: var(--mdcf-accent-ink, #b4530a); text-decoration: none; }
  .prs-contact a:hover { text-decoration: underline; }
  .prs-contact span { font-size: 13px; color: var(--mdcf-muted); line-height: 1.55; }

  @media (max-width: 820px) {
    .prs-colours { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prs-logos, .prs-contacts, .prs-shots { grid-template-columns: 1fr; }
    .prs-photos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prs-brief-row { flex-direction: column; gap: 2px; }
    .prs-brief-row dt { flex: none; }
  }
</style>

<script>
  /* Copie du bloc « en bref ».
     Le texte à copier voyage dans un attribut `data-copy` plutôt que d'être reconstruit
     depuis le DOM : la mise en page peut changer sans casser la copie. Sans JavaScript, le
     bouton n'apparaît pas comme cassé — il ne fait rien, et la liste reste sélectionnable
     à la souris, ce qui était déjà le comportement de secours. */
  /* Visionneuse des captures produit.
     Le lien pointe vers le PNG et reste fonctionnel sans JavaScript ; ici on l'intercepte
     pour afficher l'image dans la page plutôt que de l'envoyer dans les téléchargements. */
  const lb = document.getElementById("prs-lb") as HTMLDialogElement | null;
  if (lb && typeof lb.showModal === "function") {
    const img = lb.querySelector<HTMLImageElement>(".prs-lb-img")!;
    const cap = lb.querySelector<HTMLElement>(".prs-lb-cap")!;
    const dl = lb.querySelector<HTMLAnchorElement>(".prs-lb-dl")!;
    const prevBtn = lb.querySelector<HTMLButtonElement>(".prs-lb-prev")!;
    const nextBtn = lb.querySelector<HTMLButtonElement>(".prs-lb-next")!;
    /* Deux galeries partagent la visionneuse — les captures et les photographies. Les
       flèches ne doivent pas faire passer de l'une à l'autre : on retient la série cliquée. */
    const all = [...document.querySelectorAll<HTMLAnchorElement>("a[data-full][data-gallery]")];
    let links: HTMLAnchorElement[] = all;
    let at = 0;
    /* La position de défilement est relevée à l'ouverture et rendue à la fermeture.
       `<dialog>` rend le focus à l'élément d'origine, mais le navigateur ramenait la page
       en haut : un lecteur qui referme doit retrouver la grille là où il l'avait laissée. */
    let scrollAt = 0;

    const show = (i: number) => {
      at = (i + links.length) % links.length;
      const a = links[at];
      img.src = a.dataset.full ?? "";
      img.alt = a.dataset.cap ?? "";
      cap.textContent = `${a.dataset.cap ?? ""} — ${at + 1}/${links.length}`;
      dl.href = a.dataset.full ?? "";
    };

    all.forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        scrollAt = window.scrollY;
        links = all.filter((x) => x.dataset.gallery === a.dataset.gallery);
        show(links.indexOf(a));
        lb.showModal();
      });
    });

    const close = () => lb.close();
    img.addEventListener("click", close);
    lb.querySelector(".prs-lb-x")?.addEventListener("click", close);
    prevBtn.addEventListener("click", (e) => { e.stopPropagation(); show(at - 1); });
    nextBtn.addEventListener("click", (e) => { e.stopPropagation(); show(at + 1); });
    lb.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); show(at - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); show(at + 1); }
    });
    /* Clic sur le fond : `<dialog>` reçoit l'événement pour toute la surface de l'écran,
       on ne ferme donc que si le clic tombe hors du contenu. */
    lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
    lb.addEventListener("close", () => {
      img.removeAttribute("src");
      window.scrollTo({ top: scrollAt, behavior: "instant" as ScrollBehavior });
    });
  }

  /* Fenêtre du code d'intégration. Même règle que la visionneuse de photos : on note la
     position de la page à l'ouverture et on y revient à la fermeture, sinon `<dialog>`
     renvoie le lecteur en haut de page. */
  {
    const dlg = document.getElementById("prs-embed-dlg") as HTMLDialogElement | null;
    const open = document.getElementById("prs-embed-open");
    const shut = document.getElementById("prs-embed-close");
    if (dlg && open) {
      let scrollAt = 0;
      open.addEventListener("click", () => { scrollAt = window.scrollY; dlg.showModal(); });
      shut?.addEventListener("click", () => dlg.close());
      dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener("close", () => {
        window.scrollTo({ top: scrollAt, behavior: "instant" as ScrollBehavior });
      });
    }
  }

  document.querySelectorAll<HTMLButtonElement>(".prs-copy").forEach((btn) => {
    const original = btn.textContent ?? "";
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Contexte non sécurisé ou permission refusée : on sélectionne la liste pour que
        // l'utilisateur fasse la copie lui-même plutôt que de le laisser sans retour.
        const list = document.getElementById(btn.dataset.copySrc ?? "prs-brief");
        if (list) {
          const r = document.createRange();
          r.selectNodeContents(list);
          const s = window.getSelection();
          s?.removeAllRanges();
          s?.addRange(r);
        }
        return;
      }
      btn.dataset.done = "1";
      btn.textContent = btn.getAttribute("data-done-label") ?? "✓";
      setTimeout(() => { delete btn.dataset.done; btn.textContent = original; }, 2000);
    });
  });
</script>
