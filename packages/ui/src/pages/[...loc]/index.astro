---
import Base from "../../layouts/Base.astro";
import HomeSections from "../../components/HomeSections.astro";
import LanguageSuggestion from "../../components/LanguageSuggestion.astro";
import { t } from "@mydogcanfly/knowledge";

export function getStaticPaths() {
  return [
    { params: { loc: undefined }, props: { locale: "en" } },
    { params: { loc: "fr" }, props: { locale: "fr" } }, { params: { loc: "es" }, props: { locale: "es" } },
    { params: { loc: "pt" }, props: { locale: "pt" } },
  ];
}
const { locale } = Astro.props as { locale: string };
// SEO title/description, une variante par langue. L'anglais garde le suffixe de marque (il tient dans
// la limite d'affichage de Google) ; le français s'en passe pour rester court. L'espagnol avait
// jusqu'ici les chaînes françaises par défaut — corrigé.
/* LES QUATRE DESCRIPTIONS NE PROMETTENT PLUS « LA MEILLEURE COMPAGNIE » (07/09/2026).
   Elles disaient « Find the best airline for your dog », « les compagnies aériennes qui
   acceptent les chiens », « Encuentra la mejor opción » — et le titre français annonçait
   « 90+ compagnies » là où la base en compte 102. Aucun canal n'étant aujourd'hui confirmé par
   une citation, promettre un choix optimal dans la zone la plus reprise du site (le résultat de
   recherche) contredit ce que la page dit ensuite. Les quatre annoncent désormais ce que le site
   fait réellement : donner les conditions, et dire pour chacune si elle est prouvée. */
const SEO: Record<string, { title: string; description: string }> = {
  en: {
    title: "Can My Dog Fly? Airline Rules, Checked and Sourced | MyDogCanFly",
    description:
      "Airline conditions for dogs — cabin, hold and cargo — with country formalities and breed restrictions. Each answer shows whether it is confirmed by a quoted source or still to be checked.",
  },
  fr: {
    title: "Voyager avec son chien en avion : règles des compagnies, sourcées",
    description:
      "Les conditions des compagnies pour les chiens — cabine, soute, fret — avec les formalités par pays et les restrictions de race. Chaque réponse indique si elle est confirmée par une source citée ou encore à vérifier.",
  },
  es: {
    title: "¿Puede volar mi perro? Normas de las aerolíneas, con fuentes",
    description:
      "Las condiciones de las aerolíneas para perros — cabina, bodega y carga — con los trámites por país y las restricciones por raza. Cada respuesta indica si está confirmada por una fuente citada o aún por comprobar.",
  },
  pt: {
    title: "O meu cão pode voar? Regras das companhias, com fontes",
    description:
      "As condições das companhias para cães — cabine, porão e carga — com as formalidades por país e as restrições de raça. Cada resposta indica se está confirmada por uma fonte citada ou ainda por verificar.",
  },
};
const { title: seoTitle, description: seoDescription } = SEO[locale] ?? SEO.en;
---
<Base locale={locale} title={seoTitle} description={seoDescription}>
  {/* Seulement ici : l'accueil est la seule page où l'on arrive sans avoir choisi sa langue. */}
  <LanguageSuggestion locale={locale} />
  <HomeSections locale={locale} />
</Base>
