---
import Base from "../../layouts/Base.astro";
import HomeSections from "../../components/HomeSections.astro";
import LanguageSuggestion from "../../components/LanguageSuggestion.astro";
import { t } from "@mydogcanfly/knowledge";

export function getStaticPaths() {
  return [
    { params: { loc: undefined }, props: { locale: "en" } },
    { params: { loc: "fr" }, props: { locale: "fr" } }, { params: { loc: "es" }, props: { locale: "es" } },
    { params: { loc: "pt" }, props: { locale: "pt" } },
  ];
}
const { locale } = Astro.props as { locale: string };
/* SEO des quatre accueils — arbitrage validé par Philippe le 14/09/2026, textes verbatim.
   Chaque langue porte sa propre intention de recherche, sans traduction de repli. Le titre et la
   description distinguent l'outil des blogs : recherche par trajet, gratuité, modes de transport,
   restrictions, formalités et sources. L'espagnol vise prioritairement l'Amérique latine ; le
   portugais est du portugais du Brésil (`lang="pt-BR"`, `og:locale="pt_BR"`). */
const SEO: Record<string, { title: string; description: string }> = {
  en: {
    title: "Find Airlines That Allow Dogs by Route | MyDogCanFly.com",
    description:
      "Find airlines that allow dogs on your route—for free. Compare cabin, hold and cargo options, breed restrictions, health and entry rules with cited sources.",
  },
  fr: {
    title: "Chien en avion : l’outil gratuit et complet | MyDogCanFly",
    description:
      "Outil gratuit : trouve les compagnies pour ton chien et ton trajet. Compare cabine, soute, fret, restrictions de race et formalités, avec sources citées.",
  },
  es: {
    title: "Aerolíneas que aceptan perros por ruta | Herramienta gratis",
    description:
      "Herramienta gratis y completa: encuentra aerolíneas para tu perro y ruta. Compara cabina, bodega, carga, restricciones, requisitos y fuentes citadas.",
  },
  pt: {
    title: "Companhias aéreas para cachorro por rota | Ferramenta grátis",
    description:
      "Ferramenta grátis: encontre companhias aéreas para seu cachorro e sua rota. Compare cabine, porão, carga, restrições e requisitos, com fontes citadas.",
  },
};
const { title: seoTitle, description: seoDescription } = SEO[locale] ?? SEO.en;
---
<Base locale={locale} title={seoTitle} description={seoDescription}>
  {/* Seulement ici : l'accueil est la seule page où l'on arrive sans avoir choisi sa langue. */}
  <LanguageSuggestion locale={locale} />
  <HomeSections locale={locale} />
</Base>
