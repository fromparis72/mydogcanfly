---
import { LOCALES } from "../../../lib/routes";
import EntityDetail from "../../../components/EntityDetail.astro";
import AirlinePremiumPage from "../../../components/AirlinePremiumPage.astro";
import { airlineData } from "../../../data/airlines";
import { loadKB, slugFor } from "@mydogcanfly/knowledge";
import { shardPaths } from "../../../lib/buildShard";

export function getStaticPaths() {
  const kb = loadKB();
  const out: { params: { loc?: string; slug: string }; props: { id: string; locale: string } }[] = [];
  for (const loc of LOCALES)
    for (const a of kb.airlines.values())
      out.push({ params: { loc: loc === "en" ? undefined : loc, slug: slugFor(a.id) }, props: { id: a.id, locale: loc } });
  return shardPaths("airlines", out);
}
const { id, locale } = Astro.props as { id: string; locale: string };
---
{airlineData[id] ? <AirlinePremiumPage id={id} locale={locale} /> : <EntityDetail id={id} locale={locale} />}
