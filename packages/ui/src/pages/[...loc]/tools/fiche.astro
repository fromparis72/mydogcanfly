    /* Le repli des cas qui ne concernent pas cette origine. Volontairement discret — c'est une
     * réserve, pas une section : il ne doit pas concurrencer du regard les règles qui, elles,
     * s'appliquent vraiment. Mais il reste une ligne visible et cliquable, parce qu'une escale
     * par un pays tiers peut ramener le voyageur dans l'un de ces cas. `<details>` natif : il
     * s'ouvre sans JavaScript, il est lisible au clavier, et il s'imprime déplié dans Chromium. */
    .bmore { margin-top: 10px; }
    .bmore > summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; font-weight: 600; color: var(--mdcf-ink-soft, #33436a); opacity: .8; }
    .bmore > summary::-webkit-details-marker { display: none; }
    .bmore > summary::before { content: "▸"; font-size: 11px; transition: transform .15s; }
    .bmore[open] > summary::before { transform: rotate(90deg); }
    .bmore > summary:hover { opacity: 1; }
    .bmore .bl { margin-top: 8px; opacity: .92; }
    .bmore > p { margin: 6px 0 2px; font-size: 14px; line-height: 1.6; color: var(--mdcf-ink-soft, #33436a); }
