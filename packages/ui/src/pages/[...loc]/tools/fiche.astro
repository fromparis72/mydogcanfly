---
import { inlineT } from "@mydogcanfly/knowledge";
// Bible — bespoke, noindex "travel sheet" reached from the Finder results (one airline chosen).
// Fully data-driven: the chronology is assembled client-side from countryData (origin + destination),
// the airline snapshot travels in the URL. A shareable permalink; it never re-calls the engine.
import Base from "../../../layouts/Base.astro";
import { countryData, type CountryGuide, type LT } from "../../../data/countries";
import airlineLogos from "../../../data/airline-logos.generated.json";
import PageActions from "../../../components/PageActions.astro";

export function getStaticPaths() {
  return [
    { params: { loc: undefined }, props: { locale: "en" } },
    { params: { loc: "fr" }, props: { locale: "fr" } },
    { params: { loc: "es" }, props: { locale: "es" } },
    { params: { loc: "pt" }, props: { locale: "pt" } },
  ];
}
const { locale } = Astro.props as { locale: string };
const L = inlineT(locale);
const pick = (lt?: LT): string => (lt ? ((lt as Record<string, string>)[locale] ?? lt.en) : "");

const base = locale === "en" ? "" : `/${locale}`;

// Trim every country guide to the fields the Bible needs, resolved to this locale (keeps the shipped JSON small).
const bible: Record<string, unknown> = {};
for (const g of Object.values(countryData) as CountryGuide[]) {
  const iso = g.iso2.toLowerCase();
  bible[iso] = {
    name: pick(g.name),
    // Les fiches pays sont routées sur l'ISO2 (/countries/gr/), pas sur `seo.slug` qui vaut
    // le nom anglais complet ("greece") et n'est utilisé nulle part comme URL. Le `?? iso`
    // ne se déclenchait donc jamais : les 140 fiches, dans les 3 langues, pointaient vers
    // une URL inexistante depuis la Bible.
    slug: iso,
    regime: g.regime ?? null,
    /* La puce voyage avec sa condition d'origine. `pick` seul rendrait une chaîne et perdrait
     * `from` en route — c'est-à-dire exactement l'information qui manquait au moteur. */
    arrival: {
      intro: pick(g.arrival?.intro),
      points: (g.arrival?.points ?? []).map((p) => ({
        t: pick(p), from: p.from ?? null, not: p.from_except ?? null,
      })),
    },
    origin: {
      /* `scheme` voyage avec les cases : sans lui, la fiche de voyage ne peut pas savoir si les
       * trois cases signifient « UE / listé / non listé » ou tout autre chose. C'est précisément
       * ce qui lui manquait pour ne pas servir la règle nord-américaine à un départ de Paris. */
      scheme: g.origin?.scheme ?? "own",
      /* La condition voyage avec le cas. L'oublier ici revient à la perdre entre le serveur et
       * le navigateur : la fiche mexicaine porte bien `from_except: [us, ca]`, mais le moteur ne
       * voyait qu'un titre et un corps, et n'avait donc plus rien pour désigner le bon cas. */
      ...Object.fromEntries(["eu", "listed", "nonListed"].map((k) => [k, {
        title: pick(g.origin?.[k]?.title), body: pick(g.origin?.[k]?.body),
        from: g.origin?.[k]?.from ?? null, not: g.origin?.[k]?.from_except ?? null,
      }])),
    },
    requirements: (g.requirements ?? []).map((r) => ({
      item: pick(r.item), required: pick(r.required), when: pick(r.when), exceptions: pick(r.exceptions),
    })),
    restricted: g.restrictedDogs
      ? { intro: pick(g.restrictedDogs.intro), cat1: pick(g.restrictedDogs.cat1), cat2: pick(g.restrictedDogs.cat2), note: pick(g.restrictedDogs.note) }
      : null,
    exit: g.exit
      ? {
          authority: g.exit.authority, authorityUrl: g.exit.authorityUrl, intro: pick(g.exit.intro),
          steps: g.exit.steps.map((s) => ({ text: pick(s.text), timing: s.timing, scope: s.scope })),
          onSiteNote: g.exit.onSiteNote ? pick(g.exit.onSiteNote) : "",
        }
      : null,
    domestic: g.domestic
      ? {
          intro: pick(g.domestic.intro),
          points: (g.domestic.points ?? []).map(pick),
          territories: (g.domestic.territories ?? []).map((t) => ({ name: pick(t.name), note: pick(t.note), url: t.url })),
        }
      : null,
    sources: (g.sources ?? []).map((s) => ({ label: pick(s.label), url: s.url })),
  };
}

// All UI copy resolved to the locale (FR in tutoiement). The socle + IATA/well-being blocks are the universal
// baseline (not country data); everything country-specific is pulled from `bible` at runtime.
const T = {
  eyebrow: L("Travel requirements — tailored sheet", "Modalités de voyage — fiche sur mesure", "Trámites del viaje — ficha a medida"),
  dog: L("Dog", "Chien", "Perro"),
  airline: L("Chosen airline", "Compagnie choisie", "Aerolínea elegida"),
  needParams: L("Open this sheet from the Finder results to build it.", "Ouvre cette fiche depuis les résultats du Finder pour la construire.", "Abre esta ficha desde los resultados del buscador para generarla."),
  legend: L("Labels", "Mentions", "Menciones"),
  req: L("Required", "Requis", "Requerido"), cond: L("Depending", "Selon le cas", "Según el caso"),
  advised: L("Advised", "Conseillé", "Aconsejado"), check: L("To verify", "À vérifier", "Por verificar"),
  socleH: L("The basics — identity & vaccination (both ways)", "Le socle — identité & vaccination (dans tous les sens)", "La base — identidad y vacunación (en ambos sentidos)"),
  socle: [
    L("ISO microchip (11784/11785), implanted before or with the rabies shot.", "Puce ISO (11784/11785), posée avant ou avec le vaccin antirabique.", "Microchip ISO (11784/11785), implantado antes o con la vacuna antirrábica."),
    L("Valid rabies vaccination: first dose from 12 weeks, then a 21-day wait.", "Vaccin antirabique valide : 1re dose à partir de 12 semaines, puis 21 jours d'attente.", "Vacuna antirrábica válida: 1.ª dosis desde las 12 semanas, luego 21 días de espera."),
    L("Boosters kept up to date, with no lapse in validity.", "Rappels tenus à jour, sans interruption de validité.", "Refuerzos al día, sin interrupción de la validez."),
    L("Dog healthy and fit to travel on the day.", "Chien en bonne santé, apte au transport le jour du vol.", "Perro sano y apto para viajar el día del vuelo."),
  ],
  chronoH: L("Your trip, step by step", "Ton voyage, étape par étape", "Tu viaje, paso a paso"),
  domH: L("Domestic flight — no import formalities", "Vol intérieur — aucune formalité d'import", "Vuelo nacional — sin trámites de importación"),
  domTerr: L("Watch out — special territories", "Attention — territoires à régime particulier", "Atención — territorios con régimen especial"),
  domFallback: L(
    "No border is crossed, so no import formality applies. Check your airline's own conditions (health certificate, age, crate).",
    "Aucune frontière n'est franchie, donc aucune formalité d'import ne s'applique. Vérifie les conditions propres à ta compagnie (certificat de santé, âge, caisse).",
    "No se cruza ninguna frontera, así que no se aplica ningún trámite de importación. Consulta las condiciones de tu aerolínea (certificado de salud, edad, jaula)."),
  out: L("Outbound", "Aller", "Ida"), ret: L("Return", "Retour", "Vuelta"),
  s1: L("Before departure — leaving", "Avant le départ — sortie de", "Antes de salir — salida de"),
  s2: L("Arrival — entering", "Arrivée — entrée en", "Llegada — entrada en"),
  s3: L("Before the return — leaving", "Avant le retour — sortie de", "Antes de la vuelta — salida de"),
  s4: L("Return — entering", "Retour — entrée en", "Vuelta — entrada en"),
  /* « Le retour » et non « l'entrée ». Ces deux lignes servent aux étapes 1 et 3, c'est-à-dire
   * aux DÉPARTS ; elles renvoient le lecteur vers l'étape 4 pour lui dire où se trouve la vraie
   * contrainte. Or « l'entrée dans le pays d'origine » se lit à contretemps — on croit un instant
   * qu'il s'agit d'être entré chez soi avant de partir. « Le retour » nomme le mouvement tel que
   * le voyageur le vit, et c'est d'ailleurs le mot qu'emploie déjà le titre de l'étape 4. */
  freeExit: L("No export formality: the dog leaves the EU freely. What matters is the return to the home country (step 4).", "Aucune formalité d'export : le chien sort librement de la zone UE. Ce qui compte, c'est le retour dans le pays d'origine (étape 4).", "Ninguna formalidad de exportación: el perro sale libremente de la UE. Lo que cuenta es el regreso al país de origen (paso 4)."),
  exitCheck: L("Check the export rules of the origin country with its veterinary authority.", "Vérifie les règles d'export du pays d'origine auprès de son autorité vétérinaire.", "Verifica las reglas de exportación del país de origen con su autoridad veterinaria."),
  /* L'ouverture de l'étape « sortie » hors Europe. Les intros des fiches sont européennes à 92 % —
   * elles annoncent le certificat UE — et ne peuvent donc pas servir ici. Cette phrase-ci dit à
   * leur place la seule chose universellement vraie, et c'est justement la plus utile : le
   * certificat à obtenir n'est pas défini par le pays qu'on quitte mais par celui où l'on va.
   * {0} = le pays d'arrivée, {1} = l'autorité d'export du pays de départ. */
  /* Le nom du pays est isolé en tête, après « Destination », et la phrase le reprend ensuite par
   * « ce pays ». Sans cela il faudrait écrire « celui qu'exige LE Mexique » et « celui qu'exigent
   * LES États-Unis » — article et accord, dans quatre langues, sur 140 noms de pays. La même
   * ornière que le « à aéroport de Manchester » : on la contourne par la syntaxe. */
  exitGeneric: L(
    "Destination {0}: the certificate to obtain is the one that country requires — see step 2. On the departure side, {1} issues or endorses it: allow for the lead time and book before your flight.",
    "Destination {0} : le certificat à faire établir est celui qu'exige ce pays — voir l'étape 2. Côté départ, c'est {1} qui le délivre ou le vise : prévois le délai et prends rendez-vous avant ton vol.",
    "Destino {0}: el certificado que debes obtener es el que exige ese país — consulta el paso 2. Del lado de la salida, es {1} quien lo emite o lo visa: prevé el plazo y pide cita antes del vuelo."),
  authority: L("Authority", "Autorité", "Autoridad"),
  countrySheet: L("Country sheet", "Fiche pays", "Ficha país"),
  /* Le libellé du repli. Il couvre deux choses à la fois : les règles qui visent une autre
   * origine que celle déclarée, et les puces que la place ne permet pas de montrer en clair.
   * D'où « et précisions » — annoncer « autres cas » seul laisserait croire que le reste a
   * été jugé hors sujet, alors qu'il a seulement été jugé secondaire. */
  otherCases: L("Other cases and details", "Autres cas de figure et précisions", "Otros casos y precisiones"),
  /* L'en-tête des cas non tranchés. Le « ton » compte ici : il ne s'agit pas de s'excuser d'une
   * lacune mais de dire ce qui est vrai — ce pays a ses propres catégories, les voici. */
  /* Le statut du pays de départ, dit en clair au-dessus du texte général de la fiche. */
  origEU: L("an EU / EEA country", "pays de l'UE / EEE", "país de la UE / EEE"),
  /* LE PASSEPORT EUROPÉEN AU RETOUR. Ces cinq chaînes disent, sur la fiche, exactement ce que
   * disent les règles `rule_<iso>_import_returning_eu` dans le rapport du Finder. Elles sont
   * écrites ici et non tirées des fiches pays parce qu'elles ne décrivent pas un pays : elles
   * décrivent le règlement européen, identique pour les vingt-sept. Les fiches, elles, ne
   * connaissent que trois cases (UE / listé / non listé) et n'ont nulle part où loger ce cas.
   *
   * Les deux nuances de la source (DG SANTÉ, vérifiée le 8 août 2026) sont dans le texte et
   * doivent y rester : « le cas échéant » porte AUSSI sur le titrage — un chien parti sans
   * titrage vers un pays non listé ne peut pas invoquer la dispense ; et la dispense couvre un
   * séjour, pas un déménagement — un propriétaire qui réside désormais hors de l'UE repasse par
   * le certificat, quelles que soient sa nationalité et ses attaches. Les gommer reviendrait à
   * remplacer une erreur par une autre. */
  passLead: L(
    "Two possible routes here, and a single document separates them: an EU pet passport already in order before the dog left the EU removes the need for an EU animal health certificate. As long as that is not settled, both are shown.",
    "Deux parcours possibles, et c'est un seul document qui les départage : un passeport européen déjà en règle avant la sortie de l'UE dispense du certificat sanitaire UE. Tant que ce point n'est pas tranché, les deux sont affichés.",
    "Dos recorridos posibles, y los separa un solo documento: un pasaporte europeo ya en regla antes de salir de la UE evita el certificado sanitario de la UE. Mientras eso no esté resuelto, se muestran los dos."),
  passLbl: L("With an EU pet passport", "Avec un passeport européen", "Con un pasaporte europeo"),
  certLbl: L("Without an EU pet passport", "Sans passeport européen", "Sin pasaporte europeo"),
  passBody: L(
    "Your dog comes back on its EU pet passport alone, with no EU animal health certificate, provided that passport — completed by an authorised veterinarian — establishes that BEFORE it left the EU the dog already met the rabies vaccination conditions and, where applicable, the rabies antibody titration test. It still needs its ISO microchip and a rabies vaccination valid on the day of travel; a booster given abroad can be entered in Section V of the passport by an authorised veterinarian. If any of these elements cannot be established from the passport, the EU animal health certificate applies instead. Two limits: this covers a stay abroad, not a change of residence — once you habitually reside outside the EU the passport can no longer be used, whatever your nationality or property in the EU; and a passport issued to an owner resident in Great Britain has not been valid for travel to the EU since 31 December 2020.",
    "Ton chien rentre avec son seul passeport européen, sans certificat sanitaire UE, dès lors que ce passeport — rempli par un vétérinaire habilité — établit qu'AVANT sa sortie de l'UE il remplissait déjà les conditions de vaccination antirabique et, le cas échéant, de titrage des anticorps antirabiques. Il lui faut toujours sa puce ISO et une vaccination antirabique valide le jour du voyage ; un rappel fait à l'étranger peut être inscrit en rubrique V du passeport par un vétérinaire habilité. Si l'un de ces éléments ne peut pas être établi dans le passeport, c'est le certificat sanitaire UE qui s'applique à la place. Deux limites : cela vaut pour un séjour, pas pour un déménagement — dès que tu résides habituellement hors de l'UE, le passeport ne peut plus servir, quelles que soient ta nationalité et tes attaches dans l'UE ; et un passeport délivré à un propriétaire résidant en Grande-Bretagne n'est plus valable pour voyager vers l'UE depuis le 31 décembre 2020.",
    "Tu perro vuelve solo con su pasaporte europeo, sin certificado sanitario de la UE, siempre que ese pasaporte — cumplimentado por un veterinario autorizado — acredite que ANTES de salir de la UE ya cumplía las condiciones de vacunación antirrábica y, cuando proceda, de titulación de anticuerpos antirrábicos. Sigue necesitando su microchip ISO y una vacunación antirrábica válida el día del viaje; un refuerzo administrado en el extranjero puede anotarse en el apartado V del pasaporte por un veterinario autorizado. Si alguno de estos elementos no puede acreditarse en el pasaporte, se aplica en su lugar el certificado sanitario de la UE. Dos límites: esto vale para una estancia, no para un cambio de residencia — en cuanto resides habitualmente fuera de la UE el pasaporte deja de servir, sea cual sea tu nacionalidad o tus propiedades en la UE; y un pasaporte expedido a un propietario residente en Gran Bretaña ya no es válido para viajar a la UE desde el 31 de diciembre de 2020."),
  /* « avant le vol vers l'UE » et non « avant le retour » : cette phrase sert à l'étape 3 d'un
   * Paris → New York → Paris, mais aussi à l'étape 1 d'un New York → Paris → New York, où le vol
   * vers l'Union est l'ALLER. Nommer le mouvement plutôt que le sens du voyage évite d'avoir à
   * écrire deux versions du même texte — et évite surtout la faute de lecture. */
  passExit: L(
    "With that passport there is no EU animal health certificate to have issued and endorsed here before the flight to the EU — the dog travels on its passport. Check only that the rabies vaccination is still valid on the day of the flight: a booster given abroad can be entered in Section V of the passport by an authorised veterinarian.",
    "Avec ce passeport, aucun certificat sanitaire UE n'est à faire établir ni endosser sur place avant le vol vers l'UE — le chien voyage sur son passeport. Vérifie seulement que la vaccination antirabique est encore valide le jour du vol : un rappel fait à l'étranger peut être inscrit en rubrique V du passeport par un vétérinaire habilité.",
    "Con ese pasaporte no hay ningún certificado sanitario de la UE que emitir ni refrendar aquí antes del vuelo a la UE — el perro viaja con su pasaporte. Comprueba solo que la vacunación antirrábica siga siendo válida el día del vuelo: un refuerzo administrado en el extranjero puede anotarse en el apartado V del pasaporte por un veterinario autorizado."),
  origListed: L("a third country listed by the EU", "pays tiers listé par l'UE", "país tercero listado por la UE"),
  origNonListed: L("a third country not listed by the EU", "pays tiers non listé par l'UE", "país tercero no listado por la UE"),
  casH: L("Special cases & reserves — check if they apply to you", "Cas particuliers & réserves — vérifie s'ils te concernent", "Casos particulares y reservas — comprueba si te afectan"),
  /* Les réserves valables partout : elles ne parlent que du chien et du vol. */
  cas: [
    L("Brachycephalic breed (bulldog, pug…): hold often refused, especially in summer.", "Race brachycéphale (bouledogue, carlin…) : soute souvent refusée, surtout l'été.", "Raza braquicéfala (bulldog, carlino…): bodega a menudo rechazada, sobre todo en verano."),
    L("Puppy under 12 weeks: the rabies vaccine cannot be given before that age, and nearly every country requires it.", "Chiot de moins de 12 semaines : le vaccin antirabique ne peut pas être fait avant cet âge, et presque tous les pays l'exigent.", "Cachorro de menos de 12 semanas: la vacuna antirrábica no puede aplicarse antes de esa edad, y casi todos los países la exigen."),
    L("Recent stay (6 months) in a high-rabies-risk country: stricter entry (permit/titer).", "Séjour récent (6 mois) dans un pays à haut risque rage : entrée durcie (permis/titrage).", "Estancia reciente (6 meses) en país de alto riesgo de rabia: entrada más estricta (permiso/titulación)."),
    L("Layover in a third country: the applicable rule can change — check the whole itinerary, not just the two ends.", "Escale dans un pays tiers : la règle applicable peut changer — vérifie l'itinéraire complet, pas seulement les deux bouts.", "Escala en un país tercero: la norma aplicable puede cambiar — revisa todo el itinerario, no solo los dos extremos."),
    L("Several animals or a commercial purpose: switches to the commercial regime, other rules.", "Plusieurs animaux ou but commercial : bascule en régime commercial, autres règles.", "Varios animales o fin comercial: pasa al régimen comercial, otras reglas."),
  ],
  /* Les réserves proprement européennes — le seuil de cinq animaux, la notion de « pays tiers
   * non listé », l'interdiction d'entrée d'un chiot non vacciné — ne sont ajoutées que si un
   * bout du voyage touche l'UE. Elles s'affichaient jusqu'ici sur TOUS les trajets, si bien
   * qu'un États-Unis → Mexique parlait d'Union européenne sans qu'elle ait rien à y voir. */
  casUE: [
    L("Puppy under 12 weeks or not yet vaccinated: travel to the EU is not possible.", "Chiot de moins de 12 semaines ou non encore vacciné : voyage vers l'UE impossible.", "Cachorro de menos de 12 semanas o sin vacunar: el viaje a la UE no es posible."),
    L("Layover through a non-listed third country: a rabies titer may then become mandatory to enter the EU.", "Escale par un pays tiers non listé : un titrage peut alors devenir obligatoire pour entrer dans l'UE.", "Escala por un país tercero no listado: la titulación puede volverse obligatoria para entrar en la UE."),
    L("More than 5 animals or commercial purpose: the EU switches to the commercial regime, other rules.", "Plus de 5 animaux ou but commercial : l'UE bascule en régime commercial, autres règles.", "Más de 5 animales o fin comercial: la UE pasa al régimen comercial, otras reglas."),
  ],
  flightH: L("The flight & the airline", "Le vol & la compagnie", "El vuelo y la aerolínea"),
  cabin: L("Cabin", "Cabine", "Cabina"), hold: L("Hold", "Soute", "Bodega"), cargo: L("Cargo", "Fret", "Carga"),
  holdNote: L("Above ~8 kg (dog + bag) the dog travels in the accompanied hold, not the cabin.", "Au-delà d'environ 8 kg (chien + sac), le chien voyage en soute accompagnée, pas en cabine.", "Por encima de ~8 kg (perro + bolso), el perro viaja en bodega acompañada, no en cabina."),
  bookEarly: L("Book the animal slot early: limited number per flight.", "Réserve la place animal tôt : nombre limité par vol.", "Reserva la plaza de animal pronto: número limitado por vuelo."),
  embargo: L("Summer heat embargo possible depending on temperature.", "Embargo chaleur possible l'été selon la température.", "Embargo por calor posible en verano según la temperatura."),
  feeCheck: L("Exact fee and breed conditions: confirm with the airline.", "Tarif exact et conditions de race : à confirmer auprès de la compagnie.", "Tarifa exacta y condiciones de raza: confírmalo con la aerolínea."),
  crateH: L("The travel crate (IATA)", "La caisse de transport (IATA)", "La jaula de transporte (IATA)"),
  crate: [
    L("The dog must be able to stand, turn around and lie down.", "Le chien doit tenir debout, se retourner, se coucher.", "El perro debe poder ponerse de pie, girar y tumbarse."),
    L("Rigid, ventilated on ≥ 3 sides, lockable door, no wheels.", "Rigide, ventilée sur ≥ 3 côtés, porte verrouillable, sans roulettes.", "Rígida, ventilada en ≥ 3 lados, puerta con cierre, sin ruedas."),
    L("Water bowl, absorbent bedding, 'Live Animal' labels and arrows.", "Gamelle d'eau, litière absorbante, étiquettes « Live Animal » et flèches.", "Bebedero, lecho absorbente, etiquetas 'Live Animal' y flechas."),
  ],
  heatH: L("Heat & the hold", "Chaleur & soute", "Calor y bodega"),
  heat: [
    L("Above roughly 30 °C, many airlines suspend hold and cargo — the ban follows the temperature, not the season.",
      "Au-delà d'environ 30 °C, beaucoup de compagnies suspendent soute et fret — l'interdiction suit la température, pas la saison.",
      "Por encima de unos 30 °C, muchas aerolíneas suspenden bodega y carga — la prohibición sigue a la temperatura, no a la estación."),
    L("Snub-nosed breeds face stricter thresholds, and are often barred from the hold all year round.",
      "Les races à museau court ont des seuils plus stricts, et sont souvent interdites de soute toute l'année.",
      "Las razas de hocico chato tienen umbrales más estrictos, y a menudo tienen prohibida la bodega todo el año."),
    L("The temperature that counts is the one on the tarmac at departure AND on arrival, not the forecast in town.",
      "La température qui compte est celle du tarmac au départ ET à l'arrivée, pas la météo en ville.",
      "La temperatura que cuenta es la de la pista en la salida Y en la llegada, no la previsión en la ciudad."),
  ],
  actHeat: L("Calculate the heat risk", "Calculer le risque chaleur", "Calcular el riesgo de calor"),
  careH: L("Well-being & logistics", "Bien-être & logistique", "Bienestar y logística"),
  care: [
    L("Sedation discouraged (breathing risk at altitude).", "Sédation déconseillée (risque respiratoire en altitude).", "Sedación desaconsejada (riesgo respiratorio en altitud)."),
    L("Get the dog used to its crate beforehand; light meal before the flight.", "Habitue le chien à sa caisse en amont ; repas léger avant le vol.", "Acostumbra al perro a su jaula antes; comida ligera antes del vuelo."),
    L("Early check-in; collect at the cargo terminal if applicable.", "Enregistrement anticipé ; retrait au terminal fret si applicable.", "Facturación anticipada; recogida en la terminal de carga si aplica."),
  ],
  actBook: L("Book the ticket", "Réserver le billet", "Reservar el billete"),
  actCrate: L("Crate size", "Taille de la caisse", "Tamaño de la jaula"),
  actPrint: L("Print / PDF", "Imprimer / PDF", "Imprimir / PDF"),
  actEmail: L("Send by email", "Envoyer par email", "Enviar por email"),
  emailSubject: L("My dog's travel sheet", "La fiche voyage de mon chien", "La ficha de viaje de mi perro"),
  further: L("Further reading:", "Pour aller plus loin :", "Para saber más:"),
  breedSheet: L("Breed sheet", "Fiche de la race", "Ficha de la raza"),
  airlineSheet: L("Airline sheet", "Fiche compagnie", "Ficha aerolínea"),
  sourcesH: L("Official sources", "Sources officielles", "Fuentes oficiales"),
  foot: L("Tailored, non-indexed page. Outbound links open in a new tab.", "Page sur mesure, non indexée. Les liens sortants s'ouvrent dans un nouvel onglet.", "Página a medida, no indexada. Los enlaces externos se abren en una pestaña nueva."),
  disclaimer: L(
    "For guidance only — no warranty or liability. Before travelling, always confirm your case with the destination country's embassy or consulate and with your vet.",
    "Informations données à titre indicatif, sans garantie ni responsabilité. Avant de partir, fais toujours valider ta situation par l'ambassade ou le consulat du pays de destination et par ton vétérinaire.",
    "Información orientativa, sin garantía ni responsabilidad. Antes de viajar, confirma siempre tu caso con la embajada o el consulado del país de destino y con tu veterinario."),
};
// Editorial emphasis, two purposes:
//  - CRU = crucial documents/actions to not forget — bolded in essential blocks, but only in NON-negated
//    clauses (so "aucun permis n'est nécessaire" stays neutral).
//  - CAS = watch-out triggers — bolded in the "special cases" block only.
const CRU_FR = ["certificat sanitaire","certificat vétérinaire","certificat","passeport européen","passeport","titrage antirabique","titrage sérologique","titrage","puce électronique","puce ISO","puce","permis d'importation","licence d'importation","vaccin antirabique","vaccination antirabique","CDC Dog Import Form"];
const CRU_EN = ["health certificate","veterinary certificate","certificate","EU pet passport","passport","rabies titer","serological test","titer","microchip","import permit","import licence","import license","rabies vaccination","rabies vaccine","CDC Dog Import Form"];
const CRU_ES = ["certificado sanitario","certificado veterinario","certificado","pasaporte europeo","pasaporte","titulación antirrábica","titulación serológica","titulación","microchip","permiso de importación","licencia de importación","vacuna antirrábica","CDC Dog Import Form"];
const CAS_FR = ["brachycéphales","brachycéphale","escale","transit","séjour récent","chiots","chiot","catégorisés","catégorisée","catégorie"];
const CAS_EN = ["brachycephalic","layover","transit","recent stay","puppy","restricted","banned"];
const CAS_ES = ["braquicéfala","braquicéfalo","escala","tránsito","estancia reciente","cachorro"];
/* Les 27 États membres, en ISO2 — MÊME liste que FlightFinder.astro et que
   packages/knowledge/scripts/regles-ue-origine.mjs. Elle sert ici à la seule chose à laquelle
   elle sert là-bas : reconnaître un RETOUR vers l'Union, c'est-à-dire l'unique cas où la
   question du passeport européen se pose. On ne réutilise pas `regime: "eu"` des fiches pour
   cela : ce champ vaut aussi pour la Suisse, la Norvège et le Liechtenstein, qui ne relèvent
   pas des règles écrites pour les Vingt-Sept. Le sur-ensemble ferait apparaître le parcours
   passeport sur des trajets que la source ne couvre pas. */
const EU_ISO2 = ["at", "be", "bg", "hr", "cy", "cz", "dk", "ee", "fi", "fr", "de", "gr", "hu", "ie",
  "it", "lv", "lt", "lu", "mt", "nl", "pl", "pt", "ro", "sk", "si", "es", "se"];
const cfg = { locale, base, countryBase: base + "/countries/", breedBase: base + "/breeds/", crateBase: base + "/tools/crate/", heatBase: base + "/tools/heat/",
  cru: locale === "fr" ? CRU_FR : locale === "es" ? CRU_ES : CRU_EN, cas: locale === "fr" ? CAS_FR : locale === "es" ? CAS_ES : CAS_EN, logos: airlineLogos, euIso: EU_ISO2, T };
const title = L("Your dog's travel sheet", "La fiche voyage de ton chien", "La ficha de viaje de tu perro");
---
<Base locale={locale} title={`${title} — MyDogCanFly`} description={T.eyebrow} noindex={true}>
  <section class="mdcf-section"><div class="mdcf-container">
    <div id="bible" class="bible"><p class="bible__empty">{T.needParams}</p></div>
    <div id="bible-tools" hidden><PageActions locale={locale} noActions={true} /></div>
  </div></section>

  <script type="application/json" id="bible-data" set:html={JSON.stringify(bible)} is:inline />
  <script type="application/json" id="bible-cfg" set:html={JSON.stringify(cfg)} is:inline />

  <script>
    const DATA = JSON.parse(document.getElementById("bible-data")?.textContent ?? "{}");
    const C = JSON.parse(document.getElementById("bible-cfg")?.textContent ?? "{}");
    const T = C.T;
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    /* Faille corrigée le 09/08/2026 (`safeUrl`, qui neutralisait les schémas dangereux dans les
       paramètres `as`/`af` de l'ancien lien de réservation compagnie) puis remplacée le 10/08/2026
       par une correction plus large (Option B, voir plus bas) : ces paramètres, comme tous les
       autres champs non fiables issus de l'URL, ne sont désormais plus lus ni injectés dans le
       DOM du tout — `safeUrl` n'a donc plus d'appelant et a été retirée avec le code qui
       l'utilisait, plutôt que laissée comme protection orpheline. */
    const mkRe = (arr) => (arr && arr.length)
      ? new RegExp('(?<![A-Za-zÀ-ÿ])(' + arr.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')(?![A-Za-zÀ-ÿ])', 'gi')
      : null;
    const CRURE = mkRe(C.cru), CASRE = mkRe(C.cas);
    const DLRE = /((?:au moins|at least|al menos|dans les|sous|within|jusqu'à|hasta)\s)?\d+(?:\s?(?:[–-]|à)\s?\d+)?[\s-]?(?:jours?|semaines?|mois|heures?|ans?|d[ií]as?|semanas?|meses|mes|horas?|a[nñ]os?|days?|weeks?|months?|hours?|years?)\b/gi;
    const NEG = /(aucun|aucune|sans|\bni\b|pas d|jamais|n'est pas|n'exige|n'a pas|no\b|not\b|without|neither|ning[uú]n|ninguna|\bsin\b)/i;
    const und = (s) => s.replace(DLRE, '<u class="bdelay">$&</u>');
    // Essential blocks: underline delays; bold crucial terms only in clauses that are NOT negated.
    const emE = (raw) => { const s = und(esc(raw)); return CRURE ? s.split(/([.;:!?])/).map((p) => NEG.test(p) ? p : p.replace(CRURE, '<b>$1</b>')).join('') : s; };
    // Special-cases block: bold the watch-out triggers, underline delays.
    const emC = (raw) => { const s = und(esc(raw)); return CASRE ? s.replace(CASRE, '<b>$1</b>') : s; };
    const flag = (iso) => iso && iso.length === 2 ? String.fromCodePoint(...[...iso.toUpperCase()].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65)) : "";
    const P = window.mdcfQuery();
    const el = document.getElementById("bible");

    const from = (P.get("from") || "").toLowerCase();
    const to = (P.get("to") || "").toLowerCase();
    const O = DATA[from], D = DATA[to];
    if (!O || !D) { /* keep the empty hint */ }
    else {
      /* Option B (décision Philippe, 10/08/2026) : cette fiche est un lien profond partageable
       * et rien ne garantit que ses paramètres reflètent encore une décision réelle du Finder —
       * ils peuvent avoir été copiés depuis une ancienne URL, modifiés à la main, ou forgés.
       * `safeUrl` (ci-dessus) neutralisait déjà les schémas dangereux dans `as`/`af`, mais un lien
       * `http(s)` bien formé restait affiché comme si MyDogCanFly l'avait vérifié — une compagnie
       * inventée avec un score et un lien de réservation à son propre nom apparaissait crédible.
       * Le nom de compagnie, le score, cabine/soute/fret, le vol direct, le tarif, l'embargo et
       * les liens sortants compagnie (site, fiche) ne sont donc plus lus depuis l'URL ni injectés
       * dans le DOM — pas seulement masqués en CSS. Seule reste la chronologie des formalités
       * pays, qui vient de `bible` (généré côté serveur depuis les données canoniques), jamais de
       * la query string. */
      const breed = P.get("breed") || "", brachy = P.get("brachy") === "1", w = P.get("w") || "";

      const key = (regime) => regime === "eu" ? "eu" : regime === "non_listed" ? "nonListed" : "listed";
      const pill = (kind) => {
        const m = { req: ["var(--mdcf-risk-soft,#fee2e2)", "#991b1b", T.req], cond: ["#fef0dc", "#92400e", T.cond],
          adv: ["#e6f1fb", "#185fa5", T.advised], chk: ["#f1efe8", "#5f5e5a", T.check] };
        const [bg, fg, tx] = m[kind];
        return `<span class="bp" style="background:${bg};color:${fg}">${esc(tx)}</span>`;
      };
      const list = (arr, f) => arr.filter(Boolean).map((x) => `<li>${f ? f(x) : esc(x)}</li>`).join("");

      // Outbound links carry the full context (airline, breed, destination) so nothing is lost on back-navigation.
      // airId/bid restent utilisés uniquement comme contexte de navigation interne (liens vers
      // les outils caisse/chaleur du site) — aucune donnée de verdict compagnie n'en dépend.
      const airId = P.get("air") || "", bid = P.get("bid") || "";
      const qs = (pairs) => { const q = pairs.filter((p) => p[1]).map((p) => p[0] + "=" + encodeURIComponent(p[1])).join("&"); return q ? "?" + q : ""; };
      const addQ = (url, q) => q ? url + (url.indexOf("?") >= 0 ? "&" + q.slice(1) : q) : url;
      const crateHref = C.crateBase + qs([["air", airId], ["breed", bid]]);
      const heatHref = C.heatBase + qs([["breed", bid]]);
      const countryHref = (slug) => C.countryBase + slug + "/" + qs([["via", airId], ["breed", bid]]);

      // Step content, data-driven from the two country guides.
      const originEU = O.regime === "eu", destEU = D.regime === "eu";

      /* LE PASSEPORT EUROPÉEN AU RETOUR — la réponse donnée au Finder, appliquée ici.
       *
       * Le défaut réparé : le Finder posait la question (« Ton chien vit-il habituellement dans
       * l'Union européenne ? »), son rapport en tenait compte, et cette page — qui a son propre
       * chemin de données, les fiches pays YAML — ne la recevait pas. Le visiteur qui répondait « oui » lisait le bon parcours dans le rapport,
       * puis retrouvait « certificat sanitaire UE endossé par l'USDA » en ouvrant les modalités
       * détaillées. Deux réponses contradictoires pour le même voyage, dans le même outil.
       *
       * La réponse arrive par le lecteur commun de paramètres (`window.mdcfQuery`, Base.astro),
       * celui qui apporte déjà `from`, `to`, la compagnie et la race. Un canal, pas deux : la
       * fiche reste un permalien partageable et le paramètre survit au changement de langue.
       *
       * LES TROIS ÉTATS, À L'IDENTIQUE DU MOTEUR (regles-retour-ue-passeport.mjs) :
       *   "yes" (il rentre chez lui)  → parcours passeport seul, le certificat passe sous le repli
       *   "no"  (il découvre l'UE)    → parcours certificat seul, rien ne change
       *   paramètre absent            → LES DEUX parcours
       * Le formulaire n'a plus que deux options : le troisième état s'est déplacé dans l'absence de
       * clic, et c'est exactement le même comportement prudent qu'avant. Une valeur "unknown"
       * héritée d'un lien partagé retombe d'elle-même sur le cas « absent », puisque seules "yes" et
       * "no" écartent une branche.
       * L'absence de réponse n'est jamais un « non ». Envoyer quelqu'un chez le vétérinaire faire
       * endosser un certificat inutile coûte plus cher que lui faire lire deux paragraphes — et
       * c'est ce que produirait le moindre défaut de prudence ici. */
      const rep = (P.get("eu_passport") || "").toLowerCase();
      const montrePasseport = rep !== "no";     // yes + absent (et tout héritage inconnu)
      const montreCertificat = rep !== "yes";   // no  + absent (et tout héritage inconnu)
      /* Le cas se pose sur une ARRIVÉE dans l'Union depuis un pays tiers — jamais ailleurs.
       * On raisonne par étape et non par voyage : sur un Paris → New York → Paris c'est l'étape 4,
       * sur un New York → Paris → New York c'est l'étape 2. Les deux existent, la fiche décrivant
       * toujours un aller-retour. Un trajet intra-UE (Madrid → Paris) ne remplit jamais la
       * condition : il ne voit donc strictement rien de ce dispositif. */
      const EU27 = new Set(C.euIso || []);
      const retourUE = (arrivee, depart) => EU27.has(arrivee) && !EU27.has(depart);

      /* LE BLOC « SORTIE » NE DÉCRIT PAS UNE SORTIE, IL DÉCRIT UNE SORTIE VERS L'EUROPE.
       *
       * 95 des 98 blocs `exit` du corpus sont rédigés ainsi — « Les États-Unis sont un pays listé :
       * pas de titrage pour revenir, mais il faut le certificat sanitaire UE endossé par l'USDA
       * APHIS ». C'est cohérent : le site est né pour un lecteur européen, et l'étape 1 supposait
       * partout qu'on rentrait en Europe. La supposition ne se voyait pas tant que les deux bouts
       * du voyage touchaient l'UE ; elle saute aux yeux sur un États-Unis → Mexique, où le
       * voyageur lit qu'il lui faut un certificat européen pour aller à Mexico.
       *
       * On ne montre donc la procédure que si l'autre bout du voyage est bien européen. Ailleurs,
       * on dit ce qu'on sait vraiment : l'autorité compétente, avec son lien — c'est vrai quelle
       * que soit la destination — et l'invitation à vérifier auprès d'elle. Une réponse courte et
       * juste plutôt qu'une réponse longue et hors sujet.
       *
       * Ce n'est pas la réparation définitive : elle consistera à rédiger les blocs « sortie » sans
       * présupposer la destination, ou à leur donner une portée déclarée. En attendant, la fiche
       * ne raconte plus l'Europe à qui n'y va pas. */
      const sortie = (guide, versUE, versNom, retour) => {
        const e = guide.exit;
        if (!e) return `<p>${esc(T.exitCheck)} ${pill("chk")}</p>`;
        const lien = `<a class="blink" href="${esc(e.authorityUrl)}" target="_blank" rel="nofollow noopener">${esc(T.authority)} : ${esc(e.authority)}</a>`;
        if (versUE) {
          /* Vers l'Europe : tout, sauf les étapes écrites POUR les autres destinations. */
          const pour = (e.steps || []).filter((s) => s.scope !== "non_eu").map((s) => s.text);
          const certif = `<p>${emE(e.intro)}</p><ul class="bl">${list(pour, emE)}</ul>`
            + (e.onSiteNote ? `<p class="bnote">${emE(e.onSiteNote)}</p>` : "");
          /* L'ÉTAPE OÙ LE CERTIFICAT SE FABRIQUE. C'est ici que la contradiction coûtait le plus
           * cher : le bloc « sortie » des États-Unis envoie chez un vétérinaire agréé USDA puis à
           * l'endossement APHIS, et sa note de fin annonce le nouveau modèle de certificat
           * européen du 1er octobre 2026 — trois démarches, plusieurs jours, un coût, pour un
           * document dont le passeport dispense. Avec « oui », tout cela passe sous le repli :
           * replié, jamais supprimé, parce qu'une escale par un pays tiers non listé ou un
           * passeport incomplet peut ramener le voyageur dans ce parcours-là. */
          if (retour) {
            const passe = `<p>${emE(T.passExit)}</p>`;
            if (!montreCertificat)
              return passe + `<details class="bmore"><summary>${esc(T.otherCases)}</summary>${certif}</details>` + lien;
            if (montrePasseport)
              return `<p>${esc(T.passLead)}</p><p class="bcase"><b>${esc(T.certLbl)}</b></p>${certif}`
                + `<p class="bcase"><b>${esc(T.passLbl)}</b></p>${passe}` + lien;
          }
          return certif + lien;
        }
        /* Hors Europe : l'intro et la note de fin des fiches sont européennes, on les remplace par
         * la phrase générique. Restent les étapes qui décrivent la procédure du pays — celles
         * marquées `any`, et celles écrites exprès pour ce cas (`non_eu`) sur les fiches dont
         * toutes les étapes d'origine parlaient du certificat européen. */
        const neutres = (e.steps || []).filter((s) => s.scope !== "eu").map((s) => s.text);
        return `<p>${esc(T.exitGeneric.replace("{0}", versNom).replace("{1}", e.authority))}</p>`
          + (neutres.length ? `<ul class="bl">${list(neutres, emE)}</ul>` : "") + lien;
      };
      /* Étape 1 : on quitte le pays d'origine pour la destination. Le retour vers l'Union se joue
       * donc ici quand le voyageur habite hors de l'UE et vient y passer un séjour — New York →
       * Paris → New York. Le sens de la question ne change pas, seule l'étape où elle atterrit. */
      const step1 = originEU ? `<p>${esc(T.freeExit)}</p>` : sortie(O, destEU, D.name, retourUE(to, from));
      /* « Au départ de l'UE », au sens du mouvement d'animaux de compagnie : les Vingt-Sept, plus
       * la Norvège, le Liechtenstein et la Suisse — qui portent déjà `regime: eu` dans les fiches.
       * L'Islande est ajoutée à la main : elle applique le règlement 576/2013 et délivre le
       * passeport européen, mais son régime est noté `island_strict` parce que ce champ décrit
       * l'entrée SUR son territoire, pas le statut d'un départ depuis chez elle. Sans cette
       * exception, un voyageur parti de Reykjavík se verrait replier la règle qui le concerne. */
      const departUE = (iso) => DATA[iso]?.regime === "eu" || iso === "is";

      /* La ligne qui dit au lecteur que le paragraphe qui suit est bien le sien.
       *
       * Elle ne dit PAS « pays tiers listé par l'UE ». Cette expression est du jargon : elle
       * renvoie à une liste que le lecteur n'a pas sous les yeux, et lui laisse le soin de
       * vérifier si son pays y figure — le travail qu'on est censé lui épargner. C'était déjà
       * le tort du paragraphe des fiches, qui énumérait « États-Unis, Canada, Royaume-Uni,
       * Suisse, Japon, Australie… » sans jamais nommer le Mexique.
       *
       * Les fiches, elles, ont déjà la bonne formule : le TITRE de la case dit ce que le cas
       * implique — « Certificat sanitaire, sans prise de sang », « Titrage + 3 mois d'attente ».
       * On l'accole au nom du pays de départ, et la ligne se suffit : « Mexique — Certificat
       * sanitaire, sans prise de sang ». Plus de liste à connaître, plus de catégorie à décoder.
       *
       * Ce sont les mots de la fiche, choisis par elle pour cette case : la ligne ne peut donc
       * pas contredire le paragraphe qu'elle introduit — c'est ce qui la rend sûre dans les 140
       * fiches sans qu'aucune n'ait à être relue. */
      /* Nommer le pays du voyageur dans le paragraphe, à la place de l'énumération d'exemples.
       *
       * « Depuis un pays tiers listé (États-Unis, Canada, Royaume-Uni, Suisse, Japon, Australie…) »
       * est juste pour qui revient du Mexique — le Mexique EST un pays tiers listé — mais le
       * lecteur voit six pays qui ne sont pas le sien et conclut que la phrase ne le concerne
       * pas. Il lui faudrait la liste complète pour trancher, et cette liste, il ne l'a pas.
       * Alors on remplace l'illustration par lui : « Depuis un pays tiers listé (Mexique) ».
       *
       * PROUVÉ, ET SEULEMENT PROUVÉ. Le remplacement n'a lieu que là où l'appartenance du pays
       * à la catégorie est établie, jamais déduite :
       *
       *   · la case porte un `from` / `from_except` explicite — la donnée le dit ;
       *   · ou le pays d'arrivée applique lui-même le règlement européen (`regime: eu`), auquel
       *     cas « pays tiers listé » désigne exactement le champ `regime: listed` qui a servi à
       *     choisir le paragraphe. L'affirmation et le choix reposent sur la même donnée.
       *
       * Ailleurs, non. L'Angola classe ses origines en « rage maîtrisée » et « haut risque » ;
       * le moteur y fait correspondre le régime européen faute de mieux, et cette correspondance
       * est une approximation acceptable tant qu'elle reste implicite. Écrire « (Mexique) » la
       * transformerait en affirmation sur le statut sanitaire du Mexique vu par l'Angola — que
       * rien dans nos données n'établit. Une énumération vague vaut mieux qu'une affirmation
       * fausse, et l'exemple reste alors tel que la fiche l'a écrit.
       *
       * La transformation se fait à l'affichage, pas dans les fiches : aucune traduction à
       * refaire, et le paragraphe s'adapte à chaque voyageur au lieu d'être figé pour un seul. */
      const nommerOrigine = (texte, iso, prouve) => {
        const nom = DATA[iso]?.name;
        if (!nom || !texte || !prouve) return texte;
        return texte.replace(/\(([^()]{6,90})\)/g, (tout, dedans) => {
          if (dedans.includes(nom)) return tout;                 // le pays y est déjà : on ne touche à rien
          if (/\d/.test(dedans)) return tout;                    // « (RNATT ≥0,5 UI/ml) » : une valeur, pas des pays
          if (!/[,…]|\.\.\./.test(dedans)) return tout;           // une seule mention : ce n'est pas une énumération
          const majuscules = dedans.match(/(?:^|[\s,])[A-ZÀ-Þ]/g) ?? [];
          if (majuscules.length < 2) return tout;                // « (sortie rouge, ex. à Vienne) » : une précision
          return `(${nom})`;
        });
      };

      /* Les puces d'arrivée, triées selon l'origine réellement déclarée.
       *
       * ON NE SUPPRIME RIEN. Les puces qui ne valent pas pour cette origine passent sous un
       * repli, avec celles que la place ne permet pas d'afficher en clair. Deux raisons de ne
       * pas masquer : une escale dans un pays tiers peut changer la règle applicable, et une
       * étiquette peut se tromper. Masquer serait un pari ; replier n'en est pas un. Le texte
       * reste dans la page, à un clic — la fiche pays, elle, continue de tout afficher puisqu'elle
       * ignore d'où vient son lecteur.
       *
       * Une puce sans `from` vaut pour toutes les origines : le corpus non tagué se comporte
       * exactement comme avant. */
      /* Le paragraphe de tête de l'étape : la règle du pays d'arrivée qui vise CETTE origine.
       *
       * Encore faut-il que le pays d'arrivée classe le monde comme l'Union européenne. 81 fiches
       * le font, et pour elles le régime du pays de départ désigne bien la bonne case. Les 59
       * autres ont leur propre grille — groupes australiens, régions désignées japonaises, UEEA,
       * Amérique du Nord contre le reste au Mexique — et le régime européen du départ n'y dit
       * rien du tout. C'est ce qui servait la règle nord-américaine à un voyageur parti de Paris.
       *
       * Là, le moteur s'abstient : il présente les cas du pays, repliés, chacun sous son titre.
       * Le lecteur reconnaît le sien en une ligne, et rien ne lui est affirmé à tort. Ce n'est
       * pas la réponse idéale — ce sera de qualifier chaque cas, fiche par fiche — mais c'est
       * une réponse honnête, et une réponse honnête vaut mieux qu'une réponse fausse. */
      const entryBlock = (guide, fromIso) => {
        const ue = departUE(fromIso);
        const pts = guide.arrival?.points || [];
        /* Trois formes de condition, dans l'ordre où elles se lisent. Une puce sans condition
         * vaut toujours — c'est le cas de 94 % du corpus, et c'est ce qui rend la migration
         * incrémentale : ce qui n'est pas encore qualifié continue de s'afficher. */
        const vaut = (p) => {
          if (p.not) return !p.not.includes(fromIso);              // from_except : en creux
          if (Array.isArray(p.from)) return p.from.includes(fromIso); // liste de pays
          if (p.from === "any") return true;                       // le cas général de la fiche
          if (p.from) return (p.from === "eu") === ue;             // mot-clé UE / hors-UE
          return true;
        };

        /* LE PARAGRAPHE DE TÊTE : la règle du pays d'arrivée qui vise CETTE origine.
         *
         * Trois situations, et une seule règle pour les départager — n'affirmer que ce qu'on sait.
         *
         * 1. `scheme: eu` — les cases signifient « UE / listé / non listé ». Le régime du pays de
         *    départ désigne la bonne, on l'affiche. 81 fiches.
         * 2. `scheme: own` MAIS les cases portent une condition — le Mexique distingue l'Amérique
         *    du Nord du reste, et le dit désormais dans la donnée. On désigne la bonne case, les
         *    autres rejoignent le repli. Une case sans condition dans une fiche qui en qualifie
         *    d'autres n'est plus un cas d'origine mais une remarque (« documents manquants ») :
         *    elle va au repli aussi.
         * 3. `scheme: own` et aucune case qualifiée — on ne sait pas. Aucun paragraphe de tête :
         *    les puces, elles, sont déjà triées et suffisent. Les cas partent au repli, avec le
         *    reste. Une première version dressait ici un menu « repère ta catégorie » ; c'était
         *    honnête mais ça retournait le travail au lecteur, et ça doublait des puces qui
         *    disaient déjà la même chose. Ne rien dire vaut mieux que faire chercher. */
        const cases = [guide.origin.eu, guide.origin.listed, guide.origin.nonListed]
          .filter((c) => c && c.title && c.body);
        let tete = "", casReplies = [];
        if (guide.origin.scheme === "eu") {
          const ob = guide.origin[key(DATA[fromIso]?.regime)] || {};
          /* Le paragraphe des fiches est écrit en général : « Depuis un pays tiers listé
           * (États-Unis, Canada, Royaume-Uni, Suisse, Japon, Australie…) ». Le contenu est juste,
           * mais un voyageur revenant du Mexique lit six pays qui ne sont pas le sien et conclut
           * que la phrase ne le concerne pas. Le moteur, lui, SAIT que le Mexique est un pays
           * tiers listé — c'est même ce qui lui a fait choisir ce paragraphe. Il le dit donc,
           * en une ligne, avant le texte général.
           *
           * Le nom du pays est placé EN TÊTE, sans préposition : « Mexique — pays tiers listé »
           * et non « depuis le Mexique ». Les prépositions devant les noms de pays sont un nid
           * à fautes dans quatre langues — « à aéroport de Manchester » l'a rappelé — et elles
           * n'apportent rien ici, le drapeau et le titre d'étape ayant déjà posé le décor. */
          tete = ob.body ? `<p>${emE(nommerOrigine(ob.body, fromIso, guide.regime === "eu"))}</p>` : "";
        } else {
          /* Le cas général passe en dernier : une condition précise doit toujours l'emporter
           * sur lui, quel que soit l'ordre des cases dans la fiche. */
          const qualifiees = cases.filter((c) => c.from || c.not)
            .sort((a, b) => (a.from === "any" ? 1 : 0) - (b.from === "any" ? 1 : 0));
          const juste = qualifiees.find(vaut);
          if (juste) tete = `<p>${emE(nommerOrigine(juste.body, fromIso, true))}</p>`;
          casReplies = cases.filter((c) => c !== juste);
          /* Sans aucune case qualifiée, les cas seuls ne valent pas un repli : ils répètent
           * les puces. On ne garde le repli des cas que si l'un d'eux a été retenu en tête. */
          if (!juste) casReplies = [];
        }

        /* LE DOCUMENT PRIME SUR L'ORIGINE, sur cette étape et sur elle seule.
         *
         * Les trois cases d'une fiche européenne classent le monde par ORIGINE : UE, pays tiers
         * listé, pays tiers non listé. Un chien qui rentre des États-Unis tombe donc dans « pays
         * tiers listé » et se voit servir le certificat sanitaire — ce qui est juste pour un chien
         * américain qui part pour la première fois, et faux pour un chien français qui rentre chez
         * lui avec son passeport. La donnée ne peut pas trancher : elle ne connaît que l'origine du
         * vol, jamais l'histoire de l'animal. Seule la réponse du voyageur le peut, et c'est
         * exactement pour cela qu'on la lui demande.
         *
         * Le paragraphe de la fiche n'est ni réécrit ni supprimé : il devient l'une des deux
         * branches, et garde ses mots — ceux qu'une relectrice a choisis pour ce pays. */
        let repliDoc = "";
        if (retourUE(guide.slug, fromIso)) {
          const certif = tete;
          const passe = `<p>${emE(T.passBody)}</p>`;
          if (montrePasseport && montreCertificat) {
            /* Le certificat d'abord, le passeport ensuite : c'est l'ordre du rapport du Finder,
             * où la criticité range la règle « certificat » devant la règle « retour ». Deux
             * surfaces, un seul ordre — sinon on recrée, en plus petit, la contradiction qu'on
             * vient de réparer. La phrase de tête empêche de lire le premier comme le défaut. */
            tete = `<p>${esc(T.passLead)}</p>`
              + (certif ? `<p class="bcase"><b>${esc(T.certLbl)}</b></p>${certif}` : "")
              + `<p class="bcase"><b>${esc(T.passLbl)}</b></p>${passe}`;
          } else if (montrePasseport) {
            tete = passe;
            if (certif) repliDoc = `<li><b>${esc(T.certLbl)}</b> — ${certif.replace(/^<p>/, "").replace(/<\/p>$/, "")}</li>`;
          }
          /* « non » : `tete` reste le paragraphe de la fiche. Rien à faire, et surtout rien à
           * défaire — c'est le comportement d'avant, et il est juste dans ce cas-là. */
        }
        /* Cinq puces en clair, et non quatre. Le tri libère précisément une place — sur 280
         * couples (pays × origine), 179 tiennent désormais entièrement en clair. Le reste passe
         * dans le repli au lieu d'être coupé sans recours comme il l'était : c'est ainsi que
         * « Les chiens de catégorie 1 sont refusés à l'entrée » a cessé de disparaître de la
         * fiche française. Au-delà de cinq, la chronologie cesse d'être une chronologie. */
        /* La condition écrite en tête de puce, une fois que le tri l'a rendue inutile.
         *
         * « Depuis tout autre pays : présente le Certificat de Bonne Santé » — le lecteur vient
         * de voir le moteur écarter le cas américain pour lui ; lui répéter la condition ne lui
         * apprend rien et l'oblige à vérifier une seconde fois qu'elle le concerne. Pire, « tout
         * autre pays » désigne ici la terre entière moins deux, ce qui donne à la puce un air de
         * cas particulier alors qu'elle est le cas général. On la coupe : « Présente le
         * Certificat de Bonne Santé… ».
         *
         * UNIQUEMENT SUR LES PUCES CONDITIONNÉES, et uniquement dans la liste en clair. Dans le
         * repli, la condition est au contraire l'information principale — c'est elle qui dit au
         * lecteur pourquoi cette puce ne le concerne pas — et la fiche pays, qui ignore d'où
         * vient son lecteur, garde évidemment le texte entier.
         *
         * Le découpage se fait au premier deux-points, avec deux garde-fous : le segment doit
         * être court et sans ponctuation de fin. 91 % des puces conditionnées ont cette forme ;
         * les autres tissent la condition dans la phrase — « Les chiens venant directement de
         * Suède avec des papiers en règle peuvent… » — et sont laissées intactes, parce qu'il n'y
         * a rien à y couper sans casser la syntaxe. */
        const sansCondition = (p) => {
          if (!p.from && !p.not) return p.t;
          const m = p.t.match(/^(.{3,60}?)\s?:\s+(\S)([\s\S]*)$/);
          if (!m || /[!?]/.test(m[1]) || m[1].split(/\s+/).length > 9) return p.t;
          return m[2].toLocaleUpperCase() + m[3];
        };
        /* LA PUCE QUI VISE CETTE ORIGINE PASSE DEVANT.
         *
         * Le plafond de cinq puces coupait sans distinction, dans l'ordre de la fiche. Sur la
         * Corée, la seule puce choisie POUR le voyageur — celle qui dit qu'un passeport européen
         * remplace le certificat officiel — arrivait en sixième position, derrière quatre règles
         * valables pour tout le monde, et se retrouvait donc repliée pour un départ de Paris.
         * L'inverse exact de ce que cette page doit faire.
         *
         * Une puce qui porte une condition a été retenue parce qu'elle correspond à CE départ :
         * c'est la part personnalisée de la réponse, et elle passe en tête. Les puces sans
         * condition suivent, dans l'ordre de la fiche. Le tri est stable — deux puces de même
         * nature gardent leur ordre d'origine, celui qu'une relectrice a choisi. */
        const applicables = pts.filter(vaut)
          .map((p, i) => [p, i])
          .sort(([a, i], [b, j]) => ((b.from || b.not) ? 1 : 0) - ((a.from || a.not) ? 1 : 0) || i - j)
          .map(([p]) => p);
        const clair = applicables.slice(0, 5).map(sansCondition);
        const replie = [...applicables.slice(5), ...pts.filter((p) => !vaut(p))].map((p) => p.t);
        /* UN SEUL repli par étape, jamais deux. Les cas d'origine écartés et les puces écartées
         * sont la même chose pour le lecteur — ce qui ne le concerne pas — et deux blocs repliés
         * l'un sous l'autre dans une même étape se lisent comme un formulaire. Les cas viennent
         * en tête du repli, avec leur titre en gras : ils cadrent, les puces détaillent. */
        const corpsReplie = repliDoc
          + casReplies.map((c) => `<li><b>${esc(c.title)}</b> — ${emE(c.body)}</li>`).join("")
          + list(replie, emE);
        return tete
          + (clair.length ? `<ul class="bl">${list(clair, emE)}</ul>` : "")
          + (corpsReplie ? `<details class="bmore"><summary>${esc(T.otherCases)}</summary><ul class="bl">${corpsReplie}</ul></details>` : "");
      };
      const step2 = entryBlock(D, from) + `<a class="blink" href="${esc(countryHref(D.slug))}">${esc(T.countrySheet)} : ${esc(D.name)}</a>`;
      /* Étape 3 : on quitte la destination pour rentrer chez soi. Le bloc « sortie » de la
       * destination ne vaut donc que si le pays d'origine est européen — c'est le voyage qu'il
       * décrit. Un Mexicain qui rentre du Japon n'a que faire du certificat sanitaire UE. */
      const step3 = destEU ? `<p>${esc(T.freeExit)}</p>` : sortie(D, originEU, O.name, retourUE(from, to));
      const step4 = entryBlock(O, to) + `<a class="blink" href="${esc(countryHref(O.slug))}">${esc(T.countrySheet)} : ${esc(O.name)}</a>`;

      const stepRow = (n, chip, chipKind, title, body) =>
        `<div class="bstep"><div class="bstep__n bstep__n--${chipKind}">${n}</div><div class="bstep__c">
          <div class="bstep__h"><span class="bstep__t">${esc(title)}</span><span class="bchip bchip--${chipKind}">${esc(chip)}</span></div>
          <div class="bstep__b">${body}</div></div></div>`;

      const sourcesAll = [...(O.sources || []), ...(D.sources || [])];
      /* Résidu Option B corrigé (contre-revue Codex, 10/08/2026) : ce lien "partager par email"
       * reprenait `location.href` tel quel — donc, pour un visiteur arrivé par une URL forgée ou
       * une ancienne URL déjà partagée (an/sc/cab/hold/direct/emb/fee/as/af), le repartageait avec
       * les mêmes champs non fiables, encore une fois. Le patch d'origine empêchait leur RENDU,
       * pas leur PROPAGATION vers un tiers via ce bouton précis. Reconstruit maintenant depuis une
       * liste blanche des seuls paramètres canoniques (mêmes que ceux encore écrits par le Finder
       * après sa propre correction du même jour) — jamais depuis l'URL brute de la page. */
      const shareParams = new URLSearchParams();
      if (from) shareParams.set("from", from);
      if (to) shareParams.set("to", to);
      if (airId) shareParams.set("air", airId);
      if (breed) shareParams.set("breed", breed);
      if (bid) shareParams.set("bid", bid);
      if (w) shareParams.set("w", w);
      if (rep) shareParams.set("eu_passport", rep);
      const shareUrl = location.origin + location.pathname + "#" + shareParams.toString();
      const emailBody = encodeURIComponent(shareUrl);

      el.innerHTML = `
        <div class="bhead">
          <div><div class="beyebrow">${esc(T.eyebrow)}</div>
            <div class="broute">
              <span class="bleg"><span class="bflag">${flag(from)}</span> ${esc(O.name)}</span>
              <span class="bplane" aria-hidden="true">✈</span>
              <span class="bleg"><span class="bflag">${flag(to)}</span> ${esc(D.name)}</span>
              <span class="bplane" aria-hidden="true">✈</span>
              <span class="bleg"><span class="bflag">${flag(from)}</span> ${esc(O.name)}</span>
            </div>
            <div class="bsub">${esc(T.dog)} ${w ? esc(w) + " kg" : ""}${breed ? " · " + esc(breed) : ""}</div></div>
        </div>

        <div class="bdisclaimer"><span class="bdisclaimer__ic" aria-hidden="true">⚠️</span> <span>${esc(T.disclaimer)}</span></div>

        <div class="blegend"><span>${esc(T.legend)} :</span> ${pill("req")} ${pill("cond")} ${pill("adv")} ${pill("chk")}</div>

        ${from === to ? "" : `<div class="bcard"><div class="bcard__h">${esc(T.socleH)}</div><ul class="bl">${list(T.socle, emE)}</ul></div>`}

        ${from === to ? (() => {
          // Domestic: no border, so the four-step entry/exit chronology is meaningless. Show what applies instead.
          const dm = O.domestic;
          const body = dm
            ? `<p>${emE(dm.intro)}</p><ul class="bl">${list(dm.points, emE)}</ul>`
              + (dm.territories && dm.territories.length
                ? `<div class="bnote"><b>${esc(T.domTerr)}</b><ul class="bl">${dm.territories.map((t) => `<li><b>${esc(t.name)}</b> — ${emE(t.note)}${t.url ? ` <a class="blink" href="${esc(t.url)}" target="_blank" rel="nofollow noopener">↗</a>` : ""}</li>`).join("")}</ul></div>`
                : "")
            : `<p>${esc(T.domFallback)}</p>`;
          return `<div class="bcard"><div class="bcard__h">${esc(T.domH)}</div>${body}</div>`;
        })() : `<div class="bcard bchrono"><div class="bcard__h bchrono__h">${esc(T.chronoH)}</div>
          ${stepRow(1, T.out, "out", flag(from) + "  " + T.s1 + " " + O.name, step1)}
          ${stepRow(2, T.out, "out", flag(to) + "  " + T.s2 + " " + D.name, step2)}
          ${stepRow(3, T.ret, "ret", flag(to) + "  " + T.s3 + " " + D.name, step3)}
          ${stepRow(4, T.ret, "ret", flag(from) + "  " + T.s4 + " " + O.name, step4)}
        </div>`}

        <div class="bcard bcard--warn"><div class="bcard__h">${esc(T.casH)}</div>
          <ul class="bl">${list(T.cas, emC)}${(departUE(from) || departUE(to)) ? list(T.casUE, emC) : ""}${D.restricted ? `<li>${emC(D.restricted.intro)} ${emC(D.restricted.note)}</li>` : ""}</ul></div>

        <div class="bgrid">
          <div class="bcard"><div class="bcard__h">${esc(T.crateH)}</div><ul class="bl">${list(T.crate)}</ul><a class="bcrate-cta" href="${esc(crateHref)}">📦 ${esc(T.actCrate)} ↗</a></div>
          <div class="bcard"><div class="bcard__h">${esc(T.heatH)}</div><ul class="bl">${list(T.heat)}</ul><a class="bcrate-cta" href="${esc(heatHref)}">🌡 ${esc(T.actHeat)} ↗</a></div>
        </div>
        <div class="bcard"><div class="bcard__h">${esc(T.careH)}</div><ul class="bl">${list(T.care)}</ul></div>

        <div class="bactions">
          <button class="bbtn" type="button" id="b-print">🖨 ${esc(T.actPrint)}</button>
          <a class="bbtn" href="mailto:?subject=${encodeURIComponent(T.emailSubject)}&body=${emailBody}">✉ ${esc(T.actEmail)}</a>
        </div>

        <div class="bfurther">${esc(T.further)}
          <a href="${esc(countryHref(D.slug))}">${esc(T.countrySheet)} ${esc(D.name)}</a>
        </div>

        ${sourcesAll.length ? `<div class="bsources"><b>${esc(T.sourcesH)} :</b> ${sourcesAll.map((s) => `<a href="${esc(s.url)}" target="_blank" rel="nofollow noopener">${esc(s.label)}</a>`).join(" · ")}</div>` : ""}
        <div class="bfoot">${esc(T.foot)}</div>`;

      document.getElementById("b-print")?.addEventListener("click", () => window.print());

      // Le pied de page commun est rendu par Astro, hors du conteneur reconstruit en JS.
      // Ses liens sont statiques : on y injecte ici le contexte que seule la fiche connaît.
      const tools = document.getElementById("bible-tools");
      if (tools) {
        const ctx = { finder: [["to", to], ["breed", bid], ["air", airId]],
          destinations: [["breed", bid]], heat: [["breed", bid]],
          crate: [["breed", bid], ["air", airId]], "pet-relief": [] };
        tools.querySelectorAll("[data-tool]").forEach((a) => {
          const q = qs(ctx[a.getAttribute("data-tool")] || []);
          if (!q) return;
          const h = a.getAttribute("href") || "", i = h.indexOf("#");
          // La query doit rester devant l'ancre, sinon elle n'atteint pas location.search.
          a.setAttribute("href", i >= 0 ? addQ(h.slice(0, i), q) + h.slice(i) : addQ(h, q));
        });
        tools.hidden = false;
      }
    }
  </script>

  <style is:global>
