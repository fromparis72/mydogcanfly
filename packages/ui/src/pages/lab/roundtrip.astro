---
/* HIDDEN PROTOTYPE — round-trip (aller-retour) awareness test.
   Not linked in nav, excluded from sitemap, robots Disallow /lab/, forced noindex.
   Goal: judge legibility of the full round-trip before rolling out to 140 countries.
   Self-contained: a small pilot dataset + model, all client-side — never touches the engine.
   FR only (internal test).

   Legibility model (v3, after user feedback + official-source research):
   - 4-step chronology: ① exit origin · ② enter destination · ③ exit destination (return) ·
     ④ re-enter origin. Step ③ (leaving the visited country) is the one the tool used to ignore.
   - Timing is the star: a return requirement with a long lead time = must be started BEFORE
     leaving home → rare bold red tag. And the "trap" of ③: arranged abroad, in a foreign
     language, during a holiday, with real airport time on departure day.
   - One takeaway box at the END. Each step cites the governing authority (SENASICA, APHA…). */
import Base from "../../layouts/Base.astro";
import { countryData } from "../../data/countries";

// Wire the prototype to REAL country data: the `regime` + sourced `exit` blocks now come from the
// country files (steps ① and ③). The entry logic (② / ④) stays modelled per regime. FR-localised.
const PILOTS = ["country_fr", "country_es", "country_de", "country_gb", "country_us", "country_mx", "country_ma", "country_au", "country_nz", "country_jp"];
const F = (v) => (v && (v.fr ?? v.en)) || "";
const flagOf = (iso) => iso.toUpperCase().replace(/./g, (c) => String.fromCodePoint(127397 + c.charCodeAt(0)));
const ZONE = { eu: "Union européenne", listed: "Pays tiers listé", non_listed: "Pays non listé (risque rage)", island_controlled: "Île à régime contrôlé", island_strict: "Île à quarantaine stricte" };
// Map the real regime → the entry model the client already knows (keeps the entry logic unchanged).
const entryModel = (id, r) => id === "country_us" ? "us" : id === "country_mx" ? "mx" : r === "eu" ? "eu" : r === "island_controlled" ? "gb" : r === "island_strict" ? "strict" : r === "non_listed" ? "nonlisted" : "listed";
const RT = {};
for (const id of PILOTS) {
  const g = countryData[id];
  if (!g || !g.regime) continue;
  RT[g.iso2.toLowerCase()] = {
    name: F(g.name), flag: flagOf(g.iso2), zone: ZONE[g.regime] || "",
    regime: entryModel(id, g.regime), rabies: g.regime === "non_listed" ? "élevé" : "faible",
    exit: g.exit ? {
      authority: g.exit.authority, url: g.exit.authorityUrl,
      note: g.exit.onSiteNote ? F(g.exit.onSiteNote) : null,
      steps: g.exit.steps.map((s) => ({ t: F(s.text), w: s.timing })),
    } : null,
  };
}
---
<Base switcherPath="/" locale="fr" title="Prototype aller-retour — MyDogCanFly (interne)" description="Prototype interne" noindex={true}>
  <section class="mdcf-section">
    <div class="mdcf-container rt">
      <p class="rt-flag">🔬 Prototype interne — non public · <code>/lab/roundtrip</code></p>
      <h1 class="mdcf-h2">Le voyage de ton chien, du départ au retour</h1>
      <p class="rt-lead">Choisis le pays où réside ton chien et sa destination. On déroule les formalités <b>dans l'ordre chronologique</b>, dans les deux sens — et surtout, on te dit <b>quand</b> agir. La partie souvent oubliée : <b>sortir</b> du pays visité pour rentrer.</p>

      <div class="rt-alert">⚠️ <b>Attention !</b> Voyager à l'étranger avec ton chien, c'est <b>quatre étapes et non une</b> : sortir de ton pays, entrer à destination, en ressortir, puis rentrer chez toi — l'aller comme le retour ont leurs propres règles.</div>

      <div class="rt-presets">
        <span class="rt-presets__lbl">Exemples&nbsp;:</span>
        <button class="rt-chip" data-o="us" data-d="fr">🇺🇸 Chicago → Paris → Chicago (6 mois)</button>
        <button class="rt-chip" data-o="fr" data-d="mx">🇫🇷 Paris ⇄ Mexico (1 mois · Golden Retriever)</button>
        <button class="rt-chip" data-o="fr" data-d="ma">🇫🇷 Paris ⇄ Maroc</button>
        <button class="rt-chip" data-o="fr" data-d="gb">🇫🇷 Paris ⇄ Londres</button>
        <button class="rt-chip" data-o="fr" data-d="au">🇫🇷 Paris ⇄ Sydney</button>
        <button class="rt-chip" data-o="fr" data-d="es">🇫🇷 Paris ⇄ Madrid</button>
      </div>

      <div class="rt-form">
        <label class="rt-field"><span>Origine (résidence du chien)</span>
          <select id="rt-origin"></select>
        </label>
        <span class="rt-swap" id="rt-swap" title="Inverser" aria-hidden="true">⇄</span>
        <label class="rt-field"><span>Destination</span>
          <select id="rt-dest"></select>
        </label>
      </div>

      <div id="rt-out" class="rt-out"></div>

      <p class="rt-caveat">On suppose que ton chien <b>réside dans le pays d'origine</b> et fait un aller-retour. S'il a séjourné récemment ailleurs (rage), les règles peuvent changer — vérifie avec ton vétérinaire. Prototype à visée d'évaluation : contenu indicatif et sourcé, non contractuel.</p>
    </div>
  </section>

  <script type="application/json" id="rt-data" set:html={JSON.stringify(RT)} is:inline />
  <script is:inline>
    // ---- Pilot dataset — now fed by the REAL country files (regime + sourced exit blocks). ----
    const C = JSON.parse(document.getElementById("rt-data").textContent);
    const ORDER = ["fr", "es", "de", "gb", "us", "mx", "ma", "au", "nz", "jp"].filter((k) => C[k]);
    const RANK = { ok: 0, info: 1, warn: 2, crit: 3 };

    // ENTRY requirements to admit the dog into `into`, coming from `from`.
    // w: 'before' (ready before that flight) · 'window' (tight window before that flight)
    //    · 'longlead' (long lead time — as a RETURN item, must be started before leaving home).
    function entryItems(into, from) {
      const t = C[into], s = C[from];
      if (t.regime === "eu") {
        if (from === into || s.regime === "eu")
          return [{ t: "Passeport européen à jour — puce + vaccin antirabique valide.", w: "before", sev: "ok" }];
        if (s.rabies === "élevé")
          return [
            { t: "Titrage antirabique (≥ 0,5 UI/ml, labo agréé), 30 j après le vaccin. Fait AVANT de quitter l'UE et inscrit au passeport, il évite les 3 mois d'attente au retour.", w: "longlead", sev: "crit" },
            { t: "Certificat sanitaire UE établi sur place avant le vol retour.", w: "window", sev: "warn" },
          ];
        return [{ t: "Certificat sanitaire UE — puce + vaccin antirabique à jour.", w: "window", sev: "info" }];
      }
      if (t.regime === "us") { // CDC dog import rules (depuis août 2024)
        if (s.rabies === "élevé")
          return [
            { t: "Preuve de vaccination antirabique + entrée par un point désigné.", w: "longlead", sev: "crit" },
            { t: "Formulaire CDC Dog Import Form (en ligne).", w: "before", sev: "warn" },
          ];
        return [
          { t: "Formulaire CDC Dog Import Form à remplir en ligne (reçu valable 6 mois).", w: "before", sev: "warn" },
          { t: "Puce + chien âgé d'au moins 6 mois, d'apparence saine.", w: "before", sev: "info" },
        ];
      }
      if (t.regime === "mx")
        return [
          { t: "Certificat vétérinaire de bonne santé + vaccin antirabique en cours de validité.", w: "window", sev: "info" },
          { t: "Inspection sanitaire à l'arrivée (SENASICA) — ni quarantaine ni frais si tout est conforme.", w: "before", sev: "ok" },
        ];
      if (t.regime === "gb")
        return [
          { t: "Vermifuge échinococcose 24–120 h avant l'arrivée, chez un vétérinaire.", w: "window", sev: "warn" },
          { t: "Puce + vaccin antirabique à jour, entrée par une voie agréée.", w: "before", sev: "info" },
        ];
      if (t.regime === "strict")
        return [
          { t: "Permis d'importation + réservation de quarantaine.", w: "longlead", sev: "crit" },
          { t: "Titrage antirabique et tests sanguins imposés.", w: "longlead", sev: "crit" },
        ];
      if (t.regime === "nonlisted")
        return [
          { t: "Certificat sanitaire d'importation (modèle ONSSA) par un vétérinaire officiel.", w: "window", sev: "info" },
          { t: "Puce + vaccin antirabique à jour.", w: "before", sev: "info" },
        ];
      return [{ t: "Formalités à vérifier auprès de l'autorité vétérinaire.", w: "before", sev: "info" }];
    }

    // EXIT / export formalities to LEAVE `leaving` — from the REAL country data (`exit` block).
    // Absent exit block (EU / US) → no export procedure.
    const SEV_OF = { longlead: "crit", window: "warn", before: "info" };
    function exitItems(leaving) {
      const c = C[leaving];
      if (c.exit && c.exit.steps.length)
        return c.exit.steps.map((s) => ({ t: s.t, w: s.w, sev: SEV_OF[s.w] || "info" }));
      return [{ t: `Aucune démarche de sortie côté ${c.name} — pas de procédure d'export pour ton chien.`, w: "before", sev: "ok" }];
    }
    function heavyExit(id) { return !!(C[id].exit && C[id].exit.steps.length); }
    function maxSev(items) { return items.reduce((m, i) => (RANK[i.sev] > RANK[m] ? i.sev : m), "ok"); }

    // Timing chip — shown only where timing is surprising/critical, so it pops.
    function chip(w, dir) {
      if (w === "longlead")
        return dir === "back"
          ? `<span class="rt-when crit">⚠️ À LANCER AVANT DE PARTIR</span>`
          : `<span class="rt-when crit">⚠️ DÈS MAINTENANT · long délai</span>`;
      if (w === "window" && dir === "back")
        return `<span class="rt-when window">sur place, avant le vol retour</span>`;
      return "";
    }
    function itemsHtml(items, dir) {
      return `<ul class="rt-items">${items.map((i) =>
        `<li class="sev-dot-${i.sev}">${chip(i.w, dir)}<span>${i.t}</span></li>`).join("")}</ul>`;
    }
    function authHtml(id) {
      const e = C[id].exit;
      if (!e) return "";
      return `<a class="rt-auth" href="${e.url}" target="_blank" rel="noopener">🔗 Autorité : ${e.authority}</a>`;
    }

    function step(no, title, sub, items, dir, opts) {
      const o = opts || {};
      const sev = maxSev(items);
      return `<li class="rt-step">
        <div class="rt-step__rail"><span class="rt-step__no sev-b-${sev}">${no}</span>${o.last ? "" : `<span class="rt-step__line"></span>`}</div>
        <div class="rt-step__body">
          <div class="rt-step__title">${title}</div>
          ${sub ? `<div class="rt-step__sub">${sub}</div>` : ""}
          ${itemsHtml(items, dir)}
          ${o.trapText ? `<div class="rt-trap">⚠️ ${o.trapText}</div>` : ""}
          ${o.authId ? authHtml(o.authId) : ""}
        </div>
      </li>`;
    }

    function keyBox(entry2, exit3, ret4, O, D, heavy3) {
      const rl = ret4.find((i) => i.w === "longlead");
      const el = entry2.find((i) => i.w === "longlead");
      // The final takeaway box is reserved for the genuinely critical case: a long-lead démarche that
      // must be launched BEFORE departure (return titer, import permit). For everything else the steps
      // already carry the message — no redundant box.
      if (rl) return box("crit", "⚠️ À ne pas rater", `Pour <b>rentrer en ${O.name}</b>, ${lower(rl.t.split(".")[0])}. <b>Cette démarche est longue : lance-la AVANT ton départ</b>, pas au moment de rentrer.`);
      if (el) return box("crit", "⚠️ À ne pas rater", `Pour <b>entrer en ${D.name}</b>, ${lower(el.t)} <b>Compte plusieurs mois de démarches</b> — à anticiper très en amont.`);
      return "";
    }
    function box(sev, lbl, html) { return `<div class="rt-key sev-${sev}"><span class="rt-key__lbl">${lbl}</span><p>${html}</p></div>`; }
    function lower(s) { return s.charAt(0).toLowerCase() + s.slice(1); }

    function render() {
      const o = document.getElementById("rt-origin").value;
      const d = document.getElementById("rt-dest").value;
      const O = C[o], D = C[d];
      const exit1 = exitItems(o);        // ① sortie origine (aller)
      const entry2 = entryItems(d, o);   // ② entrée destination (aller)
      const exit3 = exitItems(d);        // ③ sortie destination (retour)
      const ret4 = entryItems(o, d);     // ④ retour / entrée origine
      const worst = maxSev([...exit1, ...entry2, ...exit3, ...ret4]);
      const heavy3 = heavyExit(d);

      document.getElementById("rt-out").innerHTML = `
        <div class="rt-route">
          <span class="rt-route__tag">✈ Aller-retour</span>
          <div class="rt-route__seq">
            <span class="rt-route__pt">${O.flag} ${O.name}</span>
            <span class="rt-route__ar">→</span>
            <span class="rt-route__pt rt-route__pt--dest">${D.flag} ${D.name}</span>
            <span class="rt-route__ar">→</span>
            <span class="rt-route__pt rt-route__pt--home">${O.flag} ${O.name}</span>
          </div>
        </div>
        <div class="rt-phase rt-phase--out">ALLER</div>
        <ol class="rt-timeline">
          ${step("1", `Sortie de ${O.name}`, "", exit1, "out", { authId: o })}
          ${step("2", `Entrée en ${D.name} <span class="rt-step__zone">${D.zone}</span>`, "À préparer avant le départ.", entry2, "out", { last: true })}
        </ol>
        <div class="rt-phase rt-phase--back">RETOUR</div>
        <ol class="rt-timeline">
          ${step("3", `Sortie de ${D.name}`, heavy3 ? "" : "Formalités de départ.", exit3, "back", { trapText: heavy3 ? (C[d].exit.note || "") : null, authId: d })}
          ${step("4", `Retour en ${O.name} <span class="rt-step__zone">${O.zone}</span>`, "", ret4, "back", { last: true })}
        </ol>
        ${keyBox(entry2, exit3, ret4, O, D, heavy3)}
        <div class="rt-hub">
          <div class="rt-hub__grid">
            <div class="rt-hub__card">
              <div class="rt-hub__hd">Vol sélectionné</div>
              <div class="rt-hub__row"><span class="rt-hub__logo">AF</span><div class="rt-hub__meta"><b>Air France</b><span>Direct · cabine si &lt; 8 kg, sinon soute</span></div></div>
              <a class="rt-hub__link" href="/fr/airlines/air-france/">🐾 Voir la fiche Air France →</a>
              <a class="rt-hub__buy" href="https://www.airfrance.fr/" target="_blank" rel="noopener">Réserver sur Air France ↗</a>
            </div>
            <div class="rt-hub__card">
              <div class="rt-hub__hd">Destination</div>
              <div class="rt-hub__row"><span class="rt-hub__logo rt-hub__logo--flag">${D.flag}</span><div class="rt-hub__meta"><b>${D.name}</b><span>Modalités d'entrée et de retour — tout le détail sourcé</span></div></div>
              <a class="rt-hub__link" href="/fr/countries/${d}/">📄 Voir la page ${D.name} →</a>
            </div>
          </div>
          <p class="rt-hub__note">Maquette du hub : la page de résultats comparera les compagnies (cabine/soute, direct, prix) avec un simple drapeau « formalités pays » ; ce hub — atteint en cliquant un vol — rassemble les 4 étapes, la fiche compagnie et la page pays.</p>
        </div>`;
    }

    (function () {
      const os = document.getElementById("rt-origin"), ds = document.getElementById("rt-dest");
      for (const k of ORDER) {
        os.insertAdjacentHTML("beforeend", `<option value="${k}">${C[k].flag} ${C[k].name}</option>`);
        ds.insertAdjacentHTML("beforeend", `<option value="${k}">${C[k].flag} ${C[k].name}</option>`);
      }
      os.value = "fr"; ds.value = "mx"; // default = Paris ⇄ Mexico (the case that exposed step ③)
      os.addEventListener("change", render); ds.addEventListener("change", render);
      document.getElementById("rt-swap").addEventListener("click", () => { const a = os.value; os.value = ds.value; ds.value = a; render(); });
      document.querySelectorAll(".rt-chip").forEach((b) => b.addEventListener("click", () => { os.value = b.dataset.o; ds.value = b.dataset.d; render(); }));
      render();
    })();
  </script>

  <style>
    .rt { max-width: 780px; padding-bottom: 60px; }
    .rt-flag { font-size: 12.5px; color: var(--mdcf-muted); background: var(--mdcf-subtle); display: inline-block; padding: 4px 10px; border-radius: 999px; }
    .rt-flag code { font-size: 12px; }
    .rt-lead { color: var(--mdcf-muted); max-width: 660px; margin: 6px 0 14px; line-height: 1.6; }
    .rt-alert { background: #fff7ed; border: 1px solid #fed7aa; border-left: 4px solid #ea580c; border-radius: 0 12px 12px 0; padding: 13px 16px; margin: 0 0 18px; font-size: 14.5px; line-height: 1.55; color: #7c2d12; }
    .rt-alert b { color: #7c2d12; }
    .rt-presets { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 16px; }
    .rt-presets__lbl { font-size: 13px; color: var(--mdcf-muted); font-weight: 700; }
    .rt-chip { font: inherit; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--mdcf-line); background: var(--mdcf-surface); color: var(--mdcf-ink); cursor: pointer; }
    .rt-chip:hover { border-color: var(--mdcf-navy); }
    .rt-form { display: flex; align-items: flex-end; gap: 12px; margin-bottom: 22px; }
    .rt-field { flex: 1; display: flex; flex-direction: column; gap: 5px; font-size: 13px; font-weight: 700; color: var(--mdcf-muted); }
    .rt-field select { font: inherit; font-size: 15px; font-weight: 600; color: var(--mdcf-ink); padding: 10px 12px; border: 1px solid var(--mdcf-line); border-radius: 10px; background: var(--mdcf-surface); }
    .rt-swap { font-size: 20px; color: var(--mdcf-muted); padding-bottom: 10px; cursor: pointer; user-select: none; }

    .rt-route { display: flex; flex-direction: column; align-items: center; gap: 8px; margin: 4px 0 20px; }
    .rt-route__tag { font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--mdcf-accent-ink); background: var(--mdcf-accent-soft); padding: 3px 12px; border-radius: 999px; }
    .rt-route__seq { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; font-size: 18px; font-weight: 800; color: var(--mdcf-ink); }
    .rt-route__ar { color: var(--mdcf-muted); font-size: 16px; font-weight: 600; }
    .rt-route__pt--dest { color: var(--mdcf-accent-ink); }
    .rt-route__pt--home { color: var(--mdcf-muted); font-weight: 700; }
    @media (max-width: 520px) { .rt-route__seq { font-size: 15px; gap: 7px; } }

    .rt-phase { font-size: 11.5px; font-weight: 800; letter-spacing: .08em; color: var(--mdcf-muted); margin: 4px 0 8px; padding-left: 2px; }
    .rt-phase--back { margin-top: 6px; }

    /* Timeline */
    .rt-timeline { list-style: none; margin: 0 0 4px; padding: 0; }
    .rt-step { display: grid; grid-template-columns: 34px 1fr; gap: 16px; }
    .rt-step__rail { display: flex; flex-direction: column; align-items: center; }
    .rt-step__no { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 14px; color: #fff; flex: none; }
    .rt-step__line { flex: 1; width: 2px; background: var(--mdcf-line); margin: 6px 0; }
    .rt-step__body { padding-bottom: 20px; min-width: 0; }
    .rt-step__title { font-weight: 800; font-size: 16px; color: var(--mdcf-ink); display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
    .rt-step__zone { font-weight: 600; font-size: 12px; color: var(--mdcf-muted); background: var(--mdcf-subtle); padding: 2px 8px; border-radius: 999px; }
    .rt-step__sub { font-size: 13px; color: var(--mdcf-muted); margin-top: 2px; }
    .rt-items { list-style: none; margin: 10px 0 0; padding: 0; }
    .rt-items li { position: relative; padding: 6px 0 6px 16px; font-size: 14.5px; line-height: 1.5; color: var(--mdcf-ink); }
    .rt-items li::before { content: ""; position: absolute; left: 0; top: 13px; width: 6px; height: 6px; border-radius: 50%; background: var(--mdcf-muted); }
    .rt-items li.sev-dot-crit::before { background: #dc2626; } .rt-items li.sev-dot-warn::before { background: #d97706; }
    .rt-items li.sev-dot-info::before { background: #2563eb; } .rt-items li.sev-dot-ok::before { background: #16a34a; }

    .rt-when { display: inline-block; font-size: 11.5px; font-weight: 800; letter-spacing: .02em; padding: 2px 8px; border-radius: 6px; margin-right: 8px; vertical-align: 1px; }
    .rt-when.crit { background: #dc2626; color: #fff; }
    .rt-when.window { background: #fef3c7; color: #92400e; }

    .rt-trap { margin-top: 10px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 9px 12px; font-size: 13px; line-height: 1.5; color: #78350f; }
    .rt-auth { display: inline-block; margin-top: 9px; font-size: 12.5px; font-weight: 600; color: var(--mdcf-navy); text-decoration: none; }
    .rt-auth:hover { text-decoration: underline; }

    .sev-b-ok { background: #16a34a; } .sev-b-info { background: #2563eb; } .sev-b-warn { background: #d97706; } .sev-b-crit { background: #dc2626; }

    .rt-key { border-radius: 14px; padding: 16px 18px; margin: 8px 0 22px; border: 1px solid; border-left-width: 5px; }
    .rt-key__lbl { display: block; font-weight: 800; font-size: 14px; margin-bottom: 4px; }
    .rt-key p { margin: 0; line-height: 1.55; font-size: 14.5px; }
    .rt-key.sev-crit { background: #fef2f2; border-color: #fecaca; border-left-color: #dc2626; color: #7f1d1d; }
    .rt-key.sev-warn { background: #fffbeb; border-color: #fde68a; border-left-color: #d97706; color: #78350f; }
    .rt-key.sev-info { background: #eff6ff; border-color: #bfdbfe; border-left-color: #2563eb; color: #1e3a8a; }
    .rt-key.sev-ok   { background: #f0fdf4; border-color: #bbf7d0; border-left-color: #16a34a; color: #14532d; }

    .rt-hub { border-top: 1px dashed var(--mdcf-line); padding-top: 16px; margin-top: 6px; }
    .rt-hub__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
