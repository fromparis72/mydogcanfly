# Hugo
/public/
/resources/_gen/
.hugo_build.lock

# OS
.DS_Store

# Source assets (originals, not published)
/MyDogCanFly_logo.png
/bandeaulogoMyDog.png

node_modules/
packages/**/dist/
.venv-pdf/

# Cache de compilation d'Astro : régénéré à chaque build, propre à la machine.
packages/**/.astro/

# Manifestes de déploiement produits par `npm run deploy:preview`. Délibérément NON versionnés :
# ils attestent d'un déploiement du commit courant, donc les commiter ajouterait un commit
# au-dessus de celui dont ils parlent — l'attestation ne pourrait jamais désigner l'état final
# du dépôt. Ce sont des artefacts, à archiver côté CI ou stockage d'audit si besoin.
.artifacts/
.sauvegarde-8aout/objects.json

# Bac à sable du harnais test-ingest-check.mjs (créé et supprimé à chaque exécution)
/.ingest-sandbox/
fraicheur-sortie/

# Captures de la vérification navigateur (journée 5) : des preuves à REGARDER, pas à versionner —
# elles sont régénérées par `npm run test:apercu` et pèseraient 1,5 Mo de binaire par passage.
mesures/apercu-jour5/
