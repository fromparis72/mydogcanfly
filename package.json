{
  "name": "mydogcanfly",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm -w @mydogcanfly/knowledge run check",
    "demo": "npm -w @mydogcanfly/engine run demo",
    "smoke": "npm -w @mydogcanfly/workers run smoke",
    "build": "npm -w @mydogcanfly/ui run build",
    "typecheck": "npm -w @mydogcanfly/knowledge run typecheck && npm -w @mydogcanfly/engine run typecheck && npm -w @mydogcanfly/workers run typecheck",
    "audit": "node packages/knowledge/scripts/audit-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
