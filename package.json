{
  "name": "mydogcanfly",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm -w @mydogcanfly/knowledge run check",
    "demo": "npm -w @mydogcanfly/engine run demo",
    "smoke": "npm -w @mydogcanfly/workers run smoke",
    "build": "npm -w @mydogcanfly/ui run build",
    "build:preview": "node packages/knowledge/scripts/build-preview.mjs",
    "deploy:preview": "node packages/knowledge/scripts/deploy-preview.mjs",
    "promote:preview-alias": "node packages/knowledge/scripts/promote-preview-alias.mjs",
    "build:prod": "npm -w @mydogcanfly/ui run build:prod",
    "verify:index": "node packages/knowledge/scripts/verifier-indexation.mjs",
    "release": "npm run build:prod && npm run verify:index && npx wrangler pages deploy packages/ui/dist --project-name=mydogcanfly-v2-preview --branch=main --commit-dirty=true",
    "typecheck": "npm -w @mydogcanfly/knowledge run typecheck && npm -w @mydogcanfly/engine run typecheck && npm -w @mydogcanfly/workers run typecheck",
    "audit": "node packages/knowledge/scripts/audit-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
